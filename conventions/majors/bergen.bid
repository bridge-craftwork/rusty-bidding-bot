# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Bergen raises: over partner's 1♥/1♠ (RHO passing), responder's jumps
# show four-card raises by strength, so opener knows the fit and the
# values at once:
#
#   Bergen         (`major_openings.bergen_raises.play`)     3♣ constructive 7-10, 3♦ limit 11-12
#   Reverse Bergen (`major_openings.bergen_raises.reverse`)  3♣ limit 11-12, 3♦ constructive 7-10
#   either                                                    3M preemptive, about 3-6
#
# Support points (shortness counted). Game-forcing raises stay with Jacoby
# 2NT and splinters. (Bridge Bum, "Bergen Raises"; Bergen & Cohen; the
# PBS scenario Bergen_Raises.) With both switches, Reverse. See
# bergen.notes.md.

module bergen "Bergen raises: four-card raises at the three level"
  needs  responses
  skill  bidding_conventions/bergen_raises
  skill  bidding_conventions/reverse_bergen_raises
  param  bergen  = major_openings.bergen_raises.play default false
  param  reverse = major_openings.bergen_raises.reverse default false
  param  drury   = major_openings.drury.play default false
  param  drury_r = major_openings.drury.reverse default false

# ── Responder ────────────────────────────────────────────────────────
after 1M (P) when bergen | reverse
  3C  "Bergen: constructive raise, four {M}, 7-10 support points"  alert
      shows M>=4, tp(M)=7..10, hcp>=5
      when  !reverse
      when  M=4 | hcp>=8               # five trumps and 5-7 HCP: the jump to game
      sets  trump=M, ask=bergen_constructive(M)
      artificial
      priority 1                       # the four-card raise, ahead of 2M or a new suit
  3D  "Bergen: limit raise, four {M}, 11-12 support points"  alert
      shows M>=4, tp(M)=11..12, hcp<=12
      when  !reverse
      when  !passed_hand | (!drury, !drury_r)   # a passed hand's limit raise is Drury's 2♣
      sets  trump=M, ask=bergen_limit(M)
      artificial
      priority 1
  3D  "Reverse Bergen: constructive raise, four {M}, 7-10 support points"  alert
      shows M>=4, tp(M)=7..10, hcp>=5
      when  reverse
      when  M=4 | hcp>=8
      sets  trump=M, ask=bergen_constructive(M)
      artificial
      priority 1
  3C  "Reverse Bergen: limit raise, four {M}, 11-12 support points"  alert
      shows M>=4, tp(M)=11..12, hcp<=12
      when  reverse
      when  !passed_hand | (!drury, !drury_r)
      sets  trump=M, ask=bergen_limit(M)
      artificial
      priority 1
  # Five trumps and a weak hand keep the jump to game (responses.bid).
  3M  "Bergen: preemptive raise, four {M}, about 3-6"
      shows M>=4, tp(M)<=7, hcp<=6, hcp>=2
      when  M=4 | hcp<=3
      sets  trump=M, ask=preemptive_raise(M)
      priority 1

# ── Opener ───────────────────────────────────────────────────────────
# Opposite 7-10 with a nine-card fit: game from 17, invite with 15-16
# (the cheapest step is a game try in Bergen; with Reverse Bergen and
# hearts there is no step below 3♥, so opener decides).
when asked bergen_constructive(M), rho.last=P
  4M  "Game opposite a constructive raise: 17+"
      shows tp(M)>=17
      priority 3                       # ahead of opener's natural rebids
  3D  "Game try opposite a constructive raise: 15-16"  alert
      shows tp(M)=15..16
      when  partner.last=3C
      sets  ask=bergen_try(M)
      artificial
      priority 3
  3H  "Game try opposite a constructive raise: 15-16"  alert
      shows tp(M)=15..16
      when  partner.last=3D, M is S
      sets  ask=bergen_try(M)
      artificial
      priority 3
  4M  "Game opposite a constructive raise: 16+"
      shows tp(M)>=16
      when  partner.last=3D, M is H
      priority 3
  3M  "Sign off opposite a constructive raise"
      priority 2

# Opposite 11-12: game from 14.
when asked bergen_limit(M), rho.last=P
  4M  "Game opposite a limit raise: 14+"
      shows tp(M)>=14
      priority 3
  3M  "Sign off opposite a limit raise: a minimum"
      shows tp(M)<=13
      priority 3

when asked bergen_try(M), rho.last=P
  4M  "Accepts the game try: the top of the constructive raise"
      shows tp(M)>=9
      priority 3
  3M  "Declines the game try"
      priority 2

# Opener after the preemptive 3M: jump-raises.bid (`asked preemptive_raise`).

# Responder after opener's sign-off.
when answered bergen_constructive(M), rho.last=P, partner.last=3{M}
  P   "Opener signed off"
      priority 2
when answered bergen_limit(M), rho.last=P, partner.last=3{M}
  P   "Opener signed off"
      priority 2

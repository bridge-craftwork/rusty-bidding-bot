# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.

module jacoby-transfers "Jacoby Transfers"
  card   notrump.transfers.jacoby
  needs  notrump-base
  param  texas = notrump.transfers.texas default false
  param  systems_on = nt_overcalls.direct.systems_on default true

# The transfer is a question: "bid my suit". Opener's next call answers it,
# whether a plain completion or a super-accept.
after 1N (P) | (1x) 1N (P) | (1x) P (P) 1N (P) when !they.bid | systems_on
  2D  "Transfer to hearts"  announce "Transfer"  shows H>=5  sets forcing=round, ask=transfer(H)  artificial
  2H  "Transfer to spades"  announce "Transfer"  shows S>=5  sets forcing=round, ask=transfer(S)  artificial

# Opener completes the transfer. Super-accepts are separate modules
# (super-accept.bid, superaccept-doubleton.bid), switched on by the card.
after 1N (P) 2D (P) | (1x) 1N (P) 2D (P) | (1x) P (P) 1N (P) 2D (P)
  2H  "Completes transfer"

after 1N (P) 2H (P) | (1x) 1N (P) 2H (P) | (1x) P (P) 1N (P) 2H (P)
  2S  "Completes transfer"

# Responder's second call, once opener has answered. There is no auction
# pattern: `answered transfer(M)` holds after any auction where partner
# answered my transfer, and binds M to the major.
#
# `strength` bands are measured against what opener has shown: after a
# 15-17 1NT, invite is 8-9 and game 10-15; after a maximum super-accept the
# invitational band shrinks, so invitational hands bid game. Notrump
# decisions use `strength` (HCP + ½ per ten); playing in the major uses
# `suit_strength` (HCP + ½ per card beyond four).
when answered transfer(M)
  3M  "Sign off in the known fit"              shows suit_strength=signoff
      when partner.M>=4                        # after a 2S or 2NT super-accept
  4M  "Game in the known fit, opposite a maximum"  shows suit_strength=invite
      when partner.M>=4                        # the super-accept is for thin games
  P   "Weak: play here ({signoff} total points)"  shows strength=signoff
  2N  "Invitational: {invite} total points, exactly 5 {M}"  shows M=5, balanced, strength=invite
      sets ask=invite(M)
  3M  "Invitational: {invite} total points, 6+ {M}"  shows M>=6, suit_strength=invite
      sets ask=invite(M)
  3N  "Game: {game} total points, 5 {M}: choose the game"  shows M=5, balanced, strength=game
      when maybe partner.M<=2                  # only while the fit is unknown
      sets ask=choice                          # opener corrects with 3+ {M}
  4M  "Game: {game} total points, 6+ {M}"      shows M>=6, suit_strength=game
      when !texas                              # with Texas, game-only hands use it
  4M  "Mild slam interest, 6+ {M}"             shows M>=6, suit_points>=31-partner.points.max, suit_points<=32-partner.points.min
      when texas                               # 14-17 opposite 15-17: slam if opener has
                                               # the right hand; Texas is for 18+
      sets ask=slam_try(M)
  4M  "Game: {game} total points, 6+ {M}"      shows M>=6, suit_strength=game
      when texas                               # game-only hands normally use Texas
      priority -1                              # a fallback: 4M still reads as the slam try
  4M  "Game in the known fit"                  shows suit_strength=game
      when partner.M>=3                        # known, e.g. after a super-accept
  3m  "Second suit, game forcing"              shows m>=4, strength>=game
      sets forcing=game, ask=new_suit(M)
  4N  "Quantitative, 5 {M}"                    shows M=5, balanced, strength=slam_invite
  6N  "Slam: {slam} total points, 5 {M}"       shows M=5, balanced, strength=slam

# Opener answers the invitation (2NT with five, 3M with six). Accept only
# when game is certain; play in the major with an eight-card fit, which is
# 3+ cards opposite five and 2+ opposite six.
when asked invite(M)
  4M  "Accepts, in the fit"             shows M>=8-partner.M.min, strength>=game
  3N  "Accepts, no fit"                 shows M<8-partner.M.min, strength>=game
  3M  "Declines, in the fit"            shows M>=8-partner.M.min, strength<=invite
  P   "Declines"                        shows strength<=invite

# Opener after responder's second suit (game forcing): rebid the major with
# three-card support, which agrees it below game so that responder can look
# for slam; otherwise 3NT.
when asked new_suit(M)
  3M  "3+ {M}: support"             shows M>=3   sets trump=M
  3N  "No fit: 2 {M}"               shows M<=2

# Opener after the jump to game with mild slam interest: bid on with a good
# fit and a maximum, even without having super-accepted.
when asked slam_try(M)
  4N  "Keycard ask: good fit and a maximum"   shows M>=3, points>=31-partner.suit_points.min
      sets ask=keycards(M)
      artificial
  P   "No slam: plays game"

# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.

module jacoby-transfers "Jacoby Transfers"
  card   notrump.transfers.jacoby
  needs  notrump-base

after 1N (P)
  2D  "Transfer to hearts"  announce "Transfer"  shows H>=5  sets forcing=round
  2H  "Transfer to spades"  announce "Transfer"  shows S>=5  sets forcing=round

# Opener: super-accept with 4-card support and a maximum, else complete.
# `shown.hcp` is what I have already shown (here, the 1NT range).
after 1N (P) 2D (P)
  3H  "Super-accept"        shows H>=4, hcp>=shown.hcp.max
  2H  "Completes transfer"

after 1N (P) 2H (P)
  3S  "Super-accept"        shows S>=4, hcp>=shown.hcp.max
  2S  "Completes transfer"

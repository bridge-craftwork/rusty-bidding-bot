# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.

module jacoby-transfers "Jacoby Transfers"
  card   notrump.transfers.jacoby
  needs  notrump-base

# The transfer is a question: "bid my suit". Opener's next call answers it,
# whether a plain completion or a super-accept.
after 1N (P)
  2D  "Transfer to hearts"  announce "Transfer"  shows H>=5  sets forcing=round, ask=transfer(H)
  2H  "Transfer to spades"  announce "Transfer"  shows S>=5  sets forcing=round, ask=transfer(S)

# Opener completes the transfer. Super-accepts are separate modules
# (super-accept.bid, superaccept-doubleton.bid), switched on by the card.
after 1N (P) 2D (P)
  2H  "Completes transfer"

after 1N (P) 2H (P)
  2S  "Completes transfer"

# Responder's second call, once opener has answered. There is no auction
# pattern: `answered transfer(M)` holds after any auction where partner
# answered my transfer, and binds M to the major.
#
# `strength` bands are measured against what opener has shown: after a
# 15-17 1NT, invite is 8-9 and game 10-15; after a super-accept (a known
# maximum) there is no invitational band, so invitational hands bid game.
when answered transfer(M)
  3M  "Sign off in the known fit"              shows strength=signoff
      when partner.M>=4                        # after a 2S or 2NT super-accept
  P   "Weak: play here"                        shows strength=signoff
  2N  "Invitational, exactly 5 {M}"            shows M=5, balanced, strength=invite
  3M  "Invitational, 6+ {M}"                   shows M>=6, strength=invite
  3N  "Game values, 5 {M}: choose the game"    shows M=5, balanced, strength=game
      when maybe partner.M<=2                  # only while the fit is unknown
  4M  "Game values, 6+ {M}"                    shows M>=6, strength=game
  4M  "Game in the known fit"                  shows strength=game
      when partner.M>=3                        # known, e.g. after a super-accept
  3m  "Second suit, game forcing"              shows m>=4, strength>=game
      sets forcing=game
  4N  "Quantitative, 5 {M}"                    shows M=5, balanced, strength=slam_invite

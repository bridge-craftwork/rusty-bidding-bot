# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.

module notrump-base "1NT opening and natural responses"
  needs  base
  skill  basic_bidding/notrump_openings
  skill  partnership_bidding/basic_notrump
  param  nt_min   = notrump.one_nt.range_min default 15
  param  nt_max   = notrump.one_nt.range_max default 17
  param  one_less = notrump.one_nt.allow_one_less default false
  param  minors   = notrump.minor_transfers default relay
  param  three_c_transfer = notrump.transfers.three_c_diamonds default false
  param  three_d  = notrump.three_d_response default natural
  param  systems_on = nt_overcalls.direct.systems_on default true
  param  vs_2c   = notrump.transfers.vs_2c default false
  param  style   = general.style
  param  five_major = notrump.one_nt.five_card_major default sometimes
  param  jacoby  = notrump.transfers.jacoby default true
  param  nt_2n_clubs = notrump.transfers.two_nt_clubs default false
  param  puppet_1nt = notrump.stayman.puppet_1nt default false
  param  allow_5422 = notrump.one_nt.allow_5422 default false
  param  allow_4441 = notrump.one_nt.allow_4441 default false

# The range is in HCP, as BBA plays it (15-17 HCP exactly, whatever the
# tens or length). With the card option "1NT may be 1 HCP light", a hand one
# HCP short opens 1NT when its extras bring it to the range in total points.
# A five-card major only as the card allows (`one_nt.five_card_major`):
# BBA opens 1NT with one only with "1NT opening shape 5 major"; its bare
# SAYC card (probe 2026-09-30) opens the major.
when opening
  1N  "{nt_min}-{nt_max} HCP, balanced"  announce "{nt_min} to {nt_max}"
      shows hcp=nt_min..nt_max, balanced, five_major is not never | (H<=4, S<=4)
  1N  "{nt_min}-{nt_max} HCP, balanced (1 HCP light with extras)"  announce "{nt_min} to {nt_max}"
      shows hcp=nt_min-1, points>=nt_min, balanced, five_major is not never | (H<=4, S<=4)
      when one_less
  # The card's shape options (one-nt.notes.md, "5-4-2-2 and 4-4-4-1").
  # 5-4-2-2 with a five-card minor and four hearts or four of the other
  # minor, both doubletons headed by the ace or king (BBA: never with
  # four spades, always with both doubletons stopped). 4-4-4-1 only with
  # a singleton ace or king.
  1N  "{nt_min}-{nt_max} HCP, 5-4-2-2 with a five-card minor"  announce "{nt_min} to {nt_max}"
      shows hcp=nt_min..nt_max, shape 5-4-2-2, C=5 | D=5, S=2, H>=2, D>=2, C>=2, has(A,S) | has(K,S), H>=3 | has(A,H) | has(K,H), D>=3 | has(A,D) | has(K,D), C>=3 | has(A,C) | has(K,C)
      when allow_5422
  1N  "{nt_min}-{nt_max} HCP, 4-4-4-1 with a singleton honour"  announce "{nt_min} to {nt_max}"
      shows hcp=nt_min..nt_max, shape 4-4-4-1, S>=2 | has(A,S) | has(K,S), H>=2 | has(A,H) | has(K,H), D>=2 | has(A,D) | has(K,D), C>=2 | has(A,C) | has(K,C)
      when allow_4441

# Responder. Strength bands are total points measured against opener's
# range, so they follow the card: with 15-17, invite is 8-9 and game 10-15.
after 1N (P) | (1x) 1N (P) | (1x) P (P) 1N (P) | (1x) 1N (X) | (1x) P (P) 1N (X) when !they.bid | systems_on
  6N  "To play: slam values"
      shows balanced, points>=32-partner.hcp.min, H<=4, S<=4   # with five, transfer first
  4N  "Quantitative: invites 6NT"
      when  quant_4nt   # slam.quantitative_4nt.play (slam-entry.bid)
      shows balanced, strength=slam_invite, points<=31-partner.hcp.min, H<=4, S<=4   # with five, transfer first
      when  style is not bba
      sets  ask=quant
      # Rick: 17 opposite 15-17 jumps to 6NT (BBA: 10 of 12 hands; 16
      # mostly invites). BBA's choices at 16-17 do not follow controls.
  3N  "To play: {game} total points"
      shows strength=game, H<=4, S<=4                   # with five, transfer first
      when  style is not bba
  2N  "Invitational: {invite} total points"
      shows strength=invite, H<=4, S<=4, C<=5, D<=5     # a long suit has its own route
      when  minors is not four_way, minors is not four_way_reversed, style is not bba   # 2NT is a transfer
      when  minors is not none | !nt_2n_clubs
      sets  ask=nt_invite
  2N  "Invitational: {invite} total points, a long minor"
      shows strength=invite, H<=4, S<=4, (C>=6 | D>=6)
      when  minors is relay | minors is none         # no minor route for invitations
      when  minors is not none | !nt_2n_clubs
      sets  ask=nt_invite
  # A slam try in the minor: six cards, or five in an unbalanced hand
  # (2026-09-27: 15-18 counts with a five-card minor bid 3NT opposite
  # 15-17; a nine-card fit makes slam double dummy 72% of the time at 29
  # HCP between the hands, an eight-card fit 71% at 30).
  3C  "Slam try: six or more clubs, or five and unbalanced"
      shows C>=6 | (C>=5, !balanced), strength>=slam_invite, H<=4, S<=4
      when  !three_c_transfer, minors is not bba, !puppet_1nt
  3D  "Slam try: six or more diamonds, or five and unbalanced"
      shows D>=6 | (D>=5, !balanced), strength>=slam_invite, H<=4, S<=4
      when  three_d is natural
  3N  "No better call: {game} total points or more"
      shows strength>=game
      priority -5                      # a strong hand never passes 1NT
  P   "No game interest: {signoff} total points"
      shows strength=signoff
      when  style is not bba
      priority -10                     # only if nothing else fits

  # The BBA treatment (probed 2026-09-24, one-nt.notes.md). Total points
  # are HCP + ½ per ten (the `bba` valuation), with two exceptions: with
  # 4-4 in the minors the tens do not count, and 8 HCP 4-3-3-3 without a
  # ten passes. At IMPs game comes a point earlier (9 opposite 15-17).
  # The slam invitation needs 16 HCP: 15 and tens bids 3NT.
  4N  "Quantitative: invites 6NT"
      when  quant_4nt   # slam.quantitative_4nt.play (slam-entry.bid)
      shows balanced, strength=slam_invite, hcp>=33-partner.hcp.max, points<=31-partner.hcp.min, H<=4, S<=4
      when  style is bba
      sets  ask=quant
  3N  "To play: {game} total points"
      shows H<=4, S<=4, bba_nt_game_points>=10, strength<=game
      when  matchpoints
      when  style is bba, partner.hcp.min>=15, partner.hcp.max<=17
  3N  "To play: game values"
      shows H<=4, S<=4, bba_nt_imp_game_points>=10, strength<=game
      when  imps
      when  style is bba, partner.hcp.min>=15, partner.hcp.max<=17
  # Opposite a 1NT that is not 15-17 (Precision, our 1NT overcall), the
  # earlier rules, measured against partner's range: the counts below were
  # fitted opposite 15-17.
  3N  "To play: {game} total points (1NT not 15-17)"
      shows H<=4, S<=4, (strength=game, C<=3 | D<=3 | C>=5 | D>=5) | (C=4, D=4, hcp>=25-partner.hcp.min, hcp<=32-partner.hcp.max)
      when  matchpoints
      when  style is bba, partner.hcp.min<=14 | partner.hcp.max>=18
  3N  "To play: game values"
      shows H<=4, S<=4, (points>=24-partner.hcp.min, points<=32-partner.hcp.max, C<=3 | D<=3 | C>=5 | D>=5) | (C=4, D=4, hcp>=24-partner.hcp.min, hcp<=32-partner.hcp.max)
      when  imps
      when  style is bba, partner.hcp.min<=14 | partner.hcp.max>=18
  2N  "Invitational: {invite} total points"
      shows H<=4, S<=4, C<=5, D<=5, (strength=invite, C<=3 | D<=3 | C>=5 | D>=5, !shape 4333 | hcp<=24-partner.hcp.max | hcp>=26-partner.hcp.max | has(T,S) | has(T,H) | has(T,D) | has(T,C)) | (C=4, D=4, hcp>=25-partner.hcp.max, hcp<=24-partner.hcp.min)
      when  minors is not four_way, minors is not four_way_reversed, matchpoints
      when  style is bba, partner.hcp.min<=14 | partner.hcp.max>=18
      sets  ask=nt_invite
  2N  "Invitational"
      shows H<=4, S<=4, C<=5, D<=5, (points>=25-partner.hcp.max, points<=23-partner.hcp.min, C<=3 | D<=3 | C>=5 | D>=5, !shape 4333 | hcp<=24-partner.hcp.max | hcp>=26-partner.hcp.max | has(T,S) | has(T,H) | has(T,D) | has(T,C)) | (C=4, D=4, hcp>=25-partner.hcp.max, hcp<=23-partner.hcp.min)
      when  minors is not four_way, minors is not four_way_reversed, imps
      when  style is bba, partner.hcp.min<=14 | partner.hcp.max>=18
      sets  ask=nt_invite
  P   "No game interest"
      shows (strength=signoff, C<=3 | D<=3 | C>=5 | D>=5) | (C=4, D=4, hcp<=24-partner.hcp.max) | (shape 4333, hcp>=25-partner.hcp.max, hcp<=25-partner.hcp.max, !has(T,S), !has(T,H), !has(T,D), !has(T,C))
      when  style is bba, partner.hcp.min<=14 | partner.hcp.max>=18
      priority -10
  # At matchpoints BBA's lines between pass, 2NT and 3NT are its own
  # counts (bba_nt_points, bba_nt_game_points: one-nt.notes.md, "BBA's
  # count"): shape-dependent weights, a ten worth 0-0.9, a doubleton major
  # without A or K charged. Calibrated opposite 15-17.
  2N  "Invitational: {invite} total points"
      shows H<=4, S<=4, C<=5, D<=5, bba_nt_points>=8, bba_nt_game_points<=9, points>=25-partner.hcp.max
      when  minors is not four_way, minors is not four_way_reversed, matchpoints
      when  style is bba, partner.hcp.min>=15, partner.hcp.max<=17
      sets  ask=nt_invite
  2N  "Invitational"
      shows H<=4, S<=4, C<=5, D<=5, bba_nt_imp_points>=8, bba_nt_imp_game_points<=9, points>=24-partner.hcp.max
      when  minors is not four_way, minors is not four_way_reversed, imps
      when  style is bba, partner.hcp.min>=15, partner.hcp.max<=17
      sets  ask=nt_invite
  P   "No game interest"
      shows bba_nt_points<=7
      when  matchpoints, style is bba, partner.hcp.min>=15, partner.hcp.max<=17
      priority -10
  P   "No game interest"
      shows bba_nt_imp_points<=7
      when  imps, style is bba, partner.hcp.min>=15, partner.hcp.max<=17
      priority -10

# Natural major-suit responses when the card plays no transfers
# (`notrump.transfers.jacoby` off; one-nt.notes.md, "Natural majors
# without transfers", probes/nt-van-*.toml). 2M is to play with five or
# more and no game interest; 3M is five or more and game values, forcing:
# opener raises to 4M with three or more, else bids 3NT. With 5-5 the
# higher suit. 5-4 in the majors goes through Stayman (stayman.bid), and
# bids 3M over the 2♦ denial.
after 1N (P) | (1x) 1N (P) | (1x) P (P) 1N (P) | (1x) 1N (X) | (1x) P (P) 1N (X) when !they.bid | systems_on
  3S  "Five or more spades, game forcing"
      shows S>=5, S>=H, strength>=game
      when  !jacoby
      sets  forcing=game, ask=choose_game(S)
  3H  "Five or more hearts, game forcing"
      shows H>=5, H>S, strength>=game
      when  !jacoby
      sets  forcing=game, ask=choose_game(H)
  4S  "To play: seven or more spades, short of a game force"
      shows S>=7, S>=H, strength=invite
      when  !jacoby
      priority 1                       # ahead of the invitational Stayman (stayman.bid)
  4H  "To play: seven or more hearts, short of a game force"
      shows H>=7, H>S, strength=invite
      when  !jacoby
      priority 1
  2S  "To play: five or more spades, no game interest"
      shows S>=5, S>=H, strength=signoff | (strength=invite, hcp<=6)
      when  !jacoby
  2H  "To play: five or more hearts, no game interest"
      shows H>=5, H>S, strength=signoff | (strength=invite, hcp<=6)
      when  !jacoby

# Opener after the signoff: pass (BBA passed 641 of 642 on the vanilla set).
after 1N (P) 2H (P) | 1N (P) 2S (P) | (1x) 1N (P) 2H (P) | (1x) 1N (P) 2S (P) | (1x) P (P) 1N (P) 2H (P) | (1x) P (P) 1N (P) 2S (P) | (1x) 1N (X) 2H (P) | (1x) 1N (X) 2S (P) | (1x) P (P) 1N (X) 2H (P) | (1x) P (P) 1N (X) 2S (P) when !jacoby
  P   "Partner's signoff"

# Opener chooses the game: four of the major with three or more (an
# eight-card fit), 3NT with two, whatever the strength (BBA, every one of
# 800 probe hands: probes/nt-van-3h-opener.toml, nt-van-3s-opener.toml).
when asked choose_game(M)
  4M  "Three or more {M}: game in the fit"   shows M>=3
  3N  "Two {M}: 3NT"                         shows M<=2

# Responder after the choice: with six, 3NT goes back to the major (an
# eight-card fit again); slam values bid it.
when answered choose_game(M), partner.last=3N
  6M  "Slam: six or more {M}, slam values"   shows M>=6, strength>=slam
  6N  "Slam values, no fit"                  shows M<=5, strength>=slam
  4N  "Quantitative, no fit"                 shows M<=5, balanced, strength=slam_invite
      when  quant_4nt   # slam.quantitative_4nt.play (slam-entry.bid)
      sets  ask=quant
  4M  "Six or more {M}: game in the fit"     shows M>=6, strength<=slam_invite
  P   "No fit: play 3NT"                     shows M<=5, strength<=slam_invite
when answered choose_game(M), partner.last=4{M}
  6M  "Slam in the fit"                      shows strength>=slam
  6M  "Slam in the fit, counting shortness"  shows tp(M)>=33-partner.points.min
  P   "Game in the fit"                      shows strength<=slam_invite
      priority -1

# Opener answers the natural 3m slam try (six of the minor, slam-invite
# values): slam with a fit and a maximum, else 3NT (it had no rule;
# Basic_What_To_Open 320).
after 1N (P) 3C (P) when !three_c_transfer, minors is not bba, !puppet_1nt
  6C  "Accepts: a club fit and a maximum"   shows C>=3, hcp>=17
  4C  "A club fit, not a maximum: responder decides"   shows C>=3, hcp<=16
      sets  trump=C, forcing=game
  3N  "Declines: no club fit"               shows C<=2
after 1N (P) 3D (P) when three_d is natural
  6D  "Accepts: a diamond fit and a maximum"   shows D>=3, hcp>=17
  4D  "A diamond fit, not a maximum: responder decides"   shows D>=3, hcp<=16
      sets  trump=D, forcing=game
  3N  "Declines: no diamond fit"               shows D<=2
# Responder after the answer: with the fit known, slam from 17 total
# points (32+ between the hands); without it, 6NT only with slam values.
after 1N (P) 3C (P) 4C (P) | 1N (P) 3D (P) 4D (P)
  6{trump} "Slam in the fit: 17+"          shows points>=17
  5{trump} "Game in the fit"               shows points<=16
after 1N (P) 3C (P) 3N (P) | 1N (P) 3D (P) 3N (P)
  6N  "No fit, but slam values: {slam} total points"   shows strength>=slam
  P   "No fit: 3NT"
      priority -5

# Opener answers the invitation: accept only when game is certain (17
# opposite 8-9). With a 4-4 major fit found through Stayman, play there.
when asked nt_invite
  4H  "Accepts, in the 4-4 heart fit"   shows H>=4, strength>=game    when partner.H>=4
  4S  "Accepts, in the 4-4 spade fit"   shows S>=4, strength>=game    when partner.S>=4
  3H  "Declines, in the 4-4 heart fit"  shows H>=4, strength<=invite  when partner.H>=4
  3S  "Declines, in the 4-4 spade fit"  shows S>=4, strength<=invite  when partner.S>=4
  3N  "Accepts the invitation"          shows strength>=game
  P   "Declines: not a maximum"         shows strength<=invite

# Responder after a decline in the fit: the invitation was answered.
# (bba: over 3S responder bids game with the top of the invitation;
# stayman.bid.)
when answered nt_invite, partner.last=3H | partner.last=3S, style is not bba
  P   "Partner declined: play three of the major"

# Opener answers the quantitative 4NT: slam with 32 combined.
when asked quant
  6N  "Accepts the slam invitation"     shows points>=32-partner.points.min
      when  style is not bba | shown.hcp.min>=nt_max+1
  P   "Declines: not enough for slam"   shows points<=31-partner.points.min
      when  style is not bba | shown.hcp.min>=nt_max+1
  # BBA, over its 1NT: 17 HCP accepts, 16 declines whatever its tens
  # (1N_Balanced_Raise, Basic_NT).
  6N  "Accepts the slam invitation"     shows hcp>=33-partner.hcp.min
      when  style is bba, shown.hcp.max<=nt_max
  P   "Declines: not enough for slam"   shows hcp<=32-partner.hcp.min
      when  style is bba, shown.hcp.max<=nt_max

# Responder over a 2♣ overcall of our 1NT, when the card keeps the
# structure on (`notrump.transfers.vs_2c`). The natural notrump calls
# are unchanged — 2♣ takes nothing away from them — and the double
# replaces the 2♣ Stayman call (stayman.bid). BBA plays it this way on
# every card in the corpus that sets the switch.
after 1N (2C) when vs_2c
  6N  "To play: {slam} total points"
      shows balanced, strength=slam, H<=4, S<=4
  4N  "Quantitative: {slam_invite} total points, invites 6NT"
      when  quant_4nt   # slam.quantitative_4nt.play (slam-entry.bid)
      shows balanced, strength=slam_invite
      sets  ask=quant
  3N  "To play: {game} total points"
      shows strength=game, H<=4, S<=4                   # with five, transfer first
  2N  "Invitational: {invite} total points"
      shows strength=invite, H<=4, S<=4, C<=5, D<=5     # a long suit has its own route
      when  minors is not four_way, minors is not four_way_reversed
      sets  ask=nt_invite
  3N  "No better call: {game} total points or more"
      shows strength>=game
      priority -5
  P   "Nothing to say over their 2♣"
      priority -10

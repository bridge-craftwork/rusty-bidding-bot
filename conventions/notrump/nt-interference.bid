# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Responder when RHO acts over our 1NT opening.
#
# Stayman and the transfers keep their own calls in `stayman.bid` and
# `jacoby-transfers.bid`, gated by the two card switches
# `notrump.transfers.vs_double` and `notrump.transfers.vs_2c`. What is
# left, and lives here, is what only exists because they bid: the
# redouble, the weak escapes when the transfers are off, and the pass.
#
# See nt-interference.notes.md for the BBA meanings behind the ranges.

module nt-interference "Our 1NT when RHO acts"
  needs  notrump-base
  param  vs_double = notrump.transfers.vs_double default false
  param  vs_2c     = notrump.transfers.vs_2c default false
  param  leb       = notrump.lebensohl.over_interference default false
  param  rub       = notrump.rubensohl.over_interference default false

# ── They doubled, transfers on ───────────────────────────────────────
# 2♣ is Stayman and 2♦/2♥ are the transfers (see the other modules).
# Everything else with values redoubles: partner has 15-17 and they have
# opened their mouth on the rest, so the hand is ours.
after 1N (X) when vs_double
  XX  "We own the hand: 6+ HCP and no suit to show"
      shows hcp>=6
      priority -1
  P   "Not enough to act over the double"
      shows hcp<=5
      priority -10

# ── They doubled, transfers off ──────────────────────────────────────
# Without the transfers the two-level calls are natural escapes: a weak
# hand runs to its own long suit and everything else passes. The cut is
# four HCP, measured against BBA on the cards that leave the switch off
# (see the notes): at five and up BBA sits for the double whatever the
# shape, and running there loses more calls than it wins. There is no
# redouble here for the same reason — BBA redoubles only about one hand
# in twenty-five, and no condition we can write picks those out.
after 1N (X) when !vs_double
  2H  "Weak: five or more hearts, running from the double"
      shows H>=5, H>=S, hcp<=4
  2S  "Weak: five or more spades, running from the double"
      shows S>=5, hcp<=4
  2C  "Weak: six or more clubs, running from the double"
      shows C>=6, H<=4, S<=4, hcp<=4
  2D  "Weak: six or more diamonds, running from the double"
      shows D>=6, H<=4, S<=4, hcp<=4
  P   "Sitting for the double"
      priority -10

# Opener after responder's escape over the double: partner's suit is
# where we play (2026-09-28: 179 no-rule boards once the opponents'
# Cappelletti doubled for penalties).
after 1N (X) 2y (P) when !vs_double, y is not N
  P   "Partner's escape: to play"

after 1N (X) XX (P)
  P   "Playing 1NT redoubled"

# Our redouble, and they run: opener passes, leaving it to responder,
# who doubles for penalties with four of their suit or 9+ HCP.
after 1N (X) XX (*) when !rho.last=P
  P   "Partner redoubled: his decision"
after 1N (X) XX (2y) P (P)
  X   "Penalty"                                  shows y>=4 | hcp>=9
  P   "Nothing more"                             priority -5

# Over a 2♣ overcall with `vs_2c` on nothing new is needed: the double
# is Stayman (stayman.bid), the transfers keep their calls
# (jacoby-transfers.bid, minor-transfers.bid, texas-transfers.bid) and
# the natural notrump calls and the pass are in one-nt.bid. With it off,
# a natural 2♣ has its own rules below.

# ── They overcalled 2♦, 2♥ or 2♠ ─────────────────────────────────────
# Their natural two-level overcall (2026-09-25; nt-interference.notes.md,
# probes/nt-2D-resp, nt-2H-resp, nt-2S-resp). No Lebensohl on the Basic
# card, so everything is natural except the double, which BBA plays as
# negative: four cards in an unbid major and 5+ HCP (over 2♠ five hearts
# with a weak hand too). A new suit at the two level is weak and to play,
# a non-jump at the three level forcing to game (BBA bids 3NT rather than
# jump in a five-card major); 2NT invites with 8-9 and 3NT is game from
# 10 (BBA does not insist on a stopper); four of a major is six cards
# and 10+.
after 1N (2y) when y is not C, rho.y>=4, (maybe rho.H<=3) | (maybe rho.S<=3)
  X   "Negative double: four cards in an unbid major, 5+ HCP"
      alert  artificial
      shows  hcp>=5, S>=4 | H>=4
      when   y is D, S<=4, H<=4
      priority 1
  X   "Negative double: four hearts (five with less than 10), 5+ HCP"
      alert  artificial
      shows  hcp>=5, H=4 | (H=5, points<=9)
      when   y is S
      priority 1
  X   "Negative double: four spades, 5+ HCP"
      alert  artificial
      shows  hcp>=5, S=4
      when   y is H
      priority 1
  2H  "Natural, to play: five or more hearts"   shows H>=5, hcp>=4, points<=9
      when  y is D
  2S  "Natural, to play: five or more spades"   shows S>=5, hcp>=4, points<=9
      when  y is D | y is H
  cheapest(C) "Natural, forcing to game: five or more clubs"      shows C>=5, points>=10
      sets  forcing=game
  cheapest(D) "Natural, forcing to game: five or more diamonds"   shows D>=5, points>=10
      when  y is not D
      sets  forcing=game
  3H  "Natural, forcing to game: five or more hearts"   shows H>=5, points>=10
      when  y is S
      sets  forcing=game
  4H  "Game: six or more hearts"   shows H>=6, hcp>=10
      when  y is not H
      priority 1
  4S  "Game: six or more spades"   shows S>=6, hcp>=10
      when  y is not S
      priority 1
  2N  "Invitational: 8-9 HCP, a stopper in {y}"   shows hcp=8..9, stop(y)
      when  !leb, !rub                  # 2NT is a relay or a transfer
      sets  ask=nt_invite
  3N  "Game: 10+ HCP"                           shows hcp>=10
      when  !leb
  P   "Nothing to say over their overcall"
      priority -10

# Opener answers the negative double: a four-card major at the cheapest
# level, 2NT with a stopper, a four-card minor, or a pass for penalties
# with four of their suit.
after 1N (2y) X (P) when y is not C, lho.y>=4, (maybe lho.H<=3) | (maybe lho.S<=3)
  cheapest(H) "Four hearts for partner's double"   shows H>=4   when y is not H
  cheapest(S) "Four spades for partner's double"   shows S>=4   when y is not S
  2N  "No four-card major, a stopper in {y}"       shows stop(y)
      priority -1
  P   "Four of their suit: defends"                shows y>=4
      priority -2
  cheapest(C) "No major, no stopper: four clubs"   shows C>=4
      priority -3
  cheapest(D) "No major, no stopper: four diamonds"   shows D>=4
      when  y is not D
      priority -3
  cheapest(N) "Nothing better to say"
      priority -5

# Responder after opener's answer: game with 10+, an invitation in the
# major with 8-9, else pass.
after 1N (2y) X (P) 2M (P) | 1N (2y) X (P) 3M (P) when y is not C, rho.y>=4, (maybe rho.H<=3) | (maybe rho.S<=3)
  4M  "Game in the fit: 10+"          shows M>=4, points>=10
  3M  "Invitational in the fit: 8-9"  shows M>=4, points=8..9
      when  partner.last=2M
  3N  "Game, no fit: 10+"             shows M<=3, points>=10
  P   "No game"                       shows points<=9
      priority -5
after 1N (2y) X (P) 2M (P) 3M (P) when y is not C, lho.y>=4, (maybe lho.H<=3) | (maybe lho.S<=3)
  4M  "Accepts the invitation: a maximum"        shows hcp>=16
  P   "Declines: a minimum"                      shows hcp<=15
after 1N (2y) X (P) 2N (P) | 1N (2y) X (P) 3C (P) | 1N (2y) X (P) 3D (P) when y is not C, rho.y>=4, (maybe rho.H<=3) | (maybe rho.S<=3)
  3N  "Game: 10+"                     shows points>=10
  P   "No game"                       shows points<=9
      priority -5

# Opener after responder's other calls.
after 1N (2y) 3z (P) when y is not C, z is not y, z is not N, lho.y>=4, (maybe lho.H<=3) | (maybe lho.S<=3)
  4{z}  "Three-card support: game in the major"   shows z>=3
        when  z is H | z is S
  3N    "Game in notrump"
        priority -1
after 1N (2y) 2z (P) when y is not C, z is not N, lho.y>=4, (maybe lho.H<=3) | (maybe lho.S<=3)
  P   "Partner's suit, to play"
after 1N (2y) 2N (P) when !leb, !rub, y is not C, lho.y>=4, (maybe lho.H<=3) | (maybe lho.S<=3)
  3N  "Accepts: a maximum"             shows hcp>=16
      priority 1                       # ahead of one-nt.bid's answer to the invitation
  P   "Declines: a minimum"            shows hcp<=15
      priority 1

# ── Their natural 2♣, transfers off (2026-09-30) ─────────────────────
# With `vs_2c` off there is no Stayman by double and no transfer, and a
# natural 2♣ (five or more clubs: `rho.C>=5`, which DONT, Meckwell,
# Cappelletti and Landy 2♣ never show) is met as BBA meets it on bare
# SAYC (nt-interference.notes.md, probes/nt-2C-nat-resp.toml): no
# negative double. A five-card suit at the two level is to play, 2NT
# invites with a club stopper, 3NT is game with one. A weak hand with
# four of a major passes and leaves it to opener's reopening double.
# Game values are ours, not BBA's (which passes some 13-16 counts): a
# five-card suit at the three level forces to game, and the cue-bid is
# Stayman forcing to game, with a four-card major or no club stopper.
after 1N (2C) when !vs_2c, rho.C>=5
  2S  "Natural, to play: five or more spades"     shows S>=5, S>=H, hcp>=4, points<=9
  2H  "Natural, to play: five or more hearts"     shows H>=5, H>S, hcp>=4, points<=9
  2D  "Natural, to play: five or more diamonds"   shows D>=5, H<=4, S<=4, hcp>=4, points<=9
  2N  "Invitational: 8-9 HCP, a club stopper"     shows hcp=8..9, stop(C), H<=4, S<=4
      sets  ask=nt_invite
  3N  "Game: 10+ HCP, a club stopper"             shows hcp>=10, stop(C), H<=3, S<=3
  3C  "Cue-bid: Stayman, forcing to game (a four-card major, or no club stopper)"
      alert  artificial
      shows  hcp>=10, H<=4, S<=4, H=4 | S=4 | !stop(C)
      sets   forcing=game
      priority 1
  3D  "Natural, forcing to game: five or more diamonds"   shows D>=5, points>=10
      sets  forcing=game
      priority 2
  3H  "Natural, forcing to game: five or more hearts"     shows H>=5, H>S, points>=10
      sets  forcing=game
      priority 2
  3S  "Natural, forcing to game: five or more spades"     shows S>=5, S>=H, points>=10
      sets  forcing=game
      priority 2
  4H  "Game: six or more hearts"   shows H>=6, H>S, points>=9
      priority 3
  4S  "Game: six or more spades"   shows S>=6, S>=H, points>=9
      priority 3
  P   "Nothing to say over their 2♣ (or clubs: waiting for the reopening double)"
      priority -10

# Opener after responder's call.
after 1N (2C) 2z (P) when !vs_2c, lho.C>=5, z is not N
  P   "Partner's suit, to play"
after 1N (2C) 2N (P) when !vs_2c, lho.C>=5
  3N  "Accepts: a maximum"             shows hcp>=16
      priority 1                       # ahead of one-nt.bid's answer to the invitation
  P   "Declines: a minimum"            shows hcp<=15
      priority 1
after 1N (2C) 3z (P) when !vs_2c, lho.C>=5, z is not C
  4{z}  "Three-card support: game in the major"   shows z>=3
        when  z is H | z is S
  3N    "Game in notrump"
        priority -1
# The cue-bid: a four-card major, else 3NT with a club stopper, else 3♦.
after 1N (2C) 3C (P) when !vs_2c, lho.C>=5
  3H  "Four hearts"                         shows H>=4
  3S  "Four spades, not four hearts"        shows S>=4, H<=3
  3N  "No four-card major, a club stopper"  shows H<=3, S<=3, stop(C)
  3D  "No four-card major, no club stopper" shows H<=3, S<=3
      priority -1
after 1N (2C) 3C (P) 3M (P) when !vs_2c, rho.C>=5
  4M  "Game in the fit"                     shows M>=4
  3S  "Four spades, not four hearts"        shows S>=4
      when  M is H
  3N  "No fit: game in notrump"
      priority -1
after 1N (2C) 3C (P) 3H (P) 3S (P) when !vs_2c, lho.C>=5
  4S  "Four spades too: game in the fit"    shows S>=4
  3N  "Game in notrump"                     priority -1
after 1N (2C) 3C (P) 3D (P) when !vs_2c, rho.C>=5
  3N  "Game in notrump: the best we have"
after 1N (2C) 3C (P) 3N (P) | 1N (2C) 3C (P) 3H (P) 3N (P) | 1N (2C) 3C (P) 3S (P) 3N (P) when !vs_2c
  P   "Game reached"

# They raised their clubs: compete in partner's major with four, accept
# the invitation with a maximum, otherwise pass.
after 1N (2C) 2M (3C) when !vs_2c, lho.C>=5
  3M  "Four-card support: competing"   shows M>=4
  P   "Nothing more to say"            priority -5
after 1N (2C) 2N (3C) when !vs_2c, lho.C>=5
  3N  "Accepts: a maximum"             shows hcp>=16
  P   "Declines: a minimum"            priority -5
# Any other raise of their clubs over partner's two-level call, and
# their next club bid after we compete: we have said what we have.
after 1N (2C) 2z (3C) | 1N (2C) 2z (4C) when !vs_2c, lho.C>=5
  P   "Partner's call said it: nothing more"   priority -10
after 1N (2C) 2M (3C) 3M (4C) when !vs_2c, rho.C>=5
  P   "We have competed: nothing more"         priority -10

# Responder passed: with two clubs opener reopens with a double (BBA,
# 32 of 32 two-club openers in the vanilla corpus; none with three).
# Responder passes for penalties with four clubs, else names a suit.
after 1N (2C) P (P) when !vs_2c, lho.C>=5
  X   "Reopening double: two clubs or fewer"   shows C<=2
      priority 1
after 1N (2C) P (P) X (P) when !vs_2c, rho.C>=5
  P   "Four or more clubs: defends"             shows C>=4
      priority 1
  2N  "8-9 HCP, a club stopper"                 shows hcp>=8, stop(C), H<=3, S<=3
  2H  "Four or more hearts"                     shows H>=4, H>=S
  2S  "Four or more spades"                     shows S>=4, S>H
  2D  "Four or more diamonds"                   shows D>=4
      priority -1
  2D  "Nothing better"                          priority -5
after 1N (2C) P (P) X (P) 2z (P) when !vs_2c, lho.C>=5, z is not N
  P   "Partner's suit, to play"
after 1N (2C) P (P) X (P) 2N (P) when !vs_2c, lho.C>=5
  3N  "Accepts: a maximum"             shows hcp>=16
      priority 1                       # ahead of one-nt.bid's answer to the invitation
  P   "Declines: a minimum"            shows hcp<=15
      priority 1

# ── Their conventional overcalls (2026-09-28, vs-1nt.notes.md) ───────
# The rules above read 2♦/2♥/2♠ as natural: they apply when the
# overcaller has shown four or more of the suit bid and not both majors.
# The opponents' defence (their card: cappelletti.bid, dont.bid,
# meckwell.bid, multi-landy.bid) can show something else:
#
# - both majors (Cappelletti 2♦, DONT 2♥): the double shows values and
#   says we can defend; a minor at the three level is natural and forcing
#   to game; 3NT is game with both majors held. Afterwards a double of
#   their major is for penalties.
# - an unknown major (Multi-Landy 2♦): the double shows values; 3NT game.
# - their 2♣ is left to the systems-on rules (Stayman by double), and
#   their double to the rules at the top.
after 1N (2y) when y is not C, rho.H>=4, rho.S>=4
  X   "Values: 8+ HCP, we can defend"                shows hcp>=8
  3C  "Natural, forcing to game: five or more clubs"      shows C>=5, points>=10
      sets  forcing=game
  3D  "Natural, forcing to game: five or more diamonds"   shows D>=5, points>=10
      sets  forcing=game
  3N  "Game: 10+, both majors held"                   shows hcp>=10, stop(H), stop(S)
  P   "Nothing to say over their overcall"
      priority -10
after 1N (2y) when y is not C, (maybe rho.y<=3), (maybe rho.H<=3) | (maybe rho.S<=3)
  X   "Values: 8+ HCP, we can defend"                shows hcp>=8
  3N  "Game: 10+ HCP"                                shows hcp>=10
  P   "Nothing to say over their overcall"
      priority -10

# Responder after a transfer that they interrupted (2026-09-28): with a
# hand no transfer continuation describes (5-4 in the majors and a
# singleton, which uncontested goes through Stayman first) he passes.
# A gap to fill, not a treatment: nt-interference.notes.md.
when answered transfer(M), they.bid
  P   "Nothing more to show"                         priority -10

# Their relay over our Stayman double (Cappelletti 2♣, X, 2♦): opener
# still shows a major, doubles 2♦ with four of them, else passes.
after 1N (2C) X (2D) when vs_2c
  2H  "4+ hearts"                                shows H>=4
  2S  "4 spades, not 4 hearts"                   shows S>=4, H<=3
  X   "Penalty: four or more diamonds, no major"  shows D>=4, H<=3, S<=3
  P   "No 4-card major"                          shows H<=3, S<=3
      priority -1

# Opener after responder's game-forcing minor over their majors: 3NT,
# the game our side can make with both majors held by one of us.
after 1N (2y) 3z (P) when y is not C, lho.H>=4, lho.S>=4, z is C | z is D
  3N  "Game in notrump"

# Opener after the value-showing double: pass unless they run; a double
# of the suit they run to is for penalties. Responder the same after
# opener's pass: game with 10+ and their suit held.
after 1N (2y) X (P) when y is not C, (lho.H>=4, lho.S>=4) | ((maybe lho.y<=3), (maybe lho.H<=3) | (maybe lho.S<=3))
  P   "Defending their artificial overcall"

# Whatever their overcall, once their advancer bids over our double
# opener has said what he has; the rules above add what he can (a
# penalty double). 2026-09-28: 110 no-rule boards, 1N 2♠ X 2NT and alike.
after 1N (2y) X (*) when !rho.last=P, !rho.last=X
  P   "Nothing more to say"                          priority -10
after 1N (2y) X (2z) when y is not C, (lho.H>=4, lho.S>=4) | ((maybe lho.y<=3), (maybe lho.H<=3) | (maybe lho.S<=3))
  X   "Penalty: four or more {z}"                    shows z>=4
  P   "Nothing more to say"                          priority -5
after 1N (2y) X (2z) X (P) when y is not C, (rho.H>=4, rho.S>=4) | ((maybe rho.y<=3), (maybe rho.H<=3) | (maybe rho.S<=3))
  P   "Partner doubled for penalties: defend"
after 1N (2y) X (2z) P (P) when y is not C, (rho.H>=4, rho.S>=4) | ((maybe rho.y<=3), (maybe rho.H<=3) | (maybe rho.S<=3))
  X   "Penalty: four or more {z}"                    shows z>=4
  3N  "Game: 10+, {z} held"                          shows hcp>=10, stop(z)
  P   "Nothing more to say"                          priority -5

# ── Their 2NT: both minors (Cappelletti, Meckwell, Multi-Landy) ─────
after 1N (2N)
  X   "Values: 8+ HCP, we can defend"                shows hcp>=8
  3H  "Natural, forcing to game: five or more hearts"     shows H>=5, points>=10
      sets  forcing=game
  3S  "Natural, forcing to game: five or more spades"     shows S>=5, points>=10
      sets  forcing=game
  4H  "Game: six or more hearts"                     shows H>=6, hcp>=10
      priority 1
  4S  "Game: six or more spades"                     shows S>=6, hcp>=10
      priority 1
  3N  "Game: 10+ HCP"                                shows hcp>=10
  P   "Nothing to say over their 2NT"
      priority -10
after 1N (2N) 3z (P) when z is H | z is S
  4{z}  "Three-card support: game in the major"      shows z>=3
  3N    "Game in notrump"
        priority -1

# Responder passed their overcall: opener has shown his hand.
after 1N (2y) P (P)
  P   "Partner passed: no game, let them play"

# ── They preempted over our 1NT (a three-level suit) ─────────────────
# No rule existed (2026-09-25: 1NT (3H) in Basic_NT and What_To_Open).
# Game in notrump with their suit held, four of a five-card major, a
# double with game values and no stopper, short in their suit (opener
# passes it with four of theirs); otherwise pass.
after 1N (3y) when y is not N
  3N  "Game: 9+, a stopper in {y}"         shows hcp>=9, stop(y)
  4H  "Game: five or more hearts, 9+"      shows H>=5, hcp>=9
      when  y is not H
  4S  "Game: five or more spades, 9+"      shows S>=5, hcp>=9
      when  y is not S
  X   "Takeout: 9+, no stopper in {y}"     shows hcp>=9, y<=2
      priority -1
  P   "Nothing to say over their preempt"
      priority -10
after 1N (3y) X (P) when y is not N
  P   "Four of their suit: defends"        shows y>=4
      priority 1
  3N  "A stopper in {y}"                   shows stop(y)
  cheapest(S) "Four or more spades"        shows S>=4   when y is not S
  cheapest(H) "Four or more hearts"        shows H>=4   when y is not H
  cheapest(D) "Four or more diamonds"      shows D>=4   when y is not D
      priority -1
  cheapest(C) "Four or more clubs"         shows C>=4   when y is not C
      priority -1
  3N  "Nothing better: 3NT"
      priority -5
after 1N (3y) P (P) when y is not N
  P   "Partner passed: let them play"

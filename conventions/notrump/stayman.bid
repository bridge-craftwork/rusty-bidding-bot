# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.

module stayman "Stayman"
  card   notrump.stayman.play
  needs  notrump-base
  param  minors = notrump.minor_transfers default relay
  param  systems_on = nt_overcalls.direct.systems_on default true
  param  vs_double = notrump.transfers.vs_double default false
  param  vs_2c = notrump.transfers.vs_2c default false

after 1N (P) | (1x) 1N (P) | (1x) P (P) 1N (P) when !they.bid | systems_on
  2C  "Stayman: asks for a 4-card major"  alert
      shows strength>=invite, H=4 | S=4 | ((minors is four_way | minors is four_way_reversed), strength=invite)
      when  !shape 4333 | ((minors is four_way | minors is four_way_reversed), strength=invite)
      # 5-4 in the majors included (Smolen). 4-3-3-3 just bids notrump, except
      # with four-way transfers, where 2NT is not natural: invitational hands
      # go through Stayman, with or without a major, and bid 2NT next.
      sets  forcing=round, ask=majors
      artificial
      priority 1                           # ahead of transfers with 5-4 majors

# Opener. With both majors the first rule that fits (2H) wins.
after 1N (P) 2C (P) | (1x) 1N (P) 2C (P) | (1x) P (P) 1N (P) 2C (P)
  2H  "4+ hearts"                 shows H>=4
  2S  "4 spades, not 4 hearts"    shows S>=4, H<=3
  2D  "No 4-card major"           shows H<=3, S<=3

# Responder's second call. No auction patterns: a fit is whatever opener's
# answer has shown. Without a fit, 2NT and 3NT imply the other major, and
# opener corrects with four of it (choice-of-games.bid).
when answered majors
  6H  "Slam in the heart fit"                     shows H>=4, strength=slam   when partner.H>=4
  6S  "Slam in the spade fit"                     shows S>=4, strength=slam   when partner.S>=4
  4H  "Game in the heart fit"                     shows H>=4, strength>=game  when partner.H>=4
  3H  "Invitational raise in hearts"              shows H>=4, strength=invite when partner.H>=4
      sets ask=invite(H)
  4S  "Game in the spade fit"                     shows S>=4, strength>=game  when partner.S>=4
  3S  "Invitational raise in spades"              shows S>=4, strength=invite when partner.S>=4
      sets ask=invite(S)
  6N  "Slam: {slam} total points, no fit found"   shows strength=slam
  3N  "Game: {game} total points, no fit found"   shows strength=game         sets ask=choice
      priority -1                                 # a known major fit first
  2N  "Invitational: {invite} total points, no fit found"
      shows strength=invite
      sets  ask=nt_invite
      priority -1                                 # a known major fit first

# ── Under interference ───────────────────────────────────────────────
# Two card switches say the 1NT structure survives RHO's action:
# `transfers.vs_double` keeps it over a double, and `transfers.vs_2c`
# over a 2♣ overcall. Over the double 2♣ is still Stayman; over 2♣ the
# call is gone and the double takes its place, which is what BBA plays
# on every card in the corpus that sets the switch.

# Over the double Stayman starts a point below the invitational floor
# (7 opposite 15-17): finding the 4-4 fit is also somewhere to run to.
# It denies a five-card major, unlike the uncontested 2C: with 5-4 BBA
# transfers rather than looking for the other major first.
after 1N (X) when vs_double
  2C  "Stayman: asks for a 4-card major"  alert
      shows hcp>=24-partner.hcp.max, H=4 | S=4
      when  H<=4, S<=4
      sets  forcing=round, ask=majors
      artificial
      priority 1

after 1N (2C) when vs_2c
  X   "Stayman: asks for a 4-card major"  alert
      shows strength>=invite, H=4 | S=4
      when  H<=4, S<=4
      sets  forcing=round, ask=majors
      artificial
      priority 1

# Opener answers, one level higher over the 2♣ overcall.
after 1N (X) 2C (P) when vs_double
  2H  "4+ hearts"                 shows H>=4
  2S  "4 spades, not 4 hearts"    shows S>=4, H<=3
  2D  "No 4-card major"           shows H<=3, S<=3

after 1N (2C) X (P) when vs_2c
  2H  "4+ hearts"                 shows H>=4
  2S  "4 spades, not 4 hearts"    shows S>=4, H<=3
  2D  "No 4-card major"           shows H<=3, S<=3

# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.

module texas-transfers "Texas Transfers"
  card   notrump.transfers.texas
  needs  notrump-base
  skill  bidding_conventions/jacoby_transfers
  param  tu = notrump.transfers.texas_2_under default false

# Texas shows a six-card major and one of two hands: game with no slam
# interest (pass the completion), or slam values (keycard after it): 33 total
# points or more even opposite opener's minimum, so 18+ opposite 15-17,
# in suit points or in support points (HCP + shortness, the fit being
# certain with six trumps). With
# mild slam interest responder transfers at the two level and jumps to game
# instead (jacoby-transfers.bid), which lets opener bid on. Game values
# count HCP and length points (8 + 2 for six cards = 10 opposite 15-17:
# Rick, 2026-10-29); the top of game-only and the slam band are in suit
# points.
#
# Where (Rick, 2026-10-29): every notrump of ours where the system is on
# (`systems`, one-nt.bid): the 1NT and 2NT openings, our notrump overcall
# and balancing notrump as the card says, 2♣–2♦–2NT, Kokish's
# 2♣–2♦–2♥–2♠–2NT, 2♣ and a positive then 2NT. The strength bands are
# measured against opener's range, so the same rules serve every one.
# Over interference Texas stays on as long as it is a jump: a double, or
# any bid that leaves three of the transfer suit available (4♦ over
# 2-level bids and 3♣, 4♥ also over 3♦), and never into their suit.
# `notrump.transfers.vs_2c` is a different question (2♦/2♥ transfers over
# their 2♣, nt-interference.bid) and does not switch Texas.
define texas_room_d = !tu, !me.named(H), rho.last=P | rho.last=X | (they.level<=2, they.strain is not H) | (they.level=3, they.strain is C)
# 2-under Texas (`notrump.transfers.texas_2_under`, Rick 2026-10-29): one
# step lower, 4♣ for hearts and 4♦ for spades, with the same hands; opener
# bids the suit in between to super-accept (four trumps, the top of his
# range) or four of the major. 4♥ is then natural (Rick, 2026-10-29).
define texas2_room_c = tu, !me.named(H), rho.last=P | rho.last=X | (they.level<=2, they.strain is not H)
define texas2_room_d = tu, !me.named(S), rho.last=P | rho.last=X | (they.level<=2, they.strain is not S) | (they.level=3, they.strain is C)
define texas_room_h = !tu, !me.named(S), rho.last=P | rho.last=X | (they.level<=2, they.strain is not S) | (they.level=3, they.strain is C | they.strain is D)

after systems 1N (*) | systems 2N (*) | 2C (*) 2D (*) 3N (P)
  4D  "Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=6, points>=25-partner.points.min, suit_points<=30-partner.points.max
      when  texas_room_d
      sets  ask=texas(H)
      artificial
  4D  "Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=6, suit_points>=33-partner.points.min
      when  texas_room_d
      sets  ask=texas(H)
      artificial
  4D  "Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=6, tp(H)>=33-partner.points.min
      when  texas_room_d
      sets  ask=texas(H)
      artificial
  4H  "Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=6, points>=25-partner.points.min, suit_points<=30-partner.points.max
      when  texas_room_h
      sets  ask=texas(S)
      artificial
  4H  "Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=6, suit_points>=33-partner.points.min
      when  texas_room_h
      sets  ask=texas(S)
      artificial
  4H  "Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=6, tp(S)>=33-partner.points.min
      when  texas_room_h
      sets  ask=texas(S)
      artificial
  # Over interference Texas doubles as a preempt: with seven cards and
  # no values BBA transfers straight to game rather than to the two
  # level, and takes the auction away from them.
  4D  "Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=7, hcp>=4, suit_strength=signoff
      when  !(rho.last=P | rho.last=X), texas_room_d
      sets  ask=texas(H)
      artificial
  4H  "Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=7, hcp>=4, suit_strength=signoff
      when  !(rho.last=P | rho.last=X), texas_room_h
      sets  ask=texas(S)
      artificial

  # 2-under Texas: the same hands, one step lower.
  4C  "2-under Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=6, points>=25-partner.points.min, suit_points<=30-partner.points.max
      when  texas2_room_c
      sets  ask=texas2(H)
      artificial
  4C  "2-under Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=6, suit_points>=33-partner.points.min
      when  texas2_room_c
      sets  ask=texas2(H)
      artificial
  4C  "2-under Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=6, tp(H)>=33-partner.points.min
      when  texas2_room_c
      sets  ask=texas2(H)
      artificial
  4D  "2-under Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=6, points>=25-partner.points.min, suit_points<=30-partner.points.max
      when  texas2_room_d
      sets  ask=texas2(S)
      artificial
  4D  "2-under Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=6, suit_points>=33-partner.points.min
      when  texas2_room_d
      sets  ask=texas2(S)
      artificial
  4D  "2-under Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=6, tp(S)>=33-partner.points.min
      when  texas2_room_d
      sets  ask=texas2(S)
      artificial
  4C  "2-under Texas: 6+ ♥, game only or slam values"  announce "Transfer"
      shows H>=7, hcp>=4, suit_strength=signoff
      when  !(rho.last=P | rho.last=X), texas2_room_c
      sets  ask=texas2(H)
      artificial
  4D  "2-under Texas: 6+ ♠, game only or slam values"  announce "Transfer"
      shows S>=7, hcp>=4, suit_strength=signoff
      when  !(rho.last=P | rho.last=X), texas2_room_d
      sets  ask=texas2(S)
      artificial

# Opener completes, whatever came in between, when it is still legal.
when asked texas(H)
  4H  "Completes the transfer"
when asked texas(S)
  4S  "Completes the transfer"

when answered texas(M)
  4N  "Keycard ask in {M}"   shows suit_points>=33-partner.points.min   sets ask=keycards(M)  artificial
  4N  "Keycard ask in {M}"   shows tp(M)>=33-partner.points.min   sets ask=keycards(M)  artificial
  P   "No slam interest"

# 2-under Texas: opener super-accepts with the suit in between, else
# completes; responder signs off over the super-accept or asks for keycards.
when asked texas2(H)
  4D  "Super-accept: four hearts, a maximum"   shows H>=4, hcp>=shown.hcp.max-1
      artificial
      priority 1
  4H  "Completes the transfer"
when asked texas2(S)
  4H  "Super-accept: four spades, a maximum"   shows S>=4, hcp>=shown.hcp.max-1
      artificial
      priority 1
  4S  "Completes the transfer"

when answered texas2(M)
  4N  "Keycard ask in {M}"   shows suit_points>=33-partner.points.min   sets ask=keycards(M)  artificial
  4N  "Keycard ask in {M}"   shows tp(M)>=33-partner.points.min   sets ask=keycards(M)  artificial
  4{M} "Signoff"
      when  !(partner.last=4{M})
  P   "No slam interest"
      when  partner.last=4{M}

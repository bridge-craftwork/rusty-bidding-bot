# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Flannery 2♦ (Bridge Bum, "Flannery 2D"): an opening 2♦ shows 11-15 HCP
# with exactly four spades and five hearts, so the 1♥ opener never has to
# reverse or rebid awkwardly with the 4-5 majors. The natural weak 2♦ is
# off (preempts.bid, `weak_2d_open`). Responder:
#
#   Pass  6+ diamonds, weak          2♥/2♠  to play
#   2NT   asks (forcing)             3♣  6+ clubs, to play
#   3♦    6+ diamonds, invitational  3♥/3♠  invitational, 10-12
#   3NT   to play                    4♣/4♦  transfer to 4♥/4♠
#
# Opener's answers to 2NT: 3♣ 4-5-1-3, 3♦ 4-5-3-1, 3♥ 4-5-2-2 minimum,
# 3♠ 4-5-2-2 maximum, 3NT 4-5-2-2 maximum with the minors stopped, 4♣
# 4-5-0-4, 4♦ 4-5-4-0. See flannery.notes.md.

module flannery "Flannery 2♦"
  card   two_level.flannery.play
  needs  preempts
  skill  bidding_conventions/flannery

# ── The opening ──────────────────────────────────────────────────────
# Ahead of 1♥ and 1NT (both would describe it less well).
when opening
  2D  "Flannery: 11-15 HCP, four spades and five hearts"   alert
      shows S=4, H=5, hcp=11..15
      artificial
      priority 1

# ── Responder ────────────────────────────────────────────────────────
# Over a double the same calls (the double is usually a strong hand or
# diamonds; nothing is lost by playing the system on).
after 2D (P) | 2D (X)
  P   "Six or more diamonds, weak: to play"
      shows D>=6, hcp<=9, H<=2, S<=3
      priority 1
  2S  "To play: no game opposite 11-15"
      shows hcp<=9, S>=4 | (S=3, H<=1)
  2H  "To play: no game opposite 11-15"
      shows hcp<=10
      priority -1
  3C  "Six or more clubs: to play"
      shows C>=6, hcp<=9, H<=2, S<=3
      priority 1
  3D  "Six or more diamonds, invitational"
      shows D>=6, hcp=10..12, H<=2, S<=3
  3H  "Invitational: three or more hearts, 10-12"
      shows H>=3, tp(H)=10..12, S<=3
  3S  "Invitational: four or more spades, 10-12"
      shows S>=4, tp(S)=10..12
  # Game in a major: the transfer, so that opener declares.
  4C  "Transfer to 4♥: game, no slam interest"   alert
      shows H>=3, tp(H)>=13, tp(H)<=18, S<=3
      sets  trump=H
      artificial
  4D  "Transfer to 4♠: game, no slam interest"   alert
      shows S>=4, tp(S)>=13, tp(S)<=18
      sets  trump=S
      artificial
  3N  "To play: the minors held, no major fit"
      shows hcp=13..17, H<=2, S<=3, stop(C), stop(D)
  2N  "Asks opener's shape: game interest"   alert
      shows hcp>=11
      sets  forcing=round, ask=flannery
      artificial
      priority -1

# ── Opener after a sign-off or a natural game ────────────────────────
after 2D (P) 2H (P) | 2D (P) 2S (P) | 2D (P) 3C (P) | 2D (P) 3N (P)
  P   "Partner has placed the contract"

after 2D (P) 3H (P)
  4H  "Accepts the invitation: 14-15"   shows hcp>=14
  P   "Declines: a minimum"
after 2D (P) 3S (P)
  4S  "Accepts the invitation: 14-15"   shows hcp>=14
  P   "Declines: a minimum"
after 2D (P) 3D (P)
  3N  "Accepts: a maximum with the clubs stopped"   shows hcp>=14, stop(C)
  P   "Declines"

after 2D (P) 4C (P)
  4H  "Completes the transfer"
after 2D (P) 4D (P)
  4S  "Completes the transfer"

# ── Opener answers 2NT ───────────────────────────────────────────────
when asked flannery
  3C  "Three clubs: 4-5-1-3"              shows D=1, C=3   artificial
  3D  "Three diamonds: 4-5-3-1"           shows D=3, C=1   artificial
  3H  "4-5-2-2, minimum (11-13)"           shows D=2, C=2, hcp<=13
  3S  "4-5-2-2, maximum (14-15)"           shows D=2, C=2, hcp>=14   artificial
  3N  "4-5-2-2, maximum, the minors held"  shows D=2, C=2, hcp>=14, stop(C), stop(D)
  4C  "Four clubs: 4-5-0-4"                shows D=0, C=4   artificial
  4D  "Four diamonds: 4-5-4-0"             shows D=4, C=0   artificial

# ── The asker places the contract ────────────────────────────────────
# 3NT with the short suit held, else game in the 5-2 heart fit; a
# fit in the minor that opener holds as a side suit is left to the
# natural rules.
when answered flannery
  P   "3NT is the contract"
      when  partner.last=3N
      priority 1
  4S  "Game in the spade fit"                shows S>=4
      priority 1
  4H  "Game in the heart fit"                shows H>=2
      when  !partner.last=3N
  3N  "To play: the short suit held"
      shows stop(C) | partner.C.min>=2, stop(D) | partner.D.min>=2
      when  partner.last <= 3S
      priority 1

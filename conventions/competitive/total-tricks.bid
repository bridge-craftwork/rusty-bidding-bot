# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# The Law of Total Tricks (Rick, 2026-09-27; Basic_Takeout_Double 193).
# When both sides are bidding and the hand is not clearly ours, compete
# to the level where the tricks needed equal our trumps: eight trumps,
# the two level; nine, three; ten, four. No higher.
#
# Our trumps are my length plus what partner has shown. A takeout double
# of a major counts as four in the unbid suits once it is known to be the
# shape double (the power branch collapses when the deck or the auction
# rules out 17 HCP): BBA's doubler holds four of the other major 68% of
# the time and four of a minor 73% (probes/tools/takeout_shape.py).
# Elsewhere partner counts for what he has shown.
#
# At unfavourable vulnerability we hedge a trick: one level lower.
#
# Three rules, one per level: the doubler's bonus and the hedge are terms
# in the count (a condition counts 1 when it holds). Until 2026-09-30 the
# file spelled each combination out, twelve rules (docs/JUDGMENT-LAYER.md,
# Phase 0).
#
# A fallback: below every rule that describes a hand, above the passes
# that only say "nothing more to say".

module total-tricks "The Law of Total Tricks"
  needs  base
  skill  competitive_bidding/law_of_total_tricks

# Partner's three cards in x count as four when his takeout double of
# their major is known to be the shape double.
define doubler_four(x) = ((lho.H>=5 | rho.H>=5), partner.S>=3, partner.D>=3, partner.C>=3) | ((lho.S>=5 | rho.S>=5), partner.H>=3, partner.D>=3, partner.C>=3), partner.x.min = 3

# Our trumps as the Law counts them, a trick fewer at unfavourable.
define lott_trumps(x) = we.fit(x).min + doubler_four(x) - unfavourable

when they.bid, they.still_bidding, !game_reached   # not once we have bid game (ticket b100)
  2x  "Total tricks: eight trumps between us: the two level"
      shows lott_trumps(x) = 8
      when  doubler_four(x) | !doubler_four(x)       # known either way: not while the double may be the strong one
      when  partner.x>=3, hcp>=5, we.hcp.min <= 24   # not clearly our hand
      sets  ask=signoff
      priority -4
  3x  "Total tricks: nine trumps between us: the three level"
      shows lott_trumps(x) = 9
      when  doubler_four(x) | !doubler_four(x)
      when  partner.x>=3, hcp>=5, we.hcp.min <= 24
      sets  ask=signoff
      priority -4
  4x  "Total tricks: ten+ trumps between us: the four level"
      shows lott_trumps(x) >= 10
      when  doubler_four(x) | !doubler_four(x)
      when  partner.x>=3, hcp>=5, we.hcp.min <= 24
      sets  ask=signoff
      priority -4

# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Defence against their preempts (2026-09-27). The par attribution
# (probes/tools/par_blame.py) showed our side passing out their weak twos
# and three-level preempts: over anything but a one-level opening there
# were no rules at all.
#
# Natural, as the Basic-Bridge card plays it, and as BBA bids it there
# (probes/vs-w2-2D.toml, vs-w2-2H.toml, vs-w2-2S.toml): the one-level
# structure a level higher.
#
# - a takeout double: 12+ total points, two or fewer of theirs and three
#   or more in each unbid suit, or 17+ HCP with three or fewer of theirs
#   (the power double, then bid again);
# - a new suit: five or more, 12-16 HCP; at the three level 13 total
#   points; a suit worth bidding (two of the top three, three of the top
#   five, six cards, or an opening hand of 13 total points);
# - a jump to three of a major: six or more, 15-16;
# - 2NT: 15-17 balanced, their suit stopped, no five-card major;
# - four of a major: seven or more, game;
# - otherwise pass.
#
# A weak two is told from a strong 2C by what the opener has shown: at
# most 12 HCP.

module vs-preempts "Defence against preempts"
  needs  base
  skill  competitive_bidding/defense_vs_preempts
  skill  competitive_bidding/takeout_doubles
  skill  competitive_bidding/lebensohl
  param  leb = competitive.lebensohl_weak_twos.play default false
  param  rub = competitive.rubensohl_after_double.play default false

# ── Direct seat over their weak two ──────────────────────────────────
after (2x) when x is not N, rho.hcp.max <= 12
  X   "Takeout: 12+ total points and the unbid suits, or 17+ with any shape"
      shows hcp+length_points>=12
      shows ((S>=3 | x is S), (H>=3 | x is H), (D>=3 | x is D), (C>=3 | x is C), x<=2) | (hcp>=17, x<=3)
  cheapest(S) "Overcall: five or more spades, 12-16"
      shows S>=5, S>=H, S>=D, S>=C, hcp+length_points>=12, hcp<=16
      when  x is not S
      when  quality(S)>=good | top5(S)>=3 | S>=6 | hcp+length_points>=13
      when  cheapest_rank(S) <= 13 | hcp+length_points>=13
  cheapest(H) "Overcall: five or more hearts, 12-16"
      shows H>=5, H>S, H>=D, H>=C, hcp+length_points>=12, hcp<=16
      when  x is not H
      when  quality(H)>=good | top5(H)>=3 | H>=6 | hcp+length_points>=13
      when  cheapest_rank(H) <= 13 | hcp+length_points>=13
  cheapest(D) "Overcall: five or more diamonds, 12-16"
      shows D>=5, D>S, D>H, D>=C, hcp+length_points>=12, hcp<=16
      when  x is not D
      when  quality(D)>=good | top5(D)>=3 | D>=6 | hcp+length_points>=13
      when  cheapest_rank(D) <= 13 | hcp+length_points>=13
  cheapest(C) "Overcall: five or more clubs, 12-16"
      shows C>=5, C>S, C>H, C>D, hcp+length_points>=12, hcp<=16
      when  x is not C
      when  quality(C)>=good | top5(C)>=3 | C>=6 | hcp+length_points>=13
      when  cheapest_rank(C) <= 13 | hcp+length_points>=13
  jump(S) "Strong jump overcall: six or more spades, 15-16"
      shows S>=6, hcp=15..16
      when  x is not S
  jump(H) "Strong jump overcall: six or more hearts, 15-16"
      shows H>=6, H>S, hcp=15..16
      when  x is not H, x is not S
  cheapest(N) "15-17 balanced, {x} stopped, no five-card major"
      shows balanced, hcp=15..17, S<=4, H<=4
      when  stop(x)
  4S  "Seven or more spades: game"
      shows S>=7, hcp+length_points>=13
      when  x is not S
  4H  "Seven or more hearts: game"
      shows H>=7, H>S, hcp+length_points>=13
      when  x is not H
  P   "Nothing to say over their weak two"
      priority -10

# ── Balancing over their weak two: (2x) P (P) ───────────────────────
# BBA (probes/vs-w2-2H-bal.toml): lighter than direct. A reopening double
# with two or fewer of theirs and 12+; a new suit from 9 total points at
# the two level, 11 at the three; 2NT 16-18; a jump to three of a major
# with six and 15+.
after (2x) P (P) when x is not N, lho.hcp.max <= 12
  X   "Reopening double: 12+, short in {x}, the unbid suits"
      shows hcp+length_points>=12
      shows ((S>=3 | x is S), (H>=3 | x is H), (D>=3 | x is D), (C>=3 | x is C), x<=2) | (hcp>=17, x<=3)
  cheapest(S) "Balancing: five or more spades"
      shows S>=5, S>=H, S>=D, S>=C, hcp+length_points>=9, hcp<=16
      when  x is not S
      when  cheapest_rank(S) <= 13 | hcp+length_points>=11
  cheapest(H) "Balancing: five or more hearts"
      shows H>=5, H>S, H>=D, H>=C, hcp+length_points>=9, hcp<=16
      when  x is not H
      when  cheapest_rank(H) <= 13 | hcp+length_points>=11
  cheapest(D) "Balancing: five or more diamonds"
      shows D>=5, D>S, D>H, D>=C, hcp+length_points>=9, hcp<=16
      when  x is not D
      when  cheapest_rank(D) <= 13 | hcp+length_points>=11
  cheapest(C) "Balancing: five or more clubs"
      shows C>=5, C>S, C>H, C>D, hcp+length_points>=9, hcp<=16
      when  x is not C
      when  cheapest_rank(C) <= 13 | hcp+length_points>=11
  jump(S) "Six or more spades, 15-16"
      shows S>=6, hcp=15..16
      when  x is not S, cheapest_rank(S) <= 13
  jump(H) "Six or more hearts, 15-16"
      shows H>=6, H>S, hcp=15..16
      when  x is not H, cheapest_rank(H) <= 13
  cheapest(N) "16-18 balanced, {x} stopped"
      shows balanced, hcp=16..18, S<=4, H<=4
      when  stop(x)
  P   "Nothing to reopen with"
      priority -10

# ── Direct seat over their three-level preempt ───────────────────────
# BBA (probes/vs-p3-3{C,D,H,S}.toml): a takeout double from 12; a new
# suit at the three level from 12 total points, at the four level from
# 14; 3NT 17-21 with their suit stopped; four of a major with seven.
after (3x) when x is not N, rho.hcp.max <= 12
  X   "Takeout: 12+, short in {x}, the unbid suits, or 17+"
      shows hcp+length_points>=12
      shows ((S>=3 | x is S), (H>=3 | x is H), (D>=3 | x is D), (C>=3 | x is C), x<=2) | (hcp>=17, x<=3)
  cheapest(S) "Overcall: five or more spades"
      shows S>=5, S>=H, S>=D, S>=C, hcp+length_points>=12, hcp<=17
      when  x is not S
      when  quality(S)>=good | top5(S)>=3 | S>=6 | hcp+length_points>=14
      when  cheapest_rank(S) <= 18 | hcp+length_points>=14
  cheapest(H) "Overcall: five or more hearts"
      shows H>=5, H>S, H>=D, H>=C, hcp+length_points>=12, hcp<=17
      when  x is not H
      when  quality(H)>=good | top5(H)>=3 | H>=6 | hcp+length_points>=14
      when  cheapest_rank(H) <= 18 | hcp+length_points>=14
  cheapest(D) "Overcall: five or more diamonds"
      shows D>=5, D>S, D>H, D>=C, hcp+length_points>=12, hcp<=17
      when  x is not D
      when  quality(D)>=good | top5(D)>=3 | D>=6 | hcp+length_points>=14
      when  cheapest_rank(D) <= 18 | hcp+length_points>=14
  cheapest(C) "Overcall: five or more clubs"
      shows C>=5, C>S, C>H, C>D, hcp+length_points>=12, hcp<=17
      when  x is not C
      when  quality(C)>=good | top5(C)>=3 | C>=6 | hcp+length_points>=14
      when  cheapest_rank(C) <= 18 | hcp+length_points>=14
  3N  "17-21 with {x} stopped"
      shows hcp=17..21, S<=4, H<=4
      when  stop(x)
  4S  "Seven or more spades: game"
      shows S>=7, hcp+length_points>=13
      when  x is not S
  4H  "Seven or more hearts: game"
      shows H>=7, H>S, hcp+length_points>=13
      when  x is not H
  P   "Nothing to say over their preempt"
      priority -10

# ── Balancing over their three-level preempt: (3x) P (P) ─────────────
# BBA (probes/vs-p3-3H-bal.toml): a reopening double with 12+ and at most
# one of theirs; a new suit at the three level from 11 total points, at
# the four from 13; 3NT 17-20 with their suit stopped.
after (3x) P (P) when x is not N, lho.hcp.max <= 12
  X   "Reopening double: 12+, short in {x}, the unbid suits"
      shows hcp+length_points>=12
      shows ((S>=3 | x is S), (H>=3 | x is H), (D>=3 | x is D), (C>=3 | x is C), x<=1) | (hcp>=17, x<=3)
  cheapest(S) "Balancing: five or more spades"
      shows S>=5, S>=H, S>=D, S>=C, hcp+length_points>=11, hcp<=17
      when  x is not S
      when  cheapest_rank(S) <= 18 | hcp+length_points>=13
  cheapest(H) "Balancing: five or more hearts"
      shows H>=5, H>S, H>=D, H>=C, hcp+length_points>=11, hcp<=17
      when  x is not H
      when  cheapest_rank(H) <= 18 | hcp+length_points>=13
  cheapest(D) "Balancing: five or more diamonds"
      shows D>=5, D>S, D>H, D>=C, hcp+length_points>=11, hcp<=17
      when  x is not D
      when  cheapest_rank(D) <= 18 | hcp+length_points>=13
  cheapest(C) "Balancing: five or more clubs"
      shows C>=5, C>S, C>H, C>D, hcp+length_points>=11, hcp<=17
      when  x is not C
      when  cheapest_rank(C) <= 18 | hcp+length_points>=13
  3N  "17-20 with {x} stopped"
      shows hcp=17..20, S<=4, H<=4
      when  stop(x)
  P   "Nothing to reopen with"
      priority -10

# ── Their four-level preempt ─────────────────────────────────────────
# BBA (probes/vs-p4-4H.toml, vs-p4-4S.toml, vs-p4-4H-bal.toml). Over 4H a
# takeout double from 14 and 4S with five from 14 total points; over 4S
# the double is for penalty, 17+ (values: partner leaves it in unless
# his shape says otherwise); five of a minor from 16. Balancing over 4H:
# the double from 12 with no hearts, 4S from 13, five of a minor from 15.
after (4x) when x is H, rho.hcp.max <= 12
  X   "Takeout: 14+, short in hearts"
      shows hcp+length_points>=14, x<=2, S>=3
  4S  "Five or more spades, 14+"
      shows S>=5, hcp+length_points>=14
  cheapest(D) "Five or more diamonds, 16+"   shows D>=5, D>=C, hcp+length_points>=16
  cheapest(C) "Five or more clubs, 16+"      shows C>=5, C>D, hcp+length_points>=16
  P   "Nothing to say over their preempt"
      priority -10
after (4x) when x is S, rho.hcp.max <= 12
  X   "Values: 17+, for penalty"
      shows hcp>=17, x>=2
  cheapest(D) "Five or more diamonds, 16+"   shows D>=5, D>=C, hcp+length_points>=16
  cheapest(H) "Five or more hearts, 16+"     shows H>=5, H>=D, H>=C, hcp+length_points>=16
  cheapest(C) "Five or more clubs, 16+"      shows C>=5, C>D, hcp+length_points>=16
  P   "Nothing to say over their preempt"
      priority -10
after (4x) P (P) when x is H, lho.hcp.max <= 12
  X   "Reopening double: 12+, no hearts"
      shows hcp+length_points>=12, x<=1
  4S  "Five or more spades, 13+"             shows S>=5, hcp+length_points>=13
  cheapest(D) "Five or more diamonds, 15+"   shows D>=5, D>=C, hcp+length_points>=15
  cheapest(C) "Five or more clubs, 15+"      shows C>=5, C>D, hcp+length_points>=15
  P   "Nothing to reopen with"
      priority -10
# Advancer after our double of their four-level preempt: over 4H take
# it out into five or more spades; otherwise leave it in.
after (4x) X (P) | (4x) P (P) X (P) when x is H | x is S
  4S  "Five or more spades"                  shows S>=5
      when  x is H
  P   "Leaves the double in"
      priority -5

# ── Advancer after our double of their weak two ──────────────────────
# BBA (probes/vs-w2-2H-X-adv.toml, vs-w2-2S-X-adv.toml): the cheapest
# suit with four, 0-10 (majors first); a jump in a major with five, 8-11;
# 2NT 11-12 and 3NT 12+ with their suit stopped; the cue bid of their
# suit, 13+, forcing to game; four of a major with four and game values;
# a pass with length and strength in their suit.
after (2x) X (P) | (3x) X (P) | (2x) P (P) X (P) | (3x) P (P) X (P) when x is not C
  P   "Penalty: five of their suit with two top honours"
      shows x>=5, quality(x)>=good | top5(x)>=3
      priority 2
  P   "Penalty: four of their suit, a flat hand and 10+"
      shows x=4, hcp>=10, stop(x), S<=4, H<=4, D<=4, C<=4
      priority 2
  cheapest(x) "Cue bid: 13+, forcing to game"
      alert  artificial
      shows  hcp+length_points>=13
      sets   forcing=game
      when   !(leb | rub) | cheapest_rank(x) > 18
  4S  "Game: four or more spades, 11+"
      shows S>=4, S>=H, hcp+length_points=11..12
      when  x is not S
  4H  "Game: four or more hearts, 11+"
      shows H>=4, H>S, hcp+length_points=11..12
      when  x is not H
  jump(S) "Invitational: five or more spades, 8-10"
      shows S>=5, S>=H, hcp+length_points=8..10
      when  x is not S, cheapest_rank(S) <= 13     # a jump to three, not to game
  jump(H) "Invitational: five or more hearts, 8-10"
      shows H>=5, H>S, hcp+length_points=8..10
      when  x is not H, cheapest_rank(H) <= 13
  cheapest(N) "11-12 with {x} stopped"
      shows hcp+length_points=11..12, S<=3 | x is S, H<=3 | x is H
      when  stop(x), cheapest_rank(x) < 14, !(leb | rub) | cheapest_rank(x) > 18
      sets  ask=nt_invite
  3N  "Game with {x} stopped, no four-card major"
      shows hcp+length_points>=13 | (hcp+length_points>=11, cheapest_rank(x) >= 14), S<=3 | x is S, H<=3 | x is H
      when  stop(x), !(leb | rub) | cheapest_rank(x) > 18
  cheapest(S) "Four or more spades, 0-10"
      shows S>=4, S>=H, hcp+length_points<=10
      when  x is not S, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(S) <= 13
  cheapest(H) "Four or more hearts, 0-10"
      shows H>=4, H>S, hcp+length_points<=10
      when  x is not H, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(H) <= 13
  cheapest(D) "Four or more diamonds, 0-10, no four-card major"
      shows D>=4, D>=C, hcp+length_points<=10, S<=3 | x is S, H<=3 | x is H
      when  x is not D, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(D) <= 13
  cheapest(C) "Four or more clubs, 0-10, no four-card major"
      shows C>=4, C>D | x is D, hcp+length_points<=10, S<=3 | x is S, H<=3 | x is H
      when  x is not C, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(C) <= 13
  # Nothing fits: the longest suit that is not theirs, cheapest first.
  cheapest(S) "Our best suit: spades"   when x is not S, S>=H, S>=D, S>=C, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(S) <= 13
      priority -5
  cheapest(H) "Our best suit: hearts"   when x is not H, H>=D, H>=C, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(H) <= 13
      priority -5
  cheapest(D) "Our best suit: diamonds" when x is not D, D>=C, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(D) <= 13
      priority -6
  cheapest(C) "Our best suit: clubs"    when x is not C, !(leb | rub) | cheapest_rank(x) > 18 | cheapest_rank(C) <= 13
      priority -7

# ── The doubler's rebid ──────────────────────────────────────────────
# A pass denies the power double (17+ HCP); the strong hand raises,
# shows its own suit, or bids notrump.
after (2x) X (P) 2y (P) | (2x) X (P) 3y (P) | (3x) X (P) 3y (P) | (3x) X (P) 4y (P) | (2x) P (P) X (P) 2y (P) | (2x) P (P) X (P) 3y (P) when y is not x, x is not C
  P   "Minimum double: partner has chosen"          shows hcp<=16
      priority -5
  4{y} "17+ with four: game in partner's major"      shows y>=4, hcp>=17
      when  y is H | y is S
  cheapest(y) "17+ with four: raise"                 shows y>=4, hcp>=17
      priority -1
  3N  "18+ with {x} stopped"                         shows hcp>=18, stop(x)
  cheapest(S) "17+ and five or more spades"          shows S>=5, hcp>=17
      when  x is not S, y is not S
  cheapest(H) "17+ and five or more hearts"          shows H>=5, S<=4, hcp>=17
      when  x is not H, y is not H
after (2x) X (P) 2N (P) when x is not C, !leb, !rub
  3N  "Accepts the invitation: 14+"                  shows hcp>=14
  P   "Declines"                                     shows hcp<=13
      priority -5

# ── Lebensohl after our double of their weak two ─────────────────────
# `competitive.lebensohl_weak_twos.play` (the 21GF cards). Bridge Bum,
# "Lebensohl over weak two bids"; Larry Cohen, "Lebensohl". Advancer:
#
# - a new suit at the two level: natural, weak (the rules above);
# - 2NT: a relay to 3C, with a weak hand that must bid at the three
#   level (pass or correct), or game values with their suit stopped
#   ("slow shows": then the cue bid or 3NT);
# - a new suit at the three level directly: constructive, 8-11;
# - the cue bid directly: game values, four of an unbid major, no stopper;
# - 3NT directly: game values, no stopper, no four-card major;
# - jumps to three of a major (invitational) and to game: as before.
#
# The natural replies above step aside at the three level when this is
# on (their `!leb` clauses); over a three-level preempt nothing changes.
# Tried 2026-09-27 and reverted on par; built again from the card
# 2026-10-05 (vs-preempts.notes.md).
after (2x) X (P) | (2x) P (P) X (P) when x is not C, leb, !rub
  2N  "Lebensohl: relay to 3C (weak, to play at three; or game values with {x} stopped)"
      alert  artificial
      shows  (hcp<=8, C>=4 | (D>=4, x is H | x is S) | (H>=4, x is S), S<=3 | x is S | cheapest_rank(S) >= 15, H<=3 | x is H | cheapest_rank(H) >= 15) | (hcp>=13, stop(x), S<=4 | x is S, H<=4 | x is H)
      sets   ask=leb_relay
      priority 1
  cheapest(x) "Cue bid: game values, four of an unbid major, no stopper in {x}"
      alert  artificial
      shows  hcp>=13, (S=4, x is not S) | (H=4, x is not H), S<=4 | x is S, H<=4 | x is H
      when   !stop(x)
      sets   forcing=game, ask=leb_cue
      priority 1
  3N  "Game values, no four-card major, no stopper in {x}"
      shows hcp>=13, S<=3 | x is S, H<=3 | x is H
      when  !stop(x)
      priority 1
  cheapest(S) "Constructive: four or more spades, 9-12"
      shows S>=4, S>=H, hcp=9..12
      when  x is not S, cheapest_rank(S) >= 15
      priority 1
  cheapest(H) "Constructive: four or more hearts, 9-12"
      shows H>=4, H>S, hcp=9..12
      when  x is not H, cheapest_rank(H) >= 15
      priority 1
  cheapest(D) "Constructive: four or more diamonds, 9-12"
      shows D>=4, D>=C, hcp=9..12, S<=3 | x is S, H<=3 | x is H
      when  x is not D, cheapest_rank(D) >= 15
      priority 1
  cheapest(C) "Constructive: four or more clubs, 9-12"
      shows C>=4, C>D | x is D, hcp=9..12, S<=3 | x is S, H<=3 | x is H
      when  x is not C, cheapest_rank(C) >= 15
      priority 1
  # A five-card unbid major and game values: bid the game (BBA too).
  4S  "Game: five or more spades"
      shows S>=5, S>=H, hcp+length_points>=11
      when  x is not S
      priority 1
  4H  "Game: five or more hearts"
      shows H>=5, H>S, hcp+length_points>=11
      when  x is not H
      priority 1
  # Five of their suit and a weak hand: nowhere to go, pass (BBA).
  P   "Five or more {x}: nothing to say"
      shows x>=5, hcp<=8
      priority 1
  # Nothing else fits: the relay, then the best of what is left.
  2N  "Lebensohl: relay to 3C"
      alert  artificial
      sets   ask=leb_relay
      priority -8

# The doubler: 3C as asked; with 19+ and their suit stopped, 3NT.
after (2x) X (P) 2N (P) | (2x) P (P) X (P) 2N (P) when x is not C, leb, !rub
  3N  "19+ with {x} stopped: no clubs partscore"    shows hcp>=19, stop(x)
      priority 2
  3C  "Lebensohl: as asked"
      alert  artificial
      priority 1

# Advancer after the relay.
after (2x) X (P) 2N (P) 3C (P) | (2x) P (P) X (P) 2N (P) 3C (P) when x is not C, leb, !rub
  P   "Weak, clubs"                                  shows C>=4, hcp<=8
      priority 1
  cheapest(D) "Weak, diamonds: to play"              shows D>=4, D>C, hcp<=8
      when  x is not D
      priority 1
  cheapest(H) "Weak, hearts: to play"                shows H>=4, H>D, H>C, hcp<=8
      when  x is S
      priority 1
  cheapest(x) "Slow cue: game values, four of an unbid major, {x} stopped"
      alert  artificial
      shows  hcp>=13, stop(x), (S=4, x is not S) | (H=4, x is not H)
      sets   forcing=game, ask=leb_cue
      priority 1
  3N  "Slow 3NT: game values with {x} stopped, no four-card major"
      shows hcp>=13, stop(x)
      priority 1
  P   "Weak: clubs will do"                          priority -10

# The doubler answers either cue bid: an unbid four-card major, else
# 3NT, else his longer minor.
after (2x) X (P) 3x (P) | (2x) P (P) X (P) 3x (P) | (2x) X (P) 2N (P) 3C (P) 3x (P) | (2x) P (P) X (P) 2N (P) 3C (P) 3x (P) when x is not C, leb, !rub
  cheapest(H) "Four hearts"                          shows H>=4
      when  x is not H
      priority 2
  cheapest(S) "Four spades"                          shows S>=4
      when  x is not S
      priority 2
  3N  "No four-card major"                           priority 1
  cheapest(D) "No major, no stopper: diamonds"       shows D>=4, D>=C
      when  x is not D
      priority -1

# ── Advancer after our overcall of their weak two ────────────────────
after (2x) 2y (P) | (2x) 3y (P) | (3x) 3y (P) | (3x) 4y (P) | (2x) P (P) 2y (P) | (2x) P (P) 3y (P) when y is not x, x is not C
  4{y} "Game: three-card support, 12+"               shows y>=3, hcp+length_points>=12
      when  y is H | y is S
  cheapest(y) "Raise: three-card support, 8-11"      shows y>=3, hcp+length_points=8..11
  3N  "Game: 12+ with {x} stopped"                   shows hcp+length_points>=12, stop(x), y<=2
  P   "Nothing to add"                               priority -10

# ── Advancer after our 2NT (15-17) ───────────────────────────────────
after (2x) 2N (P) when x is not C
  3N  "Game: 9+"                                     shows hcp>=9, S<=5, H<=5
  4S  "Game: six or more spades, 8+"                 shows S>=6, hcp>=8
      when  x is not S
  4H  "Game: six or more hearts, 8+"                 shows H>=6, hcp>=8
      when  x is not H
  P   "No game"                                      shows hcp<=8
      priority -10

# ── Their side after our action over the weak two ───────────────────
# The weak-two responses assume a pass on the right. Over our double or
# overcall the responder competes with a fit (total-tricks.bid) or
# passes; the opener has described his hand.
after 2x (X) | 2x (2y) | 2x (3y) | 2x (2N) | 3x (X) | 3x (3y) | 3x (4y) | 3x (3N) | 4x (X) | 4x (4y) | 4x (5y) when x is not N
  P   "They came in: nothing to add"                 priority -10
after 2x (X) P (*) | 2x (2y) P (*) | 2x (3y) P (*) | 2x (2N) P (*) | 3x (X) P (*) | 3x (3y) P (*) | 3x (4y) P (*) | 4x (X) P (*) | 4x (4y) P (*) | 4x (5y) P (*) when x is not N
  P   "Partner passed: the preempt said it all"      priority -10

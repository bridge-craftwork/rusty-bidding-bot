# Penalty doubles by judgment (docs/JUDGMENT-LAYER.md, Phase 3).
#
# Draft: see penalty-doubles.notes.md.

module penalty-doubles "Penalty doubles: they are too high"
  needs  base

# The contract is theirs and undoubled: RHO has just bid (direct), or LHO
# bid and both partner and RHO have passed since (passed round to me).
define direct = !rho.last=P, !rho.last=X, !rho.last=XX
define passed_round = rho.last=P, partner.last=P, !lho.last=P, !lho.last=X, !lho.last=XX

# Their suit, natural, and not one we have shown (a bid in our suit is a
# cue bid; Stayman, a strong 2C or a transfer shows no length in the suit).
define natural_theirs(x) = they.strain is x, they.fit(x).min>=4, partner.x.min<=2, shown.x.min<=2

# Where they will play: passed round to me, or a fit found, or game.
# Directly over a new suit the auction may be forcing.
define settled(x) = passed_round | they.fit(x).min>=7 | they.game_reached

# Rick's penalty-double standard (2026-09-23): four or more with two of
# the top three, or three of the top five.
define good_trumps(x) = x>=4, quality(x)>=good | top5(x)>=3

# They have bid game and I hold 17 or more: they have 23 at most between
# them, whatever partner's silence hides (2026-10-02; 18 doubles fewer
# contracts that make but gains less, notes).
define big_hand_vs_game = they.game_reached, hcp>=17

# What I hold in their suit against what we have shown between us
# (we.hcp.min: my HCP and the bottom of partner's range). Good four at
# 17 and any four at 20 since partner's floor is known more often
# (2026-10-03, after PRs #44/#45; notes, "Retuned on the higher floors").
define pen_suit(x) = (good_trumps(x), we.hcp.min>=17) | (x>=4, we.hcp.min>=20) | (x>=3, we.hcp.min>=21) | we.hcp.min>=22 | big_hand_vs_game

# Responder's first call over their overcall: the double is negative.
define responder_first = partner.opened, me.bids=0, !passed_hand, !me.last=X, !me.last=XX

# Partner need not have shown values: with 22 known in my own hand (or
# 17-21 with their trumps) the double stands alone. A condition that
# partner had shown 4+ was a par artefact: it lost on the errors
# yardstick on all three sets (penalty-doubles.notes.md, 2026-10-01).

# Not over partner's notrump opening (one bid, a range of four points or
# less): they came in with shape against a balanced hand, and the double
# lost (21GF random set, 2026-10-01).
define partner_nt = partner.opened, partner.bids=1, partner.hcp.min>=12, partner.hcp.max - partner.hcp.min <= 3

define pen_spot(x) = natural_theirs(x), settled(x), !partner_nt

when they.bid, direct | passed_round, !asked, they.level>=2, !responder_first
  X   "Penalty: they are too high in spades"
      shows pen_suit(S)
      when  pen_spot(S)
      sets  ask=penalty
      priority -6
  X   "Penalty: they are too high in hearts"
      shows pen_suit(H)
      when  pen_spot(H)
      sets  ask=penalty
      priority -6
  X   "Penalty: they are too high in diamonds"
      shows pen_suit(D)
      when  pen_spot(D)
      sets  ask=penalty
      priority -6
  X   "Penalty: they are too high in clubs"
      shows pen_suit(C)
      when  pen_spot(C)
      sets  ask=penalty
      priority -6

# Their notrump after they have both bid (not an opening 1NT or 2NT,
# which vs-1nt.bid and the defences answer).
when they.bid, passed_round | (direct, they.game_reached), !asked, !responder_first, they.strain is N, lho.bids + rho.bids >= 2
  X   "Penalty: they are too high in notrump"
      shows we.hcp.min>=21 | big_hand_vs_game
      sets  ask=penalty
      priority -6

# They bid over our game: the side that bid game owns the hand, so the
# player with values (12+ in my hand, or 20 known between us) and two of
# their trumps doubles (2026-10-02). After partner's signoff too: the
# signoff's "nothing to add" pass (rebids.bid, priority -5) would
# otherwise sell out, so this double sits at -5.
define our_game_bid = me.last=3N | me.last=4H | me.last=4S | me.last=5C | me.last=5D | me.last=5H | me.last=5S | partner.last=3N | partner.last=4H | partner.last=4S | partner.last=5C | partner.last=5D | partner.last=5H | partner.last=5S
define over_our_game(x) = x>=2, hcp>=12 | we.hcp.min>=20

when they.bid, direct | passed_round, !asked | asked signoff, our_game_bid, they.level>=4, they.strain is not N
  X   "Penalty: they bid spades over our game"
      shows over_our_game(S)
      when  natural_theirs(S), !partner_nt
      sets  ask=penalty
      priority -5
  X   "Penalty: they bid hearts over our game"
      shows over_our_game(H)
      when  natural_theirs(H), !partner_nt
      sets  ask=penalty
      priority -5
  X   "Penalty: they bid diamonds over our game"
      shows over_our_game(D)
      when  natural_theirs(D), !partner_nt
      sets  ask=penalty
      priority -5
  X   "Penalty: they bid clubs over our game"
      shows over_our_game(C)
      when  natural_theirs(C), !partner_nt
      sets  ask=penalty
      priority -5

when asked penalty
  P   "Sitting for partner's penalty double"  priority -1

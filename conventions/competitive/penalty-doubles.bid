# Penalty doubles by judgment (docs/JUDGMENT-LAYER.md, Phase 3).
#
# Draft: see penalty-doubles.notes.md.

module penalty-doubles "Penalty doubles: they are too high"
  needs  base

# The contract is theirs and undoubled: RHO has just bid (direct), or LHO
# bid and both partner and RHO have passed since (passed round to me).
define direct = !rho.last=P, !rho.last=X, !rho.last=XX
define passed_round = rho.last=P, partner.last=P, !lho.last=P, !lho.last=X, !lho.last=XX

# Their suit, natural, and not one we have shown (a bid in our suit is a
# cue bid; Stayman, a strong 2C or a transfer shows no length in the suit).
define natural_theirs(x) = they.strain is x, they.fit(x).min>=4, partner.x.min<=2, shown.x.min<=2

# Where they will play: passed round to me, or a fit found, or game.
# Directly over a new suit the auction may be forcing.
define settled(x) = passed_round | they.fit(x).min>=7 | they.game_reached

# Rick's penalty-double standard (2026-09-23): four or more with two of
# the top three, or three of the top five.
define good_trumps(x) = x>=4, quality(x)>=good | top5(x)>=3

# They have bid game and I hold 17 or more: they have 23 at most between
# them, whatever partner's silence hides (2026-10-02; 18 doubles fewer
# contracts that make but gains less, notes).
define big_hand_vs_game = they.game_reached, hcp>=17

# What I hold in their suit against what we have shown between us
# (we.hcp.min: my HCP and the bottom of partner's range). Good four at
# 17 and any four at 20 since partner's floor is known more often
# (2026-10-03, after PRs #44/#45; notes, "Retuned on the higher floors").
# The big hand doubles their game on strength, but not short in their
# suit (a void or a singleton) with six or more of its own: that hand
# declares (vs-preempts.bid; Brill daily 2026-10-14 board 4, 5D doubled
# with a void and six hearts made, 6H on; 2026-10-15). A void and five
# still doubles (2026-10-14 board 7, 4S doubled went down). The
# takeout doubler keeps the old count: his pass of their game still
# denies 17+ (else the advancer loses the shape the double showed).
define pen_suit(x) = (good_trumps(x), we.hcp.min>=17) | (x>=4, we.hcp.min>=20) | (x>=3, we.hcp.min>=21) | we.hcp.min>=22 | (big_hand_vs_game, x>=2 | longest<=5 | me.last=X)

# Responder's first call over their overcall: the double is negative.
define responder_first = partner.opened, me.bids=0, !passed_hand, !me.last=X, !me.last=XX

# Partner need not have shown values: with 22 known in my own hand (or
# 17-21 with their trumps) the double stands alone. A condition that
# partner had shown 4+ was a par artefact: it lost on the errors
# yardstick on all three sets (penalty-doubles.notes.md, 2026-10-01).

# Not over partner's notrump opening (one bid, a range of four points or
# less): they came in with shape against a balanced hand, and the double
# lost (21GF random set, 2026-10-01).
define partner_nt = partner.opened, partner.bids=1, partner.hcp.min>=12, partner.hcp.max - partner.hcp.min <= 3

define pen_spot(x) = natural_theirs(x), settled(x), !partner_nt

when they.bid, direct | passed_round, !asked, they.level>=2, !responder_first
  X   "Penalty double of their spades"
      shows pen_suit(S)
      when  pen_spot(S)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their hearts"
      shows pen_suit(H)
      when  pen_spot(H)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their diamonds"
      shows pen_suit(D)
      when  pen_spot(D)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their clubs"
      shows pen_suit(C)
      when  pen_spot(C)
      sets  ask=penalty
      priority -6

# Their notrump after they have both bid (not an opening 1NT or 2NT,
# which vs-1nt.bid and the defences answer).
when they.bid, passed_round | (direct, they.game_reached), !asked, !responder_first, they.strain is N, lho.bids + rho.bids >= 2
  X   "Penalty double of their notrump"
      shows we.hcp.min>=21 | big_hand_vs_game
      sets  ask=penalty
      priority -6

# They bid over our game: the side that bid game owns the hand, so the
# player with values (12+ in my hand, or 20 known between us) and two of
# their trumps doubles (2026-10-02). After partner's signoff too: the
# signoff's "nothing to add" pass (rebids.bid, priority -5) would
# otherwise sell out, so this double sits at -5.
define our_game_bid = me.last=3N | me.last=4H | me.last=4S | me.last=5C | me.last=5D | me.last=5H | me.last=5S | partner.last=3N | partner.last=4H | partner.last=4S | partner.last=5C | partner.last=5D | partner.last=5H | partner.last=5S
define over_our_game(x) = x>=2, hcp>=12 | we.hcp.min>=20

when they.bid, direct | passed_round, !asked | asked signoff, our_game_bid, they.level>=4, they.strain is not N
  X   "Penalty double of their spades"
      shows over_our_game(S)
      when  natural_theirs(S), !partner_nt
      sets  ask=penalty
      priority -5
  X   "Penalty double of their hearts"
      shows over_our_game(H)
      when  natural_theirs(H), !partner_nt
      sets  ask=penalty
      priority -5
  X   "Penalty double of their diamonds"
      shows over_our_game(D)
      when  natural_theirs(D), !partner_nt
      sets  ask=penalty
      priority -5
  X   "Penalty double of their clubs"
      shows over_our_game(C)
      when  natural_theirs(C), !partner_nt
      sets  ask=penalty
      priority -5

# They ran from our redouble or from partner's penalty double
# (2026-10-09): the redouble said we hold the balance (10+ opposite an
# opening), a penalty double the same, and what they bid now is a
# rescue, not forcing. The hand behind the rescuer doubles it with four
# or more of their suit (penalty-doubles.notes.md, "Doubling errors
# after the convention batches").
# The redouble is mine, of their takeout double of partner's opening
# (not a support, SOS or McCabe redouble: those show a holding), and
# the doubler has run from it, directly in front of me. Opener's double
# of the advance (1x X XX 1y/2y X) and mine of a forced one-level
# advance passed round to me lost on the random sets: left out.
define we_redoubled = me.last=XX, partner.opened, me.bids=0, partner.hcp.min>=10, direct
define they_ran = we_redoubled | asked nt_penalty | asked penalty
# After partner's penalty double of their suit, a run is a new suit:
# the runner's partner has not bid it. A raise of the doubled suit is
# not a rescue (Brill daily 2026-10-08 board 2: 1NT 2D 2H (X) 4H,
# doubled on T764 and made; 2026-10-15). After our redouble or a
# penalty double of their notrump every bid of theirs is a run (the
# doubler's side raising the rescue included).
define ran_to(x) = !(asked penalty) | (direct, !lho.named(x)) | (passed_round, !rho.named(x))
define ran_into(x) = x>=4

when they.bid, direct | passed_round, they_ran
  X   "Penalty: four or more spades"
      shows ran_into(S)
      when  natural_theirs(S), ran_to(S)
      sets  ask=penalty
      priority 0
  X   "Penalty: four or more hearts"
      shows ran_into(H)
      when  natural_theirs(H), ran_to(H)
      sets  ask=penalty
      priority 0
  X   "Penalty: four or more diamonds"
      shows ran_into(D)
      when  natural_theirs(D), ran_to(D)
      sets  ask=penalty
      priority 0
  X   "Penalty: four or more clubs"
      shows ran_into(C)
      when  natural_theirs(C), ran_to(C)
      sets  ask=penalty
      priority 0

# Partner preempted (a weak two or a three-level opening) and they
# overcalled: partner's hand is described and has little defence, so my
# double is for penalty (Berkowitz-Cohen, low-level doubles: penalty
# "after 2♦, 2M openings"), on my own strength and their trumps
# (2026-10-09, notes).
define partner_preempted = partner.opened, partner.bids=1, partner.hcp.max<=11
define vs_overcall_of_preempt(x) = (x>=2, hcp>=15) | (x>=4, hcp>=12) | (x>=3, hcp>=12, quality(x)>=good | top5(x)>=3) | (x>=5, hcp>=9)

when they.bid, direct | passed_round, !asked, partner_preempted, me.bids=0
  X   "Penalty double of their spades"
      shows vs_overcall_of_preempt(S)
      when  natural_theirs(S)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their hearts"
      shows vs_overcall_of_preempt(H)
      when  natural_theirs(H)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their diamonds"
      shows vs_overcall_of_preempt(D)
      when  natural_theirs(D)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their clubs"
      shows vs_overcall_of_preempt(C)
      when  natural_theirs(C)
      sets  ask=penalty
      priority -6

# Their one-level overcall after we have both bid, passed round to me:
# opener's pass denied a fit and extras, so the hand is a misfit for
# them and ours on strength; the double is for penalty (2026-10-09,
# notes).
define one_level_pen(x) = (x>=3, we.hcp.min>=19) | (x>=2, we.hcp.min>=22)

when they.bid, passed_round, !asked, they.level=1, me.has_bid, partner.has_bid
  X   "Penalty double of their spades"
      shows one_level_pen(S)
      when  natural_theirs(S)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their hearts"
      shows one_level_pen(H)
      when  natural_theirs(H)
      sets  ask=penalty
      priority -6
  X   "Penalty double of their diamonds"
      shows one_level_pen(D)
      when  natural_theirs(D)
      sets  ask=penalty
      priority -6

# Partner sits when RHO passed; when they run, the double of the
# runout above answers it (2026-10-09).
when asked penalty, rho.last=P
  P   "Leaves the double in"  priority -1

# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Responder's call when RHO has overcalled or doubled partner's one-level
# opening (Rick, 2026-09-22): negative doubles through 3S, and natural
# bids otherwise.
#
# The uncontested rules in responses.bid are written as `after 1x (P)`
# patterns, so none of them fire once the opponents come in; everything
# responder needs over interference is here.
#
# Negative double: 6+ total points with four or more cards in each unbid
# major, so a suit bid in the only unbid major promises five. Where both
# majors are bid (1H-(1S)) the double shows the minors instead.
#
# Opener's answer to the negative double is written once with relative
# calls, so it is right at every level they push us to, and there is a
# separate block for the auctions where they compete over the double.
#
# Not written yet: their 1NT overcall, jump shifts, opener's rebid after
# anything but a negative double, and responder's second call once the
# auction has been contested.

module after-interference "Our side once the opponents come in"
  needs  base
  param  neg = doubles.negative.play default true
  param  cue_raise = competitive.cue_bid_raise.play default true
  param  new_suit_forcing = competitive.new_suit_after_overcall_forcing default true

# ── They overcalled at the one level ─────────────────────────────────
after 1x (1y) when neg
  X   "Negative double: 6+ total points, four or more in each unbid major"
      alert  artificial
      shows  hcp+length_points>=6
      shows  (S>=4 | x is S | y is S), (H>=4 | x is H | y is H)
      shows  ((D>=4 | x is D | y is D), (C>=4 | x is C | y is C)) | S>=4 | H>=4
      when   (S<=4 | x is S | y is S), (H<=4 | x is H | y is H)
      priority 1

after 1x (1y)
  1S  "6+ total points, four or more spades"
      shows S>=4, hcp+length_points>=6
      when  x is not S, y is not S
      when  S>=5 | (x is not H, y is not H, H<=3)
  1H  "6+ total points, four or more hearts"
      shows H>=4, hcp+length_points>=6
      when  x is not H, y is not H, y is not S
      when  H>=5 | (x is not S, y is not S, S<=3)
  1N  "6-10 total points, balanced, a stopper in {y}"
      shows balanced, hcp+length_points>=6, hcp+length_points<=10
      when  stop(y)
      when  (S<=3 | x is S | y is S), (H<=3 | x is H | y is H)
  2{x} "Raise: 6-9 total points, support for partner's suit"
      shows x>=3, hcp+length_points>=6, hcp+length_points<=9
      when  x is H | x is S | x>=5
      when  (S<=3 | x is S | y is S), (H<=3 | x is H | y is H)
  cheapest(C) "8+ total points, five or more clubs"
      shows C>=5, hcp+length_points>=8
      when  x is not C, y is not C
  cheapest(D) "8+ total points, five or more diamonds"
      shows D>=5, hcp+length_points>=8
      when  x is not D, y is not D
  2H  "8+ total points, five or more hearts"
      shows H>=5, hcp+length_points>=8
      when  y is S, x is not H
  P   "Nothing to say over the overcall"  priority -10

# ── They overcalled at the two level or jumped ───────────────────────
# Rick: over a two-level overcall a new suit is 10+ total points with five
# cards and forcing, and the negative double is 8+ with four. At the three
# level the free bid needs another point.
after 1x (2y) | 1x (3y) when y is not x
  X   "Negative double: 8+ total points, four or more in each unbid major"
      alert  artificial
      shows  hcp+length_points>=8
      shows  (S>=4 | x is S | y is S), (H>=4 | x is H | y is H)
      shows  ((D>=4 | x is D | y is D), (C>=4 | x is C | y is C)) | S>=4 | H>=4
      when   (S<=4 | x is S | y is S), (H<=4 | x is H | y is H)
      when   neg
      priority 1
  cheapest(y) "Cue bid: limit raise or better in {x}"
      alert  artificial
      shows  x>=3, hcp+length_points>=11
      when   cue_raise
      sets   forcing=round
      priority 1
  cheapest(x) "Raise: 7-10 total points, three-card support"
      shows x>=3, hcp+length_points>=7, hcp+length_points<=10
  cheapest(S) "10+ total points, five or more spades"
      shows S>=5, hcp+length_points>=10
      when  x is not S, y is not S, new_suit_forcing
      sets  forcing=round
  cheapest(H) "10+ total points, five or more hearts"
      shows H>=5, S<=4, hcp+length_points>=10
      when  x is not H, y is not H, new_suit_forcing
      sets  forcing=round
  cheapest(D) "10+ total points, five or more diamonds"
      shows D>=5, S<=4, H<=4, hcp+length_points>=10
      when  x is not D, y is not D, new_suit_forcing
      sets  forcing=round
  cheapest(C) "10+ total points, five or more clubs"
      shows C>=5, S<=4, H<=4, hcp+length_points>=10
      when  x is not C, y is not C, new_suit_forcing
      sets  forcing=round

# The same bids where the card says a new suit is not forcing
# (Basic-Bridge sets `1X-(Y)-2Z forcing` off). Only the force differs.
after 1x (2y) | 1x (3y) when y is not x, !new_suit_forcing
  cheapest(S) "10+ total points, five or more spades, not forcing"
      shows S>=5, hcp+length_points>=10
      when  x is not S, y is not S
  cheapest(H) "10+ total points, five or more hearts, not forcing"
      shows H>=5, S<=4, hcp+length_points>=10
      when  x is not H, y is not H
  cheapest(D) "10+ total points, five or more diamonds, not forcing"
      shows D>=5, S<=4, H<=4, hcp+length_points>=10
      when  x is not D, y is not D
  cheapest(C) "10+ total points, five or more clubs, not forcing"
      shows C>=5, S<=4, H<=4, hcp+length_points>=10
      when  x is not C, y is not C

after 1x (2y) | 1x (3y) when y is not x
  2N  "11-12 total points, balanced, a stopper in {y}"
      shows balanced, hcp+length_points>=11, hcp+length_points<=12
      when  stop(y)
  3N  "13+ total points, balanced, a stopper in {y}"
      shows balanced, hcp+length_points>=13
      when  stop(y)
  P   "Nothing to say over their overcall"  priority -10

# ── They doubled for takeout ─────────────────────────────────────────
# Redouble shows the balance of the strength; everything else is what it
# would have been, a level lower in ambition.
after 1x (X)
  XX  "Redouble: 10+ total points, we own the hand"
      alert  artificial
      shows hcp+length_points>=10
      priority 1
  cheapest(S) "6-9 total points, four or more spades"
      shows S>=4, S>H, hcp+length_points>=6, hcp+length_points<=9
      when  x is not S
  cheapest(H) "6-9 total points, four or more hearts"
      shows H>=4, H>=S, hcp+length_points>=6, hcp+length_points<=9
      when  x is not H, x is not S
  cheapest(D) "6-9 total points, four or more diamonds"
      shows D>=4, S<=3, H<=3, hcp+length_points>=6, hcp+length_points<=9
      when  x is not D, x is not H, x is not S
  2{x} "Raise: 4-9 total points, support for partner's suit"
      shows x>=3, hcp+length_points>=4, hcp+length_points<=9
      when  x is H | x is S | x>=5
      when  (S<=3 | x is S), (H<=3 | x is H)
  3{x} "Preemptive raise: five-card support for a major, less than 8"
      shows x>=5, hcp+length_points<=7
      when  x is H | x is S
  1N  "6-9 total points, balanced"
      shows balanced, hcp+length_points>=6, hcp+length_points<=9
      when  (S<=3 | x is S), (H<=3 | x is H)
      when  x<=2 | x is C | x is D
  P   "Nothing to say over the double"  priority -10

# ── Opener answers a negative double ─────────────────────────────────
# Partner has shown four or more cards in each unbid major and 6+ total
# points (8+ over a two-level overcall), so opener names the major he
# has, bids notrump with a stopper, or rebids his own suit. A negative
# double is forcing: opener always bids something, and jumps with 16-18.
# Relative calls keep one set of rules right at every level.
after 1x (1y) X (P) | 1x (2y) X (P) | 1x (3y) X (P)
  cheapest(S) "Four spades for partner's double, minimum"
      shows S>=4, hcp<=15
      when  x is not S, y is not S
  cheapest(H) "Four hearts for partner's double, minimum"
      shows H>=4, hcp<=15
      when  x is not H, y is not H
  jump(S) "Four spades, 16-18"
      shows S>=4, hcp=16..18
      when  x is not S, y is not S
  jump(H) "Four hearts, 16-18"
      shows H>=4, hcp=16..18
      when  x is not H, y is not H
  cheapest(N) "12-14 balanced with a stopper in {y}"
      shows balanced, hcp<=14
      when  stop(y)
  jump(N) "18-19 balanced with a stopper in {y}"
      shows balanced, hcp=18..19
      when  stop(y)
  cheapest(x) "Six cards in {x}, minimum"
      shows x>=6, hcp<=15
  jump(x) "Six cards in {x}, 16-18"
      shows x>=6, hcp=16..18
  # Partner promised four, so three is an eight-card fit and BBA bids it:
  # `1D (1S) X (P) 2H` on KQ6.832.KT84.A64. Below the four-card bids and
  # the notrump rebid, above naming a minor.
  4S  "Four spades, 19+: game in the fit partner promised"
      shows S>=4, hcp>=19
      when  x is not S, y is not S
  4H  "Four hearts, 19+: game in the fit partner promised"
      shows H>=4, hcp>=19
      when  x is not H, y is not H
  # Where both majors are bid the double showed the minors, and where
  # opener has no major, no stopper and no six-card suit he still has to
  # bid. An unbid four-card minor comes before rebidding his own suit,
  # which is what BBA does: `1D (1S) X (P) 2C` on 754.AQ.AQ52.QT74.
  cheapest(D) "Four diamonds, minimum"
      shows D>=4, hcp<=15
      when  x is not D, y is not D
      when  (S<=3 | x is S | y is S), (H<=3 | x is H | y is H)
      priority -1
  cheapest(C) "Four clubs, minimum"
      shows C>=4, C>=D, hcp<=15
      when  x is not C, y is not C
      when  (S<=3 | x is S | y is S), (H<=3 | x is H | y is H)
      priority -1
  # Partner promised four, so three is an eight-card fit and BBA bids it
  # once it has nothing else: `1D (1S) X (P) 2H` on KQ6.832.KT84.A64.
  cheapest(S) "Three spades for partner's four, minimum"
      shows S>=3, hcp<=15
      when  x is not S, y is not S, partner.S>=4
      priority -2
  cheapest(H) "Three hearts for partner's four, minimum"
      shows H>=3, hcp<=15
      when  x is not H, y is not H, partner.H>=4
      priority -2
  cheapest(x) "Five cards in {x}"
      shows x>=5, hcp<=18
      priority -2
  cheapest(x) "Nothing better to say over partner's double"
      priority -5

# ── Opener answers the cue-bid raise ─────────────────────────────────
# The cue bid showed three-card support and 11+ total points, so opener
# accepts with more than a minimum and signs off otherwise.
after 1x (2y) 3y (P) | 1x (3y) 4y (P)
  4{x} "Accepts: game in {x}"
      shows hcp>=16
      when  x is H | x is S
  3N  "Accepts: 16+ with a stopper in {y}"
      shows balanced, hcp>=16
      when  stop(y), x is C | x is D
  cheapest(x) "No game opposite a limit raise"
      priority -1

# ── Opener when they compete over the negative double ────────────────
# They have bid again, so the double is no longer forcing and opener may
# pass. He still names a four-card major at the cheapest level, bids
# notrump with a stopper, or rebids a six-card suit with extras; with a
# minimum and nothing to say he lets them have it, which is what BBA
# does on most of these hands. Only where they have merely competed to
# the next level: over a jump by them BBA passes almost always, and we
# leave that to the pass below.
after 1x (1y) X (2z) | 1x (2y) X (3z) when y is not x
  cheapest(S) "Four spades, competing over their bid"
      shows S>=4, hcp<=15
      when  x is not S, y is not S
  cheapest(H) "Four hearts, competing over their bid"
      shows H>=4, hcp<=15
      when  x is not H, y is not H
  jump(S) "Four spades, 16-18"
      shows S>=4, hcp=16..18
      when  x is not S, y is not S
  jump(H) "Four hearts, 16-18"
      shows H>=4, hcp=16..18
      when  x is not H, y is not H
  cheapest(N) "12-15 balanced with a stopper in {y}"
      shows balanced, hcp<=15
      when  stop(y)
  jump(N) "18-19 balanced with a stopper in {y}"
      shows balanced, hcp=18..19
      when  stop(y)
  cheapest(x) "Six cards in {x} and the values to bid again"
      shows x>=6, hcp>=13
  P   "Minimum: they have bought it"  priority -10

# They jumped over the double. Most of these hands pass in the corpus,
# so opener only bids on with real extras: a four-card major for the one
# partner promised, or a stopper, and 13+ HCP to go with it.
after 1x (1y) X (3z) | 1x (1y) X (4z) | 1x (2y) X (4z) | 1x (3y) X (4z) when y is not x
  cheapest(S) "Four spades and 13+: worth competing over their jump"
      shows S>=4, hcp>=13
      when  x is not S, y is not S
  cheapest(H) "Four hearts and 13+: worth competing over their jump"
      shows H>=4, hcp>=13
      when  x is not H, y is not H
  cheapest(N) "13+ balanced with a stopper in {y}"
      shows balanced, hcp>=13
      when  stop(y)
  P   "They jumped over the double: no room to describe the hand"  priority -10

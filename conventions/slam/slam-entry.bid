# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Slam entry: the conditions the slam modules share, named once
# (docs/JUDGMENT-LAYER.md, Phase 0). rkcb-1430.bid, blackwood.bid and
# control-bids.bid used to spell each of them out, up to 1,300 characters
# a line. No rules yet: what decides whether slam is worth looking for
# (Phase 1) will live here, and the modules that ask keep deciding how.
#
# The thresholds are Rick's (rkcb-1430.bid, "The ask"; slam-catch.notes.md):
# 33 support points between us with the agreed suit as trump, or 18 of my
# own facing a game force; the control rulings are control-bids.bid's.

module slam-entry "Slam entry: the conditions the slam modules share"
  skill  partnership_bidding/slam_bidding
  param  style = slam.cue_bids.style default first_or_second_round
  param  bw    = slam.blackwood.standard default false
  param  k1430 = slam.blackwood.rkcb_1430 default false
  param  k0314 = slam.blackwood.rkcb_0314 default false

# ── The count: declarer points and support points (2026-10-01) ───────
#
# Rick (2026-10-01): "point count for any auction is normally declarer
# points for the hand with longer trumps, and support points for the
# other hand. With 4-4 fits both hands can use support points." The
# long-trump hand counts HCP + length (one a card beyond four, in every
# suit), not its own shortness; the short hand counts HCP + shortness
# (`tp(t)`, capped by its trumps). `we.tp(t)` counted shortness in both
# hands, which double counts.
#
# Trump lengths are compared with what partner has shown (`partner.t.min`):
# longer than that, I am the long hand; shorter, partner is; equal, both
# count support points (4-4, 5-5). A raiser shows the length he raised
# with, so the raiser is the support hand unless I hold no more trumps.

define longer(t)  = t > partner.t.min
define shorter(t) = t < partner.t.min

# The count on partner's floor, by role. Partner as the long hand counts
# his shown points (HCP + length), or his HCP and the length he has shown
# when no call showed points: either is a floor.
define count_long(t)    = hcp + length_points + partner.tp(t).min
define count_short(t)   = tp(t) + partner.points.min
define count_short_l(t) = tp(t) + partner.hcp.min + partner.length_points.min
define count_equal(t)   = tp(t) + partner.tp(t).min

# The same on partner's maximum.
define count_long_max(t)  = hcp + length_points + partner.tp(t).max
define count_short_max(t) = tp(t) + partner.points.max
define count_equal_max(t) = tp(t) + partner.tp(t).max

# ── Values ────────────────────────────────────────────────────────────

# Facing a game force: 32 on partner's floor, or 18 of my own. Partner's
# floor understates him, so one point under the textbook 33 (calibrated
# 2026-09-30 on random deals and the corpus: slam-entry.notes.md).
define slam_values = we.tp(trump).min >= 32 | tp(trump) >= 18

# Facing a limited hand (a raise with a top): 33 on partner's maximum,
# and a hand of four losers or fewer.
define slam_values_limited = we.tp(trump).max >= 33, losers <= 4

# ── Controls ──────────────────────────────────────────────────────────

# A control in x: the ace or a void, or with `first_or_second_round` the
# king or a singleton. Shortness counts only when partner has not shown
# four of x (a singleton in partner's suit is not a control).
define controlled(x) = has(A,x) | (x<=0, partner.x.min<=3) | (style is first_or_second_round, has(K,x) | (x<=1, partner.x.min<=3))

# First-round control only: past game.
define first_round(x) = has(A,x) | (x<=0, partner.x.min<=3)

# A side suit I cannot control on my own: what sends a hand to control
# bids rather than straight to the keycard ask.
define side_suit_uncontrolled = (trump is not C, !controlled(C)) | (trump is not D, !controlled(D)) | (trump is not H, !controlled(H)) | (trump is not S, !controlled(S))

# Rick's rule for the ask: no two bare side suits (2+ cards, neither the
# ace nor the king).
define two_bare_suits = (bare(C), bare(D)) | (bare(C), bare(H)) | (bare(C), bare(S)) | (bare(D), bare(H)) | (bare(D), bare(S)) | (bare(H), bare(S))

# Going on in the dialogue promises every suit partner denied: it is the
# trump suit, partner did not skip it, or I control it.
define promised(x) = trump is x | !partner.denied(x) | controlled(x)
define denials_promised = promised(C), promised(D), promised(H), promised(S)

# The same past game, with first-round controls.
define promised_first(x) = trump is x | !partner.denied(x) | first_round(x)
define denials_promised_first = promised_first(C), promised_first(D), promised_first(H), promised_first(S)

# Every side suit covered for the keycard ask: my control, one partner
# has cued, or one I denied that partner has promised by bidding on.
define covered(x) = trump is x | controlled(x) | partner.cued(x) | me.denied(x)
define all_covered = covered(C), covered(D), covered(H), covered(S)

# The same when I opened the dialogue (partner answered me): my control
# or partner's.
define covered_by_us(x) = trump is x | controlled(x) | partner.cued(x)
define all_covered_by_us = covered_by_us(C), covered_by_us(D), covered_by_us(H), covered_by_us(S)

# ── A fit known but not agreed (Phase 1, 2026-09-30) ─────────────────

# A suit both hands know we fit: eight cards shown between us, or
# partner's own six-card suit. Public, so partner knows what a keycard
# ask agrees.
define shown_fit(x) = shown.x.min + partner.x.min >= 8 | partner.x.min >= 6

# Slam values with x as trump before it is agreed: my support points and
# partner's shown floor make 32 (as `slam_values`), or, when he has limited his hand to a
# range of seven points or less (a preempt, a weak two), his top does and
# my hand has four losers or fewer (as `slam_values_limited`).
define fit_slam_values(x) = tp(x) + partner.points.min >= 32 | (tp(x) + partner.points.max >= 33, losers <= 4, partner.points.max - partner.points.min <= 6)

# Two side suits, beside t, of 2+ cards without the ace or king.
define bare_beside(x, t) = x is not t, x>=2, !has(A,x), !has(K,x)
define two_bare_beside(t) = (bare_beside(C,t), bare_beside(D,t)) | (bare_beside(C,t), bare_beside(H,t)) | (bare_beside(C,t), bare_beside(S,t)) | (bare_beside(D,t), bare_beside(H,t)) | (bare_beside(D,t), bare_beside(S,t)) | (bare_beside(H,t), bare_beside(S,t))

# ── Fast arrival (Phase 1, 2026-09-30) ────────────────────────────────
#
# In a game force with an eight-card fit known and no suit agreed, the
# cheapest bid in the fit agrees it and shows slam interest; jumping to
# game in it (base.bid's fallback) is then the minimum, and denies the
# interest. Once it is agreed, control bids and the keycard ask take over.
# On 20,000 random deals we bid a slam on 15 of 63 boards with a fit and
# 33 HCP between us (BBA 55); the usual path was a jump to game after a
# jump shift or a reverse, where neither hand could count 33 on the
# other's floor.

# Slam interest: 31 between us on partner's floor.
define slam_interest(x) = tp(x) + partner.points.min >= 31

when we.forcing = game, we.trump is none, !asked, !game_reached, !they.bid
  cheapest(S)  "Agrees ♠: slam interest"
      shows we.fit(S).min >= 8, slam_interest(S)
      when  partner.S.min >= 3, under_game(S)   # public: a raise of partner's suit, never read into a natural bid
      sets  trump=S
  cheapest(H)  "Agrees ♥: slam interest"
      shows we.fit(H).min >= 8, slam_interest(H)
      when  partner.H.min >= 3, under_game(H)   # public: a raise of partner's suit, never read into a natural bid
      sets  trump=H

# ── Slam without an ask (Phase B, 2026-09-30) ─────────────────────────
#
# With no keycard or ace ask on the card, nothing past game read the
# count: on the vanilla SAYC random set the slams BBA bid and we missed
# stopped at base.bid's "Game reached" pass (2,917 boards, -10,007
# IMPs). BBA jumps to slam on support points: my tp plus partner's
# floor, 50% at 31-32 in six made-hand positions (slam-entry.notes.md,
# Phase A), with aces and kings counting a little extra. So, with a suit
# agreed and the values, bid it. Cards that ask (Blackwood, RKCB) keep
# asking: the rule is off for them.
#
# The count is our support points on partner's floor plus my controls
# (A 2, K 1), 35, with at least 29 in support points. Calibrated on the
# vanilla set (notes): 32 in support points alone +1,494 IMPs, 33
# +1,203, 31 +1,413; with controls 37 (tp 30+) +1,962, 36 +2,124, **35
# +2,325**, 34 +1,652; both halves of the set agree. Below BBA's own
# 31-32 because partner's floor understates him (as for slam_values).
#
# Since 2026-10-01 the count is declarer points for the long-trump hand
# and support points for the other (`count_*` above): 28 on partner's
# floor, and 35 with my controls. Par scores it level with the support
# points it replaced (+31 IMPs on the vanilla set, both halves).

# No ace or keycard ask on the card.
define no_ask = !bw, !k1430, !k0314

# Slam values for a direct slam: the count 28, and 35 with my controls.
define direct_count(t) = (longer(t), count_long(t) >= 28, count_long(t) + controls >= 35) | (shorter(t), count_short(t) >= 28, count_short(t) + controls >= 35) | (shorter(t), count_short_l(t) >= 28, count_short_l(t) + controls >= 35) | (!longer(t), !shorter(t), count_equal(t) >= 28, count_equal(t) + controls >= 35)
define direct_slam_values = direct_count(trump)

when we.trump is suit, !they.bid, !asked, no_ask
  6{trump}  "Slam: our count on partner's floor plus my controls make 35"
      shows direct_slam_values
      priority -10     # below every descriptive call; above base.bid's "Game reached" pass

# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Slam entry: the conditions the slam modules share, named once
# (docs/JUDGMENT-LAYER.md, Phase 0). rkcb-1430.bid, blackwood.bid and
# control-bids.bid used to spell each of them out, up to 1,300 characters
# a line. No rules yet: what decides whether slam is worth looking for
# (Phase 1) will live here, and the modules that ask keep deciding how.
#
# The thresholds are Rick's (rkcb-1430.bid, "The ask"; slam-catch.notes.md):
# 33 support points between us with the agreed suit as trump, or 18 of my
# own facing a game force; the control rulings are control-bids.bid's.

module slam-entry "Slam entry: the conditions the slam modules share"
  skill  partnership_bidding/slam_bidding
  param  style = slam.cue_bids.style default first_or_second_round
  param  bw    = slam.blackwood.standard default false
  param  k1430 = slam.blackwood.rkcb_1430 default false
  param  k0314 = slam.blackwood.rkcb_0314 default false
  param  q4n   = slam.quantitative_4nt.play default true

# ── The count: declarer points and support points (2026-10-01) ───────
#
# Rick (2026-10-01): "point count for any auction is normally declarer
# points for the hand with longer trumps, and support points for the
# other hand. With 4-4 fits both hands can use support points." The
# long-trump hand counts HCP + length (one a card beyond four, in every
# suit), not its own shortness; the short hand counts HCP + shortness
# (`tp(t)`, capped by its trumps). `we.tp(t)` counted shortness in both
# hands, which double counts.
#
# Trump lengths are compared with what partner has shown (`partner.t.min`):
# longer than that, I am the long hand; shorter, partner is; equal, both
# count support points (4-4, 5-5). A raiser shows the length he raised
# with, so the raiser is the support hand unless I hold no more trumps.

define longer(t)  = t > partner.t.min
define shorter(t) = t < partner.t.min

# The count on partner's floor, by role. Partner as the long hand counts
# his shown points (HCP + length), or his HCP and the length he has shown
# when no call showed points: either is a floor. As the short hand (or
# with equal length) his support points when a raise showed them, else
# the points he showed (`_p`): a call that shows total points leaves
# his HCP floor, and so `partner.tp`, near zero (1S-2D-3C-3S: 13+
# points). Each condition takes the better of the floors.
define count_long(t)    = hcp + length_points + partner.tp(t).min
define count_long_p(t)  = hcp + length_points + partner.points.min
define count_short(t)   = tp(t) + partner.points.min
define count_short_l(t) = tp(t) + partner.hcp.min + partner.length_points.min
define count_equal(t)   = tp(t) + partner.tp(t).min
define count_equal_p(t) = tp(t) + partner.points.min

# The same on partner's maximum.
define count_long_max(t)  = hcp + length_points + partner.tp(t).max
define count_short_max(t) = tp(t) + partner.points.max
define count_equal_max(t) = tp(t) + partner.tp(t).max

# The count at the thresholds the slam conditions use. The textbook 33
# (32 on partner's floor, `slam_values`) holds where both hands count
# support points; the long hand, which no longer counts its shortness,
# needs two less, the short hand one less (calibrated 2026-10-01 on the
# corpus and the 21GF random set: slam-entry.notes.md).
define slam_count_interest(t) = (longer(t), count_long(t) >= 29) | (longer(t), count_long_p(t) >= 29) | (shorter(t), count_short(t) >= 31) | (shorter(t), count_short_l(t) >= 31) | (!longer(t), !shorter(t), count_equal(t) >= 31) | (!longer(t), !shorter(t), count_equal_p(t) >= 31)
define slam_count(t) = (longer(t), count_long(t) >= 30) | (longer(t), count_long_p(t) >= 30) | (shorter(t), count_short(t) >= 31) | (shorter(t), count_short_l(t) >= 31) | (!longer(t), !shorter(t), count_equal(t) >= 32) | (!longer(t), !shorter(t), count_equal_p(t) >= 32)
define slam_count_max(t) = (longer(t), count_long_max(t) >= 31) | (shorter(t), count_short_max(t) >= 32) | (!longer(t), !shorter(t), count_equal_max(t) >= 33)

# ── Values ────────────────────────────────────────────────────────────

# Facing a game force: the count on partner's floor (`slam_count`: 32
# with support points in both hands), or 18 of my own. Partner's floor
# understates him, so one point under the textbook 33 (calibrated
# 2026-09-30 on random deals and the corpus: slam-entry.notes.md).
# The 18 of my own only while my range is still open (more than four
# HCP wide): an 18-19 2NT rebid has told partner, and his game bid
# after it is his sign-off, not an invitation (2026-10-05: 1x-1M-2NT-
# 3m(NMF)-...-4M asked with every 18-19 opener).
define slam_values = slam_count(trump) | (tp(trump) >= 18, !(shown.hcp.max - shown.hcp.min <= 4))

# Facing a limited hand (a raise with a top): the count on partner's
# maximum (`slam_count_max`: 33 with support points in both hands), and
# a hand of four losers or fewer.
define slam_values_limited = slam_count_max(trump), losers <= 4

# ── Controls ──────────────────────────────────────────────────────────

# A control in x: the ace or a void, or with `first_or_second_round` the
# king or a singleton. Shortness counts only when partner has not shown
# four of x (a singleton in partner's suit is not a control).
define controlled(x) = has(A,x) | (x<=0, partner.x.min<=3) | (style is first_or_second_round, has(K,x) | (x<=1, partner.x.min<=3))

# First-round control only: past game.
define first_round(x) = has(A,x) | (x<=0, partner.x.min<=3)

# A side suit I cannot control on my own: what sends a hand to control
# bids rather than straight to the keycard ask.
define side_suit_uncontrolled = (trump is not C, !controlled(C)) | (trump is not D, !controlled(D)) | (trump is not H, !controlled(H)) | (trump is not S, !controlled(S))

# Rick's rule for the ask: no two bare side suits (2+ cards, neither the
# ace nor the king).
define two_bare_suits = (bare(C), bare(D)) | (bare(C), bare(H)) | (bare(C), bare(S)) | (bare(D), bare(H)) | (bare(D), bare(S)) | (bare(H), bare(S))

# Going on in the dialogue promises every suit partner denied: it is the
# trump suit, partner did not skip it, or I control it.
define promised(x) = trump is x | !partner.denied(x) | controlled(x)
define denials_promised = promised(C), promised(D), promised(H), promised(S)

# The same past game, with first-round controls.
define promised_first(x) = trump is x | !partner.denied(x) | first_round(x)
define denials_promised_first = promised_first(C), promised_first(D), promised_first(H), promised_first(S)

# Every side suit covered for the keycard ask: my control, one partner
# has cued, or one I denied that partner has promised by bidding on.
define covered(x) = trump is x | controlled(x) | partner.cued(x) | me.denied(x)
define all_covered = covered(C), covered(D), covered(H), covered(S)

# The same when I opened the dialogue (partner answered me): my control
# or partner's.
define covered_by_us(x) = trump is x | controlled(x) | partner.cued(x)
define all_covered_by_us = covered_by_us(C), covered_by_us(D), covered_by_us(H), covered_by_us(S)

# ── A fit known but not agreed (Phase 1, 2026-09-30) ─────────────────

# A suit both hands know we fit: suit agreement (`agreed_fit`,
# fit.bid: eight cards shown between us), or partner's own six-card suit.
# Public, so partner knows what a keycard ask agrees.
define shown_fit(x) = agreed_fit(x) | partner.x.min >= 6

# ── The keycard suit (Rick, 2026-10-03) ──────────────────────────────
#
# "A 4NT with no prior NT bids is normally keycard regardless, and if
# there hasn't been suit agreement, it's for the last bid suit. So
# 1H-1S-2H-4NT would be keycard for H." And: "Normally a major fit will
# replace a minor fit." For the cards that play Blackwood or RKCB; with
# neither (bare SAYC) 4NT stays natural or quantitative. Notes:
# rkcb-1430.notes.md, "The keycard suit".
#
# The suit, in order:
#   1. a trump suit set by a rule, unless it is a minor and a major has
#      since been agreed (`major_over_minor`: 1S-2C-3C-4S-4NT asks in ♠);
#   2. with none set, a suit agreed by what the two hands have shown
#      (eight between us; a major before a minor);
#   3. with no agreement and no notrump bid by us, the last suit our side
#      bid: partner's last call, when it was a bid in a suit that showed
#      two or more cards of it (not an artificial 2♦ waiting bid or a
#      fourth-suit call).
# With notrump bid by us and no agreement, 4NT is quantitative
# (1NT-2D-2H-4NT): the notrump modules' rules.

# Eight cards in x shown between us (fit.bid's `agreed_fit` without the
# trump state).
define shown_eight(x) = shown.x.min + partner.x.min >= 8

# A minor set as trump, and a major agreed since: the major takes over.
define major_over_minor(x) = x is S | x is H, trump is C | trump is D, shown_eight(x)
define minor_given_way = major_over_minor(S) | major_over_minor(H)

# Our side has bid notrump: either of us made a natural notrump bid at
# any point (`we.named(N)`, 2026-10-03; artificial calls such as a 2NT
# feature ask do not count), or either hand has shown a balanced hand.
define our_notrump = we.named(N) | !(maybe !partner.balanced) | !(maybe !shown.balanced)

# Partner's last call was a natural bid in x.
define last_suit(x) = partner_named(x), partner.x.min >= 2

define no_shown_eight = !shown_eight(S), !shown_eight(H), !shown_eight(D), !shown_eight(C)

# 4NT after our side has bid notrump, with no suit agreed, is
# quantitative (Rick, 2026-10-03). The notrump modules write it auction
# by auction; this is the fallback below them, so that a 4NT after, say,
# 1C-1S-1NT-2D (new minor) is read and answered rather than "no rule".
# The answer is one-nt.bid's `when asked quant` (6NT from 32 between us).
#
# `quant_4nt` is the card's switch (`slam.quantitative_4nt.play`, on by
# default and on every stock card), for the quantitative 4NTs the
# notrump and base modules write (2026-10-05).
define quant_4nt = q4n

# Ranked below every pass, so it is for reading: our own 4NT stays with
# the modules that judge it (a higher rank took over their 3NT and pass).
when we.named(N), we.trump is none, !asked, !they.bid, no_shown_eight
  4N  "Quantitative: 31-32 between us, invites 6NT"
      when  q4n                            # the card plays a quantitative 4NT
      shows points + partner.points.min >= 31, points + partner.points.min <= 32
      sets  ask=quant
      priority -60

# The keycard suit with no trump set (2 and 3 above), one suit at most.
define kc_shown(x) = shown_eight(x), x is S | !shown_eight(S), x is S | x is H | !shown_eight(H), x is S | x is H | x is D | !shown_eight(D)
define kc_open(x) = kc_shown(x) | (no_shown_eight, !our_notrump, last_suit(x))

# Slam values with x as trump before it is agreed: the count on
# partner's floor (as `slam_values`), or, when he has limited his hand to a
# range of seven points or less (a preempt, a weak two), his top does and
# my hand has four losers or fewer (as `slam_values_limited`).
define fit_slam_values(x) = slam_count(x) | (slam_count_max(x), losers <= 4, partner.points.max - partner.points.min <= 6)

# Two side suits, beside t, of 2+ cards without the ace or king.
define bare_beside(x, t) = x is not t, x>=2, !has(A,x), !has(K,x)
define two_bare_beside(t) = (bare_beside(C,t), bare_beside(D,t)) | (bare_beside(C,t), bare_beside(H,t)) | (bare_beside(C,t), bare_beside(S,t)) | (bare_beside(D,t), bare_beside(H,t)) | (bare_beside(D,t), bare_beside(S,t)) | (bare_beside(H,t), bare_beside(S,t))

# An ambiguous keycard answer ("1 or 4" facing my one: 2 or 5) settled
# by the high cards (2026-10-07, rkcb-1430.notes.md "The count that
# fits"): three keycards missing are at least 11 HCP (two aces and the
# trump king), so with 30 HCP on our floor at most two are missing and
# the low count is impossible. The answers that stay open after the
# deck's limit are 3 apart (2|5, 1|4, 0|3), so the count is the high one.
define kc_high(t) = maybe we.keycards(t) >= 4, hcp + partner.hcp.min >= 30

# ── Fast arrival (Phase 1, 2026-09-30) ────────────────────────────────
#
# In a game force with an eight-card fit known and no suit agreed, the
# cheapest bid in the fit agrees it and shows slam interest; jumping to
# game in it (base.bid's fallback) is then the minimum, and denies the
# interest. Once it is agreed, control bids and the keycard ask take over.
# On 20,000 random deals we bid a slam on 15 of 63 boards with a fit and
# 33 HCP between us (BBA 55); the usual path was a jump to game after a
# jump shift or a reverse, where neither hand could count 33 on the
# other's floor.

# Not straight over partner's notrump where systems are on (2♣–2♠–2NT,
# 2026-10-05): there the cheapest bid is the system's (a transfer).
# Slam interest: the count on partner's floor, 31 (29 for the long hand).
define slam_interest(x) = slam_count_interest(x)

when we.forcing = game, we.trump is none, !asked, !game_reached, !they.bid, !we.systems_on
  cheapest(S)  "Agrees ♠: slam interest"
      shows we.fit(S).min >= 8, slam_interest(S)
      when  partner.S.min >= 3, under_game(S)   # public: a raise of partner's suit, never read into a natural bid
      sets  trump=S
  cheapest(H)  "Agrees ♥: slam interest"
      shows we.fit(H).min >= 8, slam_interest(H)
      when  partner.H.min >= 3, under_game(H)   # public: a raise of partner's suit, never read into a natural bid
      sets  trump=H

# ── Slam without an ask (Phase B, 2026-09-30) ─────────────────────────
#
# With no keycard or ace ask on the card, nothing past game read the
# count: on the vanilla SAYC random set the slams BBA bid and we missed
# stopped at base.bid's "Game reached" pass (2,917 boards, -10,007
# IMPs). BBA jumps to slam on support points: my tp plus partner's
# floor, 50% at 31-32 in six made-hand positions (slam-entry.notes.md,
# Phase A), with aces and kings counting a little extra. So, with a suit
# agreed and the values, bid it. Cards that ask (Blackwood, RKCB) keep
# asking: the rule is off for them.
#
# The count is our support points on partner's floor plus my controls
# (A 2, K 1), 35, with at least 29 in support points. Calibrated on the
# vanilla set (notes): 32 in support points alone +1,494 IMPs, 33
# +1,203, 31 +1,413; with controls 37 (tp 30+) +1,962, 36 +2,124, **35
# +2,325**, 34 +1,652; both halves of the set agree. Below BBA's own
# 31-32 because partner's floor understates him (as for slam_values).
#
# Since 2026-10-01 the count is declarer points for the long-trump hand
# and support points for the other (`count_*` above): 28 on partner's
# floor, and 35 with my controls. Par scores it level with the support
# points it replaced (+31 IMPs on the vanilla set, both halves).
#
# It ranks above the descriptive calls (priority 1, 2026-10-01): with the
# values, jump to slam at once, as BBA's "calculated bid" does, rather
# than describe and stop in game. Vanilla +596 IMPs against -10 (below
# every descriptive call), both halves.

# No ace or keycard ask on the card.
define no_ask = !bw, !k1430, !k0314

# Slam values for a direct slam: the count 28, and 35 with my controls.
define direct_count(t) = (longer(t), count_long(t) >= 28, count_long(t) + controls >= 35) | (longer(t), count_long_p(t) >= 28, count_long_p(t) + controls >= 35) | (shorter(t), count_short(t) >= 28, count_short(t) + controls >= 35) | (shorter(t), count_short_l(t) >= 28, count_short_l(t) + controls >= 35) | (!longer(t), !shorter(t), count_equal(t) >= 28, count_equal(t) + controls >= 35) | (!longer(t), !shorter(t), count_equal_p(t) >= 28, count_equal_p(t) + controls >= 35)
define direct_slam_values = direct_count(trump)

when we.trump is suit, !minor_given_way, !they.bid, !asked, no_ask
  6{trump}  "Slam: our count on partner's floor plus my controls make 35"
      shows direct_slam_values
      priority 1

# A minor set as trump and a major agreed since: the slam is in the major
# (Rick, 2026-10-03: "normally a major fit will replace a minor fit").
when minor_given_way, !they.bid, !asked, no_ask
  6S  "Slam in the spade fit, which replaces the minor: our count on partner's floor plus my controls make 35"
      shows direct_count(S)
      when  major_over_minor(S)
      sets  trump=S
      priority 1
  6H  "Slam in the heart fit, which replaces the minor: our count on partner's floor plus my controls make 35"
      shows direct_count(H)
      when  major_over_minor(H), !major_over_minor(S)
      sets  trump=H
      priority 1

# ── A fit known but not agreed: the direct slam (2026-10-01) ──────────
#
# 1H-2D-3H (six hearts, 16-18) does not set hearts in standard bidding,
# but responder with two knows the fit (Rick, 2026-10-01); the same when
# a new suit shows me partner's four-card suit (1S-2D-3C with four
# clubs). The hand that sees the fit counts as the role says: the short
# hand support points on partner's declarer points. Bid six on the
# direct count. Reworks the held-back version (branch
# slam-fit-not-agreed, which counted my support points on partner's
# points in every case).
#
# Above the descriptive calls, as the agreed-suit slam: at -10 (only once
# game is reached) +809 IMPs on the vanilla set, at 1 +3,122. Not when my
# own range is four points or less (1NT, 2NT, a jump rebid): partner is
# then the captain (+54). Vanilla calibration (slam-entry.notes.md).
when we.trump is none, !they.bid, !asked, no_ask, !(shown.hcp.max - shown.hcp.min <= 4)
  6S  "Slam in the spade fit: our count on partner's floor plus my controls make 35"
      shows we.fit(S).min >= 8, direct_count(S)
      priority 1
  6H  "Slam in the heart fit: our count on partner's floor plus my controls make 35"
      shows we.fit(H).min >= 8, direct_count(H)
      priority 1
  6D  "Slam in the diamond fit: our count on partner's floor plus my controls make 35"
      shows we.fit(D).min >= 8, direct_count(D)
      priority 1
  6C  "Slam in the club fit: our count on partner's floor plus my controls make 35"
      shows we.fit(C).min >= 8, direct_count(C)
      priority 1

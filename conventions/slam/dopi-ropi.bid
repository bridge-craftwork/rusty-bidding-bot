# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# DOPI and ROPI: answering an ace or keycard ask after the opponents
# interfere. The answers keep their steps, the first two replaced:
#
#   they bid a suit (DOPI)    double = first step, pass = second step,
#                             then the next two bids are steps three
#                             and four;
#   they double (ROPI)        redouble = first step, pass = second step,
#                             then 5♣ and 5♦.
#
# So with 1430 a double shows one or four keycards and a pass none or
# three; with standard Blackwood a double shows none or four aces, a pass
# one. The asker then places the contract, and with two keycards (aces)
# missing defends: passes partner's double, or doubles himself over
# partner's pass. Notes: dopi-ropi.notes.md.

module dopi-ropi "DOPI and ROPI: answering an ace or keycard ask over interference"
  needs  base
  skill  bidding_conventions/dopi_ropi
  param  dopi   = slam.dopi default false
  param  ropi   = slam.ropi default false
  param  gstyle = general.style
  param  k0314  = slam.blackwood.rkcb_0314 default false
  param  m0314  = slam.blackwood.minor_0314 default false

# The first step of the keycard answers is "1 or 4" (1430) unless the
# card's treatment makes it "0 or 3", as rkcb-1430.bid decides.
define kc_first_14(t) = (gstyle is not bba, !m0314 | t is H | t is S) | (gstyle is bba, !k0314)

# They bid a suit over the ask, below six (DOPI); they doubled it (ROPI).
define dopi_bid  = rho.last <= 5S
define ropi_dbl  = rho.last = X

# ── Keycards ──────────────────────────────────────────────────────────

when dopi, asked keycards(t), dopi_bid
  X   "DOPI: 1 or 4 keycards"              shows keycards(t) in 1|4   artificial
      when  kc_first_14(t)
      priority 5
  P   "DOPI: 0 or 3 keycards"              shows keycards(t) in 0|3   artificial
      when  kc_first_14(t)
      priority 5
  X   "DOPI: 0 or 3 keycards"              shows keycards(t) in 0|3   artificial
      when  !kc_first_14(t)
      priority 5
  P   "DOPI: 1 or 4 keycards"              shows keycards(t) in 1|4   artificial
      when  !kc_first_14(t)
      priority 5

when ropi, asked keycards(t), ropi_dbl
  XX  "ROPI: 1 or 4 keycards"              shows keycards(t) in 1|4   artificial
      when  kc_first_14(t)
      priority 5
  P   "ROPI: 0 or 3 keycards"              shows keycards(t) in 0|3   artificial
      when  kc_first_14(t)
      priority 5
  XX  "ROPI: 0 or 3 keycards"              shows keycards(t) in 0|3   artificial
      when  !kc_first_14(t)
      priority 5
  P   "ROPI: 1 or 4 keycards"              shows keycards(t) in 1|4   artificial
      when  !kc_first_14(t)
      priority 5
  5C  "ROPI: 2 keycards, no {t} queen"     shows keycards(t)=2, !has(Q,t)   artificial
      priority 5
  5D  "ROPI: 2 keycards and the {t} queen" shows keycards(t)=2, has(Q,t)    artificial
      priority 5

# Steps three and four over their bid: the next two bids.
when dopi, asked keycards(t)
  5D  "DOPI: 2 keycards, no {t} queen"     shows keycards(t)=2, !has(Q,t)   artificial
      when  rho.last = 5C
      priority 5
  5H  "DOPI: 2 keycards and the {t} queen" shows keycards(t)=2, has(Q,t)    artificial
      when  rho.last = 5C
      priority 5
  5H  "DOPI: 2 keycards, no {t} queen"     shows keycards(t)=2, !has(Q,t)   artificial
      when  rho.last = 5D
      priority 5
  5S  "DOPI: 2 keycards and the {t} queen" shows keycards(t)=2, has(Q,t)    artificial
      when  rho.last = 5D
      priority 5
  5S  "DOPI: 2 keycards, no {t} queen"     shows keycards(t)=2, !has(Q,t)   artificial
      when  rho.last = 5H
      priority 5
  5N  "DOPI: 2 keycards and the {t} queen" shows keycards(t)=2, has(Q,t)    artificial
      when  rho.last = 5H
      priority 5
  5N  "DOPI: 2 keycards, no {t} queen"     shows keycards(t)=2, !has(Q,t)   artificial
      when  rho.last = 5S
      priority 5
  6C  "DOPI: 2 keycards and the {t} queen" shows keycards(t)=2, has(Q,t)    artificial
      when  rho.last = 5S
      priority 5

# ── Aces (standard Blackwood) ─────────────────────────────────────────

when dopi, asked aces, dopi_bid
  X   "DOPI: 0 or 4 aces"   shows keycards(N) in 0|4   artificial
      priority 5
  P   "DOPI: 1 ace"         shows keycards(N)=1        artificial
      priority 5

when ropi, asked aces, ropi_dbl
  XX  "ROPI: 0 or 4 aces"   shows keycards(N) in 0|4   artificial
      priority 5
  P   "ROPI: 1 ace"         shows keycards(N)=1        artificial
      priority 5
  5C  "ROPI: 2 aces"        shows keycards(N)=2        artificial
      priority 5
  5D  "ROPI: 3 aces"        shows keycards(N)=3        artificial
      priority 5

when dopi, asked aces
  5D  "DOPI: 2 aces"        shows keycards(N)=2   artificial   when rho.last = 5C   priority 5
  5H  "DOPI: 3 aces"        shows keycards(N)=3   artificial   when rho.last = 5C   priority 5
  5H  "DOPI: 2 aces"        shows keycards(N)=2   artificial   when rho.last = 5D   priority 5
  5S  "DOPI: 3 aces"        shows keycards(N)=3   artificial   when rho.last = 5D   priority 5
  5S  "DOPI: 2 aces"        shows keycards(N)=2   artificial   when rho.last = 5H   priority 5
  5N  "DOPI: 3 aces"        shows keycards(N)=3   artificial   when rho.last = 5H   priority 5
  5N  "DOPI: 2 aces"        shows keycards(N)=2   artificial   when rho.last = 5S   priority 5
  6C  "DOPI: 3 aces"        shows keycards(N)=3   artificial   when rho.last = 5S   priority 5

# ── The asker over a DOPI or ROPI answer ─────────────────────────────
#
# Two keycards (aces) missing: defend rather than bid on. Partner's double
# was the answer and also penalty: pass it. Over partner's pass, double.
# Over ROPI's redouble the asker always bids: 4NT redoubled is ours.
# With the values the slam rules of the ask's own module apply.
define kc_two_missing(t) = we.keycards(t).max <= 3

when (dopi | ropi), answered keycards(t), rho.last = P
  P   "Defend doubled: two keycards missing"
      when  partner.last = X, kc_two_missing(t), lho.last <= 5S
      priority 5
  # Over partner's pass a count still open ("0 or 3" facing my two) is
  # read low, as the sign-off in rkcb-1430.bid is: partner bids six over
  # the double with the higher count.
  X   "Penalty: two keycards missing (partner bids six with the higher count)"
      when  partner.last = P, we.keycards(t).min <= 3, lho.last <= 5S
      sets  ask=keycard_correct(t)
      priority 5

when (dopi | ropi), answered aces, rho.last = P
  P   "Defend doubled: two aces missing"
      when  partner.last = X, we.keycards(N).max <= 2, lho.last <= 5S
      priority 5
  X   "Penalty: two aces missing"
      when  partner.last = P, we.keycards(N).max <= 2, lho.last <= 5S
      priority 5

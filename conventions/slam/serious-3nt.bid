# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Non-serious 3NT: in a game force with a major agreed at the three
# level (and neither of us shown balanced), the next hand's 3NT is
# artificial: mild slam interest, asking partner to start control bids
# with a good hand. A control bid instead is serious (the slam values of
# control-bids.bid), and four of the major has no interest. Partner
# answers 3NT with a control bid (extras), the keycard ask (slam values
# and every suit controlled), or four of the major. Notes:
# serious-3nt.notes.md.

module serious-3nt "Non-serious 3NT before control bids in a major-fit game force"
  needs  base
  skill  bidding_conventions/serious_3nt
  param  nsplay = slam.non_serious_3nt.play default false
  param  cue    = slam.cue_bids.play default false
  param  k1430  = slam.blackwood.rkcb_1430 default false
  param  k0314  = slam.blackwood.rkcb_0314 default false

# Partner has just agreed (or raised) our major at the three level.
define ns_position = partner.last = 3{trump}, !our_notrump

# ── The 3NT ───────────────────────────────────────────────────────────
#
# Within two points of the slam values that make a control bid serious
# (`slam_count`, slam-entry.bid: 30 for the long hand, 31 short, 32
# equal, on partner's floor), but short of them. The source puts the
# non-serious 3NT about 14-15 opposite a 2/1, the serious control bid
# 16+. Priority 12, level with the control bids: the two never hold on
# the same hand.
define ns_count(t) = (longer(t), count_long(t) >= 28) | (longer(t), count_long_p(t) >= 28) | (shorter(t), count_short(t) >= 29) | (shorter(t), count_short_l(t) >= 29) | (!longer(t), !shorter(t), count_equal(t) >= 30) | (!longer(t), !shorter(t), count_equal_p(t) >= 30)

when nsplay, cue, we.trump is suit, trump is H | trump is S, we.forcing = game, !asked, !answered control
  3N  "Non-serious 3NT: mild slam interest, control-bid with a good hand"  alert
      shows ns_count(trump)
      when  ns_position
      when  !slam_values
      sets  ask=ns3nt(trump)
      artificial
      priority 12

# ── Partner over the 3NT ──────────────────────────────────────────────
#
# Extras of my own (the count on partner's raised floor): show the
# cheapest control below game, as control-bids.bid's opening. The keycard
# ask with slam values and every side suit controlled. Otherwise game.

when nsplay, cue, asked ns3nt(t)
  cheapest(C)  "Control bid in ♣ over the non-serious 3NT"  alert
      when  t is not C, under_game(C), slam_interest(t), controlled(C)
      sets  ask=control(C), ladder=control
      artificial
      prefer 0 - cheapest_rank(C)
      priority 12
  cheapest(D)  "Control bid in ♦ over the non-serious 3NT"  alert
      when  t is not D, under_game(D), slam_interest(t), controlled(D)
      sets  ask=control(D), ladder=control
      artificial
      prefer 0 - cheapest_rank(D)
      priority 12
  cheapest(H)  "Control bid in ♥ over the non-serious 3NT"  alert
      when  t is not H, under_game(H), slam_interest(t), controlled(H)
      sets  ask=control(H), ladder=control
      artificial
      prefer 0 - cheapest_rank(H)
      priority 12
  4N  "Keycard ask in {t}"
      when  k1430 | k0314
      when  slam_values, !side_suit_uncontrolled
      sets  ask=keycards(t)
      artificial
      priority 13
  4{t}  "No interest opposite a non-serious 3NT: game"

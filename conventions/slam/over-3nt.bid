# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Slam after partner's 3NT (2026-09-27). The slam work's third group:
# 1,433 boards where BBA bid slam and our auction stopped in a 3NT that
# one partner bid with 15-18 balanced while the other, often with 15-17
# and a long suit, passed. Nothing looked past 3NT.
#
# Partner's 3NT has shown a range, and I add my HCP to his minimum: 6NT
# with 34 or more; a quantitative 4NT with 32-33 (answered by `when asked
# quant`, one-nt.bid); with a six-card minor and 31+, four of it as a
# slam try. Counting partner at his minimum, one point above the
# textbook 33/31 measured best (notes).

module over-3nt "Slam after partner's 3NT"
  kind   judgement
  needs  base
  skill  partnership_bidding/slam_bidding
  param  q4n   = slam.quantitative_4nt.play default true
  param  texas = notrump.texas.play default false
  param  tu    = notrump.texas.two_under default false
  param  o23   = notrump.jacoby_transfers.over_2c_3nt default true
  param  system = general.system   # `brill`: Gerber here instead (gerber.bid)

# After 2♣–2♦–3NT (24+ shown, opener's second bid) Texas uses 4♦/4♥, or
# 4♣/4♦ for 2-under (texas-transfers.bid): the tries and natural bids
# below give way there, or partner would read them as transfers. Only
# when the card plays transfers there (`notrump.jacoby_transfers.over_2c_3nt`,
# default on, Rick 2026-11-07); off, 4♦ and 4♥ are natural.
define big_3n = partner.hcp.min>=24, partner.bids>=2
define texas_3n = big_3n, o23

when partner.last=3N, !they.bid, we.trump is none
  # Without Texas over 2♣–2♦–3NT, a six-card major goes to game
  # naturally: the same hands that Texas carries there (texas-transfers.bid).
  4H  "To play: six or more hearts"
      shows H>=6, points>=25-partner.points.min, suit_points<=32-partner.points.min
      when  big_3n, !(texas, o23)
      priority -10
  4S  "To play: six or more spades"
      shows S>=6, points>=25-partner.points.min, suit_points<=32-partner.points.min
      when  big_3n, !(texas, o23)
      priority -10
  6N  "Small slam"
      shows hcp + partner.hcp.min >= 34
      priority -10
  4N  "Quantitative: invites 6NT"
      when  q4n                            # the card plays a quantitative 4NT
      shows hcp + partner.hcp.min >= 32, hcp + partner.hcp.max <= 35
      sets  ask=quant
      priority -10
  4C  "Slam try: six or more clubs"
      shows C>=6, hcp + partner.hcp.min >= 31
      when  !(texas_3n, tu)
      sets  ask=slam_try(C)
      priority -10
  4D  "Slam try: six or more diamonds"
      shows D>=6, hcp + partner.hcp.min >= 31
      when  !(texas_3n, texas | tu)
      sets  ask=slam_try(D)
      priority -10

  # A standalone major, six to the AKQJ or seven to the AKQ, plays in
  # game without help from partner, and a short suit with no stopper is
  # a risk in notrump (Rick, 2026-09-27, ticket b194: 1S 2D 2S 3NT with
  # AKQJ63 and 32 in hearts; BBA bids 4S).
  4S  "To play: a self-sufficient ♠ suit"
      shows (S>=6, quality(S)=3, top5(S)>=4) | (S>=7, quality(S)=3)
      shows (H<=2, !stop(H)) | (D<=2, !stop(D)) | (C<=2, !stop(C))
      priority -10
  4H  "To play: a self-sufficient ♥ suit"
      shows (H>=6, quality(H)=3, top5(H)>=4) | (H>=7, quality(H)=3)
      shows (S<=2, !stop(S)) | (D<=2, !stop(D)) | (C<=2, !stop(C))
      when  !(texas_3n, texas, !tu)
      priority -10

# The same after their overcall of our 2♣ (2♣ (2♥) P (P) 3NT, 2♣ P 2♦
# (2♥) 3NT), where the block above stops at `!they.bid`. 4♣ is not a
# jump over 3NT, so it is the club slam try, not Gerber (Rick,
# 2026-10-31: Gerber needs a jump; without one 4♣ is a slam try).
# Texas is off after interference, so the tries do not give way to it.
after 2C (*) P (P) 3N (P) | 2C (P) 2D (*) 3N (P) when they.bid, system is not brill
  6N  "Small slam"
      shows hcp + partner.hcp.min >= 34
      priority -10
  4C  "Slam try: six or more clubs"
      shows C>=6, hcp + partner.hcp.min >= 31
      sets  ask=slam_try(C)
      priority -10
  4D  "Slam try: six or more diamonds"
      shows D>=6, hcp + partner.hcp.min >= 31
      sets  ask=slam_try(D)
      priority -10

when asked slam_try(m), partner.last=4{m}, we.trump is none
  6{m}  "Small slam: a fit"                       shows m>=3
  4N    "No fit"                            shows m<=2
when answered slam_try(m), partner.last=4N
  6N  "Small slam"    shows hcp + partner.hcp.min >= 34
  P   "To play"
      priority -5

# The same count for responder when opener's rebid is a new suit
# (2026-09-27): responder bid 3NT with 33+ between the hands
# (1a–1b–2c–3NT, 772 boards short of slam). Counted in points: after a
# jump shift the HCP floor is only 10 (it shows suit points), the
# points floor 18. The textbook 33/31 is kept although lower thresholds
# score better on the slam-rich corpus (notes).
after 1x (P) 1y (P) 2z (P) when z is not x, z is not y
  6N  "Small slam"
      shows points + partner.points.min >= 33, !shortest<=1
      priority 1
  4N  "Quantitative: invites 6NT"
      when  q4n                            # the card plays a quantitative 4NT
      shows points + partner.points.min >= 31, points + partner.points.max <= 36, !shortest<=1
      when  no_ask                         # with Blackwood or RKCB, keycard in the last suit (Rick, 2026-10-03)
      sets  ask=quant
      priority 1
after 1x (P) 1y (P) 1z (P)
  6N  "Small slam"
      shows points + partner.points.min >= 33, !shortest<=1
      priority 1
  4N  "Quantitative: invites 6NT"
      when  q4n                            # the card plays a quantitative 4NT
      shows points + partner.points.min >= 31, points + partner.points.max <= 36, !shortest<=1
      when  no_ask                         # with Blackwood or RKCB, keycard in the last suit (Rick, 2026-10-03)
      sets  ask=quant
      priority 1
after 1x (P) 2y (P) 2z (P) when z is not x, z is not y
  6N  "Small slam"
      shows points + partner.points.min >= 33, !shortest<=1
      priority 1
  4N  "Quantitative: invites 6NT"
      when  q4n                            # the card plays a quantitative 4NT
      shows points + partner.points.min >= 31, points + partner.points.max <= 36, !shortest<=1
      when  no_ask                         # with Blackwood or RKCB, keycard in the last suit (Rick, 2026-10-03)
      sets  ask=quant
      priority 1

# Opener over responder's 15-17 jump to 3NT after a game-forcing 2/1
# and opener's two-level rebid (responder-rebids.bid; Rick, 2026-11-06,
# #91). The count above (34 / 32 on partner's minimum) lost slams
# opener had bid over the old 16+ 2NT; Rick, 2026-11-07: opener should
# be more aggressive here. The textbook 33/31 on responder's minimum, in
# HCP: 18+ bids 6NT, 16-17 a quantitative 4NT. Counting points or
# partner at mid-range lost (notes).
after 1y (P) 2x (P) 2z (P) 3N (P) when x is not y, we.gf
  6N  "Small slam"
      shows hcp + partner.hcp.min >= 33
      priority 1
  4N  "Quantitative: invites 6NT"
      when  q4n                            # the card plays a quantitative 4NT
      shows hcp + partner.hcp.min >= 31, hcp + partner.hcp.min <= 32
      sets  ask=quant
      priority 1
# Responder answers it in HCP too: 16-17 accepts, 15 declines (31-32
# between the hands). one-nt.bid's answer counts points on opener's
# floor, and his five-card suit made it accept with every 15.
after 1y (P) 2x (P) 2z (P) 3N (P) 4N (P) when x is not y, we.gf
  6N  "Accepts the slam invitation: 16-17"   shows hcp>=16
      priority 1
  P   "Declines: 15"                          shows hcp<=15
      priority 1

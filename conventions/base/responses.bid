# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Responses to a one-level suit opening, uncontested: Standard American
# (SAYC), as BBA's Basic-Bridge card plays it. Ranges come from BBA's own
# meanings (bba-cli --all-meanings) and the Basic_* corpus; see
# responses.notes.md.
#
# Which suit to bid first at the one level: the longest; with two four-card
# suits the cheaper (up the line); with two five-card suits the higher.

module responses "Responses to one-level suit openings"
  needs  base
  param  limit_raise = major_openings.jump_raise.inv default true
  param  strong_js   = general.jump_shifts.strong_2 default true
  param  inv_js      = general.jump_shifts.invitational default false
  param  over_1c     = minor_openings.one_club_responses default up_the_line
  param  nt2         = minor_openings.two_nt_response default invitational
  param  style       = general.style
  param  inverted    = minor_openings.inverted_minors.play default false

# ── Over 1♣ / 1♦ ───────────────────────────────────────────────────────
after 1C (P) when over_1c is up_the_line
  1D  "4+ diamonds, 6+ HCP"         shows D>=4, hcp>=6, D>=H, D>H | D=4, D>=S, D>S | D=4
      sets forcing=round
  1H  "4+ hearts, 6+ HCP"           shows H>=4, hcp>=6, H>=D, H>D | H>=5, H>=S, H>S | H=4
      sets forcing=round
  1S  "4+ spades, 6+ HCP"           shows S>=4, hcp>=6, S>=D, S>D | S>=5, S>H | S>=5, S>=H
      sets forcing=round

# Walsh: with a four-card major, bypass diamonds unless game forcing (12+ HCP).
after 1C (P) when over_1c is walsh
  1D  "4+ diamonds, 6+ HCP: no four-card major, or game forcing (12+ HCP)"
      shows D>=4, hcp>=6, (H<=3, S<=3) | hcp>=12, D>=H, D>=S
      sets forcing=round
  1H  "4+ hearts, 6+ HCP"           shows H>=4, hcp>=6, H>=S, H>S | H=4, hcp<=11 | H>D
      sets forcing=round
  1S  "4+ spades, 6+ HCP"           shows S>=4, hcp>=6, S>H | S>=5, S>=H, hcp<=11 | S>D
      sets forcing=round

after 1C (P)
  1N  "6-10 HCP, balanced, no 4-card major or diamonds"   shows hcp=6..10, H<=3, S<=3, D<=3
      when  !inverted | C<=4           # with inverted minors five clubs raise, weak or strong
  2D  "Strong jump shift: 15+, 5+ diamonds"  shows D>=5, hcp>=15  when strong_js, !passed_hand
      sets forcing=game

after 1D (P)
  1H  "4+ hearts, 6+ HCP"           shows H>=4, hcp>=6, H>=S, H>S | H=4
      when  hcp<=10 | H>=C             # 11+ HCP with longer clubs: 2C first
      sets forcing=round
  1S  "4+ spades, 6+ HCP"           shows S>=4, hcp>=6, S>H | S>=5, S>=H
      when  hcp<=10 | S>=C
      sets forcing=round
  1N  "6-10 HCP, no 4-card major"          shows hcp=6..10, H<=3, S<=3
      when  !inverted | D<=4           # with inverted minors five diamonds raise
  2C  "11+ points, 4+ clubs"           shows C>=4, points>=11 | C>=6, suit_points>=10, H<=3 | C>H, S<=3 | C>S
      sets forcing=round
  3C  "Invitational jump shift: 10-12, 6+ clubs"  shows C>=6, points=10..12, H<=3, S<=3  when inv_js

after 1m (P)
  2m  "Raise: 6-9, 5+ {m}, no 4-card major"     shows m>=5, hcp>=6, points<=9, H<=3, S<=3
      when  !inverted
  3m  "Limit raise: 10-12 HCP, 5+ {m}, no 4-card major"  shows m>=5, hcp=10..12, H<=3, S<=3
      when  !inverted                  # HCP: six clubs and 10-12 passed on 10-12 total points
  # With inverted minors the raises are in inverted-minors.bid.
  # Game values, a fit and no major, without inverted minors: 3NT, as BBA
  # (probes/minor-resp-std-1C.toml). A fallback below the natural calls.
  3N  "Game values, no 4-card major"            shows hcp>=13, H<=3, S<=3
      when  !inverted
      priority -1
  2N  "11-12, balanced, no 4-card major"        shows balanced, points=11..12, H<=3, S<=3
      when  nt2 is invitational
      priority -1                      # a one-level suit first when there is one
  3N  "13-15, balanced, no 4-card major"        shows balanced, points=13..15, H<=3, S<=3
      when  nt2 is invitational
      priority -1
  2N  "13-15, balanced, no 4-card major: game forcing"  shows balanced, points=13..15, H<=3, S<=3
      when  nt2 is game_forcing
      sets  forcing=game
      priority -1
  3N  "16-17, balanced, no 4-card major"        shows balanced, points=16..17, H<=3, S<=3
      when  nt2 is game_forcing
      priority -1
  2H  "Strong jump shift: 15+, 5+ hearts"       shows H>=5, hcp>=15  when strong_js, !passed_hand
      sets forcing=game
  2S  "Strong jump shift: 15+, 5+ spades"       shows S>=5, hcp>=15  when strong_js, !passed_hand
      sets forcing=game

# With 2NT game forcing, 11-12 balanced bids a new minor first (2NT next).
after 1D (P) when nt2 is game_forcing
  2C  "11-12, balanced, no 4-card major: 2NT next"   shows balanced, points=11..12, C>=3, H<=3, S<=3
      sets forcing=round
      priority -1
after 1C (P) when nt2 is game_forcing
  1D  "11-12, balanced, no 4-card major: 2NT next"   shows balanced, points=11..12, D>=3, H<=3, S<=3
      sets forcing=round
      priority -1

# ── Over 1♥ / 1♠ ───────────────────────────────────────────────────────
after 1H (P)
  1S  "4+ spades, 6+ HCP"           shows S>=4, hcp>=6
      when  H<=2 | (style is not bba, (H=3, tp(H)>=11) | tp(H)>=13 | !limit_raise) | (style is bba, H=3, hcp>=11 | S>=6 | (hcp>=10, S>=5 | shortest<=2)), hcp<=10 | (S>=C, S>=D) | (hcp<=12, C<=5, D<=5)
      # 6-10 with 3+ hearts: raise; 11-12 with 4+: limit raise; 11+ with a longer minor: 2m first
      # (bba: with three hearts 1S from 11 HCP, or 10 with five spades or a doubleton; never with four hearts)
      sets forcing=round
  1N  "6-10 HCP, no heart fit, no 4 spades"   shows hcp=6..10, H<=2, S<=3
  2S  "Strong jump shift: 15+, 5+ spades"  shows S>=5, hcp>=15  when strong_js, !passed_hand
      sets forcing=game
  2C  "11+ points, 4+ clubs"           shows C>=4, points>=11 | C>=6 | (H>=3, tp(H)>=11), suit_points>=10, C>=D, S<=3 | (C>S, hcp>=13 | C>=6)
      when  H<=2 | (style is not bba, H=3 | tp(H)>=13) | (style is bba, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, H>=4))   # limit values and a fit: raise first
      sets forcing=round               # with 4 spades and no longer minor: 1S first
  2D  "11+ points, 4+ diamonds"        shows D>=4, points>=11 | D>=6 | (H>=3, tp(H)>=11), suit_points>=10, D>C, S<=3 | (D>S, hcp>=13 | D>=6)
      when  H<=2 | (style is not bba, H=3 | tp(H)>=13) | (style is bba, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, H>=4))
      sets forcing=round
  3H  "Limit raise: 11-12 support points, 3+ hearts"  shows H>=3, tp(H)=11..12 | (H>=4, tp(H)=10, shortest<=2), hcp<=12
      when limit_raise, H>=4 | S<=3, style is not bba
      priority -1                      # 3 hearts: a new suit, then a jump raise, when there is one
      sets trump=H
  3C  "Invitational jump shift: 10-12, 6+ clubs"     shows C>=6, points=10..12, H<=2  when inv_js
  3D  "Invitational jump shift: 10-12, 6+ diamonds"  shows D>=6, points=10..12, H<=2  when inv_js

after 1S (P)
  1N  "6-10 HCP, no spade fit"             shows hcp=6..10, S<=2
  2C  "11+ points, 4+ clubs"           shows C>=4, points>=11 | C>=6 | (S>=3, tp(S)>=11), suit_points>=10, C>=D, C>=H
      when  S<=2 | (style is not bba, S=3 | tp(S)>=13) | (style is bba, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, S>=4))   # limit values and a fit: raise first
      sets forcing=round
  2D  "11+ points, 4+ diamonds"        shows D>=4, points>=11 | D>=6 | (S>=3, tp(S)>=11), suit_points>=10, D>C, D>=H
      when  S<=2 | (style is not bba, S=3 | tp(S)>=13) | (style is bba, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, S>=4))
      sets forcing=round
  2H  "11+ points, 5+ hearts"          shows H>=5, points>=11 | H>=6 | (S>=3, tp(S)>=11), suit_points>=10
      when  S<=2 | (style is not bba, S=3 | tp(S)>=13) | (style is bba, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, S>=4))
      sets forcing=round
  3S  "Limit raise: 11-12 support points, 3+ spades"  shows S>=3, tp(S)=11..12 | (S>=4, tp(S)=10, shortest<=2), hcp<=12
      when limit_raise, style is not bba
      priority -1                      # 3 spades: a new suit, then a jump raise, when there is one
      sets trump=S
  2H  "10+ HCP, 5+ hearts (BBA)"       shows H>=5, hcp>=10, S<=2 | hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, S>=4)
      when  style is bba                 # BBA: ten HCP and five hearts are enough
      sets forcing=round
  3C  "Invitational jump shift: 10-12, 6+ clubs"     shows C>=6, points=10..12, S<=2  when inv_js
  3D  "Invitational jump shift: 10-12, 6+ diamonds"  shows D>=6, points=10..12, S<=2  when inv_js
  3H  "Invitational jump shift: 10-12, 6+ hearts"    shows H>=6, points=10..12, S<=2  when inv_js

after 1M (P)
  2M  "Raise: 6-10 support points, 3+ {M}"  shows M>=3, tp(M)=6..10, hcp>=6, M=3 | tp(M)<=9 | shortest>=3
      when  style is not bba
      sets trump=M
  4M  "Preemptive raise: 5+ {M}, weak" shows M>=5, hcp=5..9
      when  style is not bba
      sets trump=M
  2C  "Game values with a fit: a three-card minor to start"
      shows M>=3, tp(M)>=13, C>=3
      when  style is not bba
      sets  forcing=round
      priority -2                      # no four-card side suit: temporize, as BBA
  2D  "Game values with a fit: a three-card minor to start"
      shows M>=3, tp(M)>=13, D>=3, C<=2
      when  style is not bba
      sets  forcing=round
      priority -2
  # BBA's raises, probed (responses.notes.md, "BBA treatment"). HCP and
  # shape; tens count for nothing. Three trumps: a limit raise with 11-12
  # flat or 9-11 and a doubleton or shorter. Four: 2M up to 8, 3M 9-10,
  # and with a singleton or void (or 9-10 with a five-card suit and a
  # doubleton, or four controls) straight to game. A new suit, forcing:
  # 11 HCP with four trumps, 12 with three and a doubleton, else 13.
  2M  "Raise (BBA): 3+ {M}, 6-10 HCP flat or 6-8 with shortness"
      shows M>=3, hcp>=5, tp(M)<=11, (M=3, hcp>=6, hcp<=10, hcp<=8 | shortest>=3) | (M>=4, hcp<=8, tp(M) + M <= 14)
      when  style is bba
      sets trump=M
  3M  "Limit raise (BBA): three {M} and 11-12 flat or 9-11 with shortness, or four and 9-10"
      shows M>=3, (M=3, hcp=11..12, shortest>=3) | (M=3, hcp=9..11, shortest<=2, tp(M)<=13) | (M>=4, hcp=9..10, shortest>=2, shortest>=3 | controls<=3, shortest>=3 | longest<=4)
      shows M is S | S<=3 | hcp<=9     # three hearts, four spades and 10+: 1S
      when  limit_raise, style is bba
      sets trump=M
  4M  "Raise to game (BBA): four {M} and shortness, not the values to force"
      shows M>=4, (shortest<=1, hcp<=10, tp(M) + M >= 15) | (shortest=2, hcp=9..10, controls>=4 | longest>=5)
      when  style is bba
      sets trump=M
  2C  "Game values with a fit: a three-card minor to start"
      shows M>=3, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, M>=4), C>=3
      when  style is bba
      sets  forcing=round
      priority -2
  2D  "Game values with a fit: a three-card minor to start"
      shows M>=3, hcp>=13 | (hcp>=12, shortest<=2) | (hcp>=11, M>=4), D>=3, C<=2
      when  style is bba
      sets  forcing=round
      priority -2
  4M  "Game in the fit: 13+ support points"
      shows M>=3, tp(M)>=13
      priority -3                      # no three-card minor either
  2N  "11-12, balanced, no fit"        shows balanced, points=11..12, M<=2
      priority -1                      # a new suit first when there is one
  3N  "13-15, balanced"                shows balanced, points=13..15, M<=3
      priority -1

# ── Any one-level suit opening ─────────────────────────────────────────
after 1x (P)
  P   "Fewer than 6 HCP"               shows hcp<=5
      priority -10

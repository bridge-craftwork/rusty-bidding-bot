# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Opener's rebid after a one-level suit opening and an uncontested response
# (Standard American). Rick's rulings: 1NT rebid 12-14 HCP; a jump rebid of
# opener's suit or a jump raise of responder's suit 16-18 total points; a
# reverse 17+ with the first suit longer; a jump in a new suit 19+. The rest
# follows BBA's own meanings (see rebids.notes.md).
#
# Strength: notrump rebids in HCP; suit rebids in suit points (HCP + ½ per
# card beyond four); raises of partner's suit in support points, tp(y).
# Minimum rebids have no lower bound: the opening already showed it, and
# light openings (rule of 20) must still answer a forcing response.

module rebids "Opener's rebid"
  needs  responses
  skill  partnership_bidding/rebids
  skill  bidding_conventions/reverse_bids
  param  style = general.style
  param  new_suit_forcing = competitive.new_suit_after_overcall_forcing default true
  param  support_x = doubles.support.play default false
  param  support_through = doubles.support.through
  param  walsh = minor_openings.walsh.play default true

# A notrump jump reaches 3NT at most: the last bid is below 2NT, so the
# cheapest notrump bid is 2NT or lower. In a suit's terms: the cheapest
# spade bid is 2S or lower, or the last bid was 2S. Above that a jump in
# notrump is 4NT, which with no notrump bid by us is keycard (Rick,
# 2026-10-03; slam-entry.bid, "The keycard suit"). Used by every natural
# `jump(N)`.
define nt_jump_to_game = cheapest_rank(S) <= 13 | partner.last=2S | rho.last=2S

# ── After a one-level new-suit response ───────────────────────────────
after 1x (P) 1y (P)
  2y  "Raise: 4+ {y}, minimum"             shows y>=4, tp(y)<=15   sets trump=y
      when  style is not bba
  3y  "Jump raise: 4+ {y}, 16-18"          shows y>=4, tp(y)=16..18   sets trump=y
      when  y is H | y is S, style is not bba   # a major: 19+ jumps to game
  # BBA raises a major on HCP and length, not shortness: 2y up to 14,
  # 3y 15-17 (HCP + a point a card beyond four), game with 18 HCP or 17
  # and 19 support points (rebids.notes.md, "BBA treatment").
  2y  "Raise (BBA): 4+ {y}, minimum"       shows y>=4, hcp+length_points<=14   sets trump=y
      when  style is bba
  3y  "Jump raise (BBA): 4+ {y}, 15-17"    shows y>=4, hcp+length_points>=15, hcp<=17, hcp<=16 | tp(y)<=18   sets trump=y
      when  y is H | y is S, style is bba
  3y  "Jump raise: 4+ {y}, 16+"             shows y>=4, tp(y)>=16   sets trump=y
      when  y is C | y is D                  # a minor: there is no four-level game
  2x  "Rebids {x}: 6+, minimum"            shows x>=6, suit_points<=15
      priority -1                          # a new suit first
  3x  "Jump rebid: 6+ {x}, 16-18"          shows x>=6, suit_points=16..18
      when  style is not bba
      priority -1                          # a new suit first
  3x  "Jump rebid (BBA): 6+ {x}, 15-18"    shows x>=6, hcp=15..18
      when  style is bba
      priority -1
  2x  "Rebids {x}: five or more, too weak to reverse"
      shows x>=5, suit_points<=18
      when  x is C | x is D                 # 5-4-2-2 with 15-18: no other rebid
      priority -4
  1N  "12-14 HCP, balanced"                shows balanced | shape 5-4-2-2, hcp=12..14, y<=3
  2N  "18+ HCP, balanced"                  shows balanced | shape 5-4-2-2, hcp>=18, y<=3
  2N  "18-19 HCP, balanced"                shows balanced, hcp=18..19, y<=3
      priority 1                           # ahead of a jump shift or reverse, as BBA
  1N  "Minimum, no better rebid"           shows hcp<=14, y<=3
      priority -3                          # e.g. 5-4 with a singleton: no suit to rebid
  3x  "Jump rebid: 6+ {x}, too good for a simple rebid"
      shows x>=6, suit_points>=16
      priority -4                          # a long suit with 19+ and no 3NT or 4M
  2N  "15-17 balanced, no other rebid"     shows balanced, hcp=15..17, y<=3
      priority -4                          # 1NT would be a lie: the rebid is 12-14
after 1x (P) 1M (P)
  4M  "Game raise: 4+ {M}, 19+"            shows M>=4, tp(M)>=19   sets trump=M
      when  style is not bba
      priority 1                           # support first, ahead of a jump shift (BBA)
  4M  "Game raise (BBA): 4+ {M}, 18 HCP, or 17 and 19 support points"
      shows M>=4, hcp>=18 | (hcp>=17, tp(M)>=19)   sets trump=M
      when  style is bba

# A new suit: at the one level 4+ and up to 18; at the two level below the
# first suit 4+, not a reverse; a reverse (two level, above the first suit)
# 17+ with the first suit longer; a jump in a new suit 19+, game forcing.
after 1C (P) 1D (P)
  # Walsh (Rick, 2026-09-24; the modern default): balanced 12-14 rebids
  # 1NT even with one or both four-card majors. Standard, and any card
  # with the Walsh switch off (minor_openings.walsh.play, as BBA reads
  # it), bids a four-card major up the line, balanced or not.
  1N  "12-14 HCP, balanced (Walsh: a major may be hidden)"   shows balanced | shape 5-4-2-2, hcp=12..14
      when  style is not bba, style is not standard, walsh
      priority 2
  1N  "12-14 HCP, balanced, no four-card major"   shows balanced | shape 5-4-2-2, hcp=12..14, H<=3, S<=3
      when  style is standard | !walsh
      priority 2
  1H  "4+ hearts, up to 18"                shows H>=4, suit_points<=18, H>=S
      when  style is not bba | S>=4 | !walsh
  1S  "4+ spades, up to 18"                shows S>=4, suit_points<=18, S>H
      when  style is not bba | !walsh
  2H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
      when  style is not bba
  2S  "Jump shift: 4+ spades, 19+"         shows S>=4, suit_points>=19   sets forcing=game
      when  style is not bba
  # BBA (Walsh style: responder bypasses diamonds with a weak hand and a
  # major) rebids 1NT with 12-17 and one four-card major, even 5-4 with a
  # singleton; 1H only with both majors; a jump shift from 18.
  1N  "BBA: 12-17, no six clubs, not both majors"
      shows hcp=12..17, H<=4, S<=4, H<=3 | S<=3, C<=5, D<=4, shortest>=2 | C=5
      when  style is bba, walsh               # Walsh off: up the line, as above
      priority 2
  2H  "Jump shift (BBA): 4+ hearts, 18+"   shows H>=4, hcp>=18, H>=S   sets forcing=game
      when  style is bba
  2S  "Jump shift (BBA): 4+ spades, 18+"   shows S>=4, hcp>=18, S>H   sets forcing=game
      when  style is bba
after 1C (P) 1H (P)
  1S  "4+ spades, up to 18"                shows S>=4, suit_points<=18
      when  H<=3                           # four hearts: raise first
      priority 2                           # four spades: 1S before 1NT
  2D  "Reverse: 4+ diamonds, longer clubs, 17+"  shows D>=4, C>D, suit_points>=17  sets forcing=round
      priority 1
  2S  "Jump shift: 4+ spades, 19+"         shows S>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
after 1C (P) 1S (P)
  2D  "Reverse: 4+ diamonds, longer clubs, 17+"  shows D>=4, C>D, suit_points>=17  sets forcing=round
      priority 1
  2H  "Reverse: 4+ hearts, longer clubs, 17+"    shows H>=4, C>H, suit_points>=17  sets forcing=round
      priority 1
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
  3H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
after 1D (P) 1H (P)
  1S  "4+ spades, up to 18"                shows S>=4, suit_points<=18
      when  H<=3                           # four hearts: raise first
      priority 2                           # four spades: 1S before 1NT
  1N  "12-14 HCP, balanced"                shows balanced, hcp=12..14, H<=3
      when  style is not bba               # Rick: balanced rebids 1NT, not 2C
      priority 1
  1N  "12-13 HCP, balanced: four clubs too (BBA)"   shows balanced, hcp=12..13, H<=3, C=4
      when  style is bba
      priority 1                           # BBA: 1NT before 2C, but 2C with 14
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18, D>=C
  2S  "Jump shift: 4+ spades, 19+"         shows S>=4, suit_points>=19   sets forcing=game
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
after 1D (P) 1S (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18, D>=C
  1N  "12-14 HCP, balanced"                shows balanced, hcp=12..14, S<=3
      when  style is not bba               # Rick: balanced rebids 1NT, not 2C
      priority 1
  1N  "12-13 HCP, balanced: four clubs too (BBA)"   shows balanced, hcp=12..13, S<=3, C=4
      when  style is bba
      priority 1                           # BBA: 1NT before 2C, but 2C with 14
  2H  "Reverse: 4+ hearts, longer diamonds, 17+"  shows H>=4, D>H, suit_points>=17  sets forcing=round
      priority 1
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
after 1H (P) 1S (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2D  "4+ diamonds, up to 18"              shows D>=4, suit_points<=18, D>=C | C<=3
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game

# ── After 1NT (not forcing) ──────────────────────────────────────────
after 1x (P) 1N (P)
  P   "Minimum, nothing more to show"      shows suit_points<=15
      priority -5
  P   "Balanced, no game opposite 6-10"    shows balanced, hcp<=17
      priority -1                          # BBA passes 5-3-3-2 with 16-17 (major-rebid-1S-1N.toml)
  2x  "Rebids {x}: five or more, too good to pass and no reverse"
      shows x>=5, suit_points=16..18
      priority -2                          # 5-4 with 16-18: a reverse needs 17
  2x  "Rebids {x}: 6+, minimum"            shows x>=6, suit_points<=15
      priority -1
  3x  "Jump rebid: 6+ {x}, 16-18"          shows x>=6, suit_points=16..18
      when  style is not bba
      priority -1
  2N  "18-19 HCP, balanced"                shows balanced, hcp=18..19
  # 4-4-4-1 with 18+ and no suit to reverse into or jump in had no call
  # (Basic_Minor 78, AQJT.K765.AK72.Q: BBA 3NT).
  3N  "18+: game, no better description"   shows hcp>=18
      priority -3
  3x  "Jump rebid (BBA): 6+ {x}, 15-18"    shows x>=6, hcp=15..18
      when  style is bba
      priority -1
after 1S (P) 1N (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2D  "4+ diamonds, up to 18"              shows D>=4, suit_points<=18, D>=C | C<=3
  2H  "4+ hearts, up to 18"                shows H>=4, suit_points<=18
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
  3H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
  # BBA jumps sooner: 17 suit points in hearts, 18 in a minor; 5-5 with
  # 16 bids game in hearts.
  3H  "Jump shift (BBA): 4+ hearts, 17+"   shows H>=4, suit_points>=17   sets forcing=game
      when  style is bba
      priority 1
  3C  "Jump shift (BBA): 4+ clubs, 18+"    shows C>=4, suit_points>=18   sets forcing=game
      when  style is bba
      priority 1
  3D  "Jump shift (BBA): 4+ diamonds, 18+"  shows D>=4, suit_points>=18   sets forcing=game
      when  style is bba
      priority 1
  4H  "5-5 in the majors, 16+ (BBA)"       shows H>=5, hcp>=16   sets trump=H
      when  style is bba
      priority 1
after 1H (P) 1N (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2D  "4+ diamonds, up to 18"              shows D>=4, suit_points<=18, D>=C | C<=3
  2S  "Reverse: 4+ spades, longer hearts, 17+"   shows S>=4, H>S, suit_points>=17  sets forcing=round
      priority 1
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
  3C  "Jump shift (BBA): 4+ clubs, 18+"    shows C>=4, suit_points>=18   sets forcing=game
      when  style is bba
      priority 1
  3D  "Jump shift (BBA): 4+ diamonds, 18+"  shows D>=4, suit_points>=18   sets forcing=game
      when  style is bba
      priority 1
after 1D (P) 1N (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2H  "Reverse: 4+ hearts, longer diamonds, 17+"  shows H>=4, D>H, suit_points>=17  sets forcing=round
      priority 1
  2S  "Reverse: 4+ spades, longer diamonds, 17+"  shows S>=4, D>S, suit_points>=17  sets forcing=round
      priority 1
after 1C (P) 1N (P)
  2D  "Reverse: 4+ diamonds, longer clubs, 17+"  shows D>=4, C>D, suit_points>=17  sets forcing=round
      priority 1
  2H  "Reverse: 4+ hearts, longer clubs, 17+"    shows H>=4, C>H, suit_points>=17  sets forcing=round
      priority 1
  2S  "Reverse: 4+ spades, longer clubs, 17+"    shows S>=4, C>S, suit_points>=17  sets forcing=round
      priority 1

# ── Too strong for a jump rebid ──────────────────────────────────────
# A jump rebid of our own suit is 16-18, so 19+ with a one-suiter had no
# rebid at all and passed a forcing response. BBA plays these as 3NT with
# a long minor ("calculated bid: 18 to 21 total points, 6+ clubs"), and
# game in a long major.
#
# A major's jump to game is not made once the response forced to game (a
# two-over-one, a strong jump shift): there the jump to game is the
# minimum (fast arrival), and with 19+ opposite a game force slam is in
# the air (2026-09-30, random deals: 1H 2S 4H with 20 HCP facing 15,
# where responder passed 35 between us). The minor's 3NT stays: its
# 18-21 is what over-3nt.bid counts to 6NT, and without it opener had
# only base.bid's bare 3NT (corpus: -1,027 on 465 boards).
after 1m (P) 1y (P) | 1m (P) 2y (P)
  3N  "18-21 with six or more {m}: to play"
      shows m>=6, hcp=18..21
      when  y is not m
after 1M (P) 1y (P) | 1M (P) 2y (P)
  4M  "19+ with six or more {M}: game"
      shows M>=6, hcp+length_points>=19
      when  y is not M, style is not bba, !we.gf
  4M  "Game (BBA): seven {M} and 13+, or six and 19+"
      shows M>=6, (M>=7, hcp>=13) | hcp>=19
      when  y is not M, style is bba, !we.gf
# The same two rules after a 1NT response. They cannot share the context
# above: `y` is bound by the other alternatives only, and a `when` that
# names it can never be decided after 1NT, so the rules never fired.
after 1m (P) 1N (P)
  3N  "18-21 with six or more {m}: to play"
      shows m>=6, hcp=18..21
# A forcing 1NT (2/1 cards with `one_nt_response.forcing`, 6-12): opener
# may not pass, so a balanced hand bids its longer minor, three cards if
# need be, and 18-19 bids 2NT (2026-09-30, 2/1 game force).
after 1M (P) 1N (P) when we.forcing = round
  2C  "Forcing 1NT: three or more clubs"   shows C>=3, C>=D, suit_points<=18, M<=5
      priority -1
  2D  "Forcing 1NT: three or more diamonds"  shows D>=3, D>C, suit_points<=18, M<=5
      priority -1
  2N  "Forcing 1NT: 18-19, balanced"       shows balanced, hcp=18..19
  # Six, or five when the hand has no three-card minor to bid (5-4-2-2
  # with the other major): the forced rebid, read as either.
  2M  "Rebids {M}: six, or five with no three-card minor, minimum"
      shows M>=5, suit_points<=15, M>=6 | (C<=2, D<=2)
after 1M (P) 1N (P)
  4M  "19+ with six or more {M}: game"
      shows M>=6, hcp+length_points>=19
      when  style is not bba
  4M  "Game (BBA): seven {M} and 13+, or six and 19+"
      shows M>=6, (M>=7, hcp>=13) | hcp>=19
      when  style is bba

# ── After a raise ────────────────────────────────────────────────────
# With a fit found, opener counts support points tp(x): BBA bids game over a
# simple raise with 16-18 and a singleton, but passes 14-15 with doubletons.
# A raise that can hold 11-12 (a card without the limit raise:
# responses.bid) is invited from 15 (responses.notes.md, 2026-09-30).
after 1x (P) 2x (P)
  P   "Minimum: no game"                   shows tp(x)<=16, tp(x)<=14 | x is C | x is D | partner.tp(x).max<=10
      when  style is not bba | x is C | x is D
      priority -5
  3x  "Invitation: 17-18 with the fit (15-18 opposite a raise to 12)"
      shows tp(x)=17..18 | (tp(x)=15..16, x is H | x is S, partner.tp(x).max>=11)
      when  style is not bba | x is C | x is D
after 1M (P) 2M (P)
  4M  "Game: 19+ with the fit"             shows tp(M)>=19
      when  style is not bba
  # BBA opposite a raise: pass up to 15 HCP whatever the shape (13 with
  # six trumps), invite with 16 (14-15 with six), bid game with 17, or 16
  # and six trumps or a singleton.
  P   "Minimum (BBA): up to 15 HCP"        shows hcp<=15, M<=5 | hcp<=13
      when  style is bba
      priority -5
  3M  "Invitation (BBA): 16 HCP, or 14-15 with six trumps"
      shows (hcp=16, M<=5, tp(M)<=18) | (hcp=14..15, M>=6)
      when  style is bba
  4M  "Game (BBA): 17+, or 16 with six trumps or shortness"
      shows hcp>=17 | (hcp=16, M>=6 | tp(M)>=19)
      when  style is bba
after 1m (P) 2m (P)
  2N  "18-19 HCP, balanced"                shows balanced, hcp=18..19
  3N  "20-21 HCP, balanced"                shows balanced, hcp>=20
  # Counting tricks (Rick, 2026-09-27, ticket b469: K2.A9.AT.AKJ9742
  # passed 1C P 2C): with partner's support a long minor headed by two
  # top honours runs, and stoppers in the other three suits make up the
  # nine tricks in notrump.
  3N  "Nine tricks: a running {m}, the other suits stopped"
      shows m>=6, quality(m)>=2, hcp>=16
      shows stop(C) | m is C, stop(D) | m is D, stop(H), stop(S)
  5{m} "Game: 19+ support points, no notrump"   shows tp(m)>=19
      priority -1

after 1M (P) 3M (P)
  4M  "Accepts the limit raise"            shows tp(M)>=15
  P   "Declines: minimum"                  shows tp(M)<=14
after 1m (P) 3m (P)
  3N  "Accepts, balanced: 14+"             shows hcp>=14, balanced | semibalanced
  5m  "Accepts, unbalanced: game in the minor"   shows hcp>=14
      priority -1
  P   "Declines: minimum"                  shows hcp<=13
      priority -5

after 1m (P) 2N (P)
  3N  "Accepts: 14+"                       shows hcp>=14
  P   "Declines: 12-13"                    shows hcp<=13
      priority -5

# Responder's game-forcing 2NT after a two-over-one and opener's rebid
# (16+, no fit: responder-rebids.bid): opener counts slam on it, with
# over-3nt.bid's numbers for this shape (2026-09-30).
after 1y (P) 2x (P) 2z (P) 2N (P) when x is not y, we.gf
  6N  "Slam: 33+ points between us (partner at his minimum)"
      shows points + partner.points.min >= 33
      priority 1
  4N  "Quantitative: 31-32 points between us"
      shows points + partner.points.min >= 31
      sets  ask=quant
      priority 1
  3N  "Game: no extras"                    shows points + partner.points.min <= 30

# ── After a two-over-one response (forcing one round) ────────────────
after 1M (P) 2x (P) when x is not M
  2M  "Rebids {M}: 5+, minimum"            shows M>=5, suit_points<=15
      priority -1                          # the default minimum rebid
  2M  "Rebids {M}: five or more, too weak to reverse"
      shows M>=5, suit_points<=18
      priority -2
  3M  "Jump rebid: 6+ {M}, 16-18"          shows M>=6, suit_points=16..18
  3x  "Raise: 4+ {x}"                      shows x>=4
      sets  trump=x                        # agreed: keycard and the fit follow (ticket b173)
  2N  "15-17 HCP, balanced"                shows balanced, hcp=15..17
      priority -2                          # a 5-3-3-2 minimum rebids its major
  3N  "18-19 HCP, balanced"                shows balanced, hcp=18..19
after 1S (P) 2C (P)
  2D  "4+ diamonds"                        shows D>=4
  2H  "4+ hearts"                          shows H>=4
after 1S (P) 2D (P)
  2H  "4+ hearts"                          shows H>=4
  3C  "4+ clubs, extras"                   shows C>=4, suit_points>=16
after 1S (P) 2H (P)
  3H  "Raise: 3+ hearts"                   shows H>=3
  4H  "Game raise: 3+ hearts, 14-17"       shows H>=3, suit_points=14..17
  3C  "4+ clubs, extras"                   shows C>=4, suit_points>=16
  3D  "4+ diamonds, extras"                shows D>=4, suit_points>=16
after 1H (P) 2C (P)
  2D  "4+ diamonds"                        shows D>=4
  2S  "Reverse: 4+ spades, longer hearts, 17+"   shows S>=4, H>S, suit_points>=17  sets forcing=round
      priority 1
after 1H (P) 2D (P)
  2S  "Reverse: 4+ spades, longer hearts, 17+"   shows S>=4, H>S, suit_points>=17  sets forcing=round
      priority 1
  3C  "4+ clubs, extras"                   shows C>=4, suit_points>=16
after 1D (P) 2C (P)
  2D  "Rebids diamonds: minimum"           shows D>=5, suit_points<=15
      priority -1
  3D  "Jump rebid: 6+ diamonds, 16-18"     shows D>=6, suit_points=16..18
      priority -1
  2D  "Rebids diamonds: five or more, no better rebid"
      shows D>=5, suit_points<=18
      priority -2
  3C  "Raise: 4+ clubs"                    shows C>=4
  2H  "4+ hearts"                          shows H>=4
  2S  "4+ spades"                          shows S>=4
  2N  "12-14 HCP, balanced"                shows balanced, hcp=12..14
  3N  "18-19 HCP, balanced"                shows balanced, hcp=18..19

# ── After a reverse over 1NT and responder's preference at three ─────
# Responder has 6-10 and two or more of opener's first suit; opener had
# no third call (Basic_Major 270, 1D-1NT-2S-3D with 20 and 6-5).
after 1x (P) 1N (P) 2z (P) 3x (P) when z is not x
  4x  "Game in the fit: 19+"               shows suit_points>=19
      when  x is H | x is S
  5x  "Game in {x}: 19+ with six"          shows x>=6, suit_points>=20
      when  x is C | x is D
  3N  "Game in notrump: 19+"               shows hcp>=19
      when  x is C | x is D
  P   "Minimum for the reverse: play three" shows suit_points<=19
      priority -5

# ── After an invitational jump shift (10-12, six cards) ──────────────
after 1x (P) 3y (P) when y is not x, we.trump is none   # not a splinter (splinters.bid)
  P   "Minimum, no fit"                    shows hcp<=13
      priority -5
  # With a fit for a minor 3NT is still the game (Basic_Major 44 and 121,
  # and 1H-3D with four diamonds, had no call).
  3N  "Accepts: 14+, to play notrump"      shows hcp>=14, y<=2 | y is C | y is D
  4y  "Accepts in the fit: 14+"            shows y>=2, suit_points>=14
      when  y is H | y is S
  4x  "Accepts in my own suit: seven, or six with four top honours"
      shows x>=7 | (x>=6, top5(x)>=4), hcp>=14, y<=1 | y is C | y is D
      when  x is H | x is S

# ── Responder bid a fourth suit at the one level ─────────────────────
# 1♣-1♦-1♥-1♠ is natural on this card, and opener had no third call at
# all. He raises with four, and otherwise shows his shape once more. The
# fourth suit at the one level is always a major, so it binds to `M`.
after 1x (P) 1y (P) 1z (P) 1M (P)
  2M  "Raise: 4+ {M}, minimum"             shows M>=4, tp(M)<=15   sets trump=M, ask=signoff
  3M  "Jump raise: 4+ {M}, 16-18"          shows M>=4, tp(M)=16..18   sets trump=M, ask=invite(M)
  4M  "Game raise: 4+ {M}, 19+"            shows M>=4, tp(M)>=19   sets trump=M
  1N  "Minimum, no fit for {M}"            shows M<=3, hcp<=15   sets ask=signoff
  2N  "16-18, no fit for {M}"              shows M<=3, hcp=16..18   sets ask=nt_invite
  2x  "Six or more {x}"                    shows x>=6, suit_points<=15   sets ask=signoff
      priority -1

# ── Partner has signed off ───────────────────────────────────────────
# Responder's weak second calls — a preference, a weak rebid of his own
# suit, a raise of opener's second suit, 1NT — say "play here", and set
# `ask=signoff` (responder-rebids.bid). Opener's answer is the same
# whatever the auction was, so it is written once against the ask rather
# than as the dozen eight-call patterns it would otherwise take: pass
# with a minimum, one more try with 16-18, game with 19+.
when asked signoff, !partner.opened
  P   "Nothing to add: partner is limited"
      priority -5
  2x  "Six or more {x}: a better spot"        shows x>=6, suit_points<=15
      when  maybe partner.x<=2
      sets  ask=signoff
      priority -1
  3x  "Six or more {x}, 16-18: one more try"  shows x>=6, suit_points=16..18
      sets  ask=invite(x)
  3x  "Raise: 16-18 with the fit"             shows x>=3, suit_points=16..18
      when  partner.x>=5
      sets  ask=invite(x)
  2y  "Preference: three or more {y}"         shows y>=3
      when  partner.y>=5
      sets  ask=signoff
      priority -2
  4M  "Game: 6+ {M}, 19+"                     shows M>=6, suit_points>=19
  4M  "Game in the fit: 19+"                  shows M>=3, suit_points>=19
      when  partner.M>=4

# The same question put to responder, by opener's minimum rebid in a
# contested auction. The rules above are opener's: read as responder's,
# their 3x ("six or more, one more try") took over responder's cue bid
# and opener raised their suit (2026-09-25). Responder's own
# continuations are in responder-rebids.bid; this is the pass under them.
when asked signoff, partner.opened
  P   "Nothing to add: partner's rebid was a minimum"
      priority -5

# ── Answering an invitation in a major ───────────────────────────────
# Any invitation in a major sets `ask=invite(M)`: responder's invitational
# raise or jump in a suit auction, 2NT or 3M after a transfer, a raise
# after Stayman. Play in the major with an eight-card fit, which is 3+
# cards opposite five and 2+ opposite six. Without a fit accept only when
# game is certain (17 opposite 8-9); with the fit one point less is
# enough (16), which par prefers by 1,300 IMPs over the corpus. Until
# 2026-09-30 this lived in jacoby-transfers.bid, so a card without
# transfers had no answer to 1♦-1♥-2♥-3♥ and its relatives
# (rebids.notes.md, "The major invitation without transfers").
when asked invite(M)
  4M  "Accepts, in the fit"             shows M>=8-partner.M.min, points>=24-partner.points.min
  3N  "Accepts, no fit"                 shows M<8-partner.M.min, strength>=game
  3M  "Declines, in the fit"            shows M>=8-partner.M.min, points<=23-partner.points.min
  P   "Declines"                        shows strength<=invite, (M<8-partner.M.min | points<=23-partner.points.min)

# When the invitation was a raise it showed support points, not total
# points, so `partner.points` above stays at the one-level response's 6
# and opener never accepted (1♣-1♠-2♠-3♠ with 14). Opposite a raise
# showing 10+ support points opener counts his own the same way: game
# from 25 between them, 14 opposite 11-12, as BBA (rebids.notes.md).
when asked invite(M), partner.tp(M).min>=10
  4M  "Accepts: 25 support points between us"   shows M>=8-partner.M.min, tp(M)>=25-partner.tp(M).min
      priority 1
  P   "Declines: a minimum"                     shows M>=8-partner.M.min, tp(M)<=24-partner.tp(M).min
      priority 1

# Responder after opener declines in three of the major: pass.
when answered invite(M), partner.last=3{M}
  P   "Partner declined: play three of the major"

# ── Answering an invitation in a minor ───────────────────────────────
# Responder's invitational raise or jump sets `ask=invite(x)`. A minor
# invitation had no answer anywhere, so opener passed a live auction.
# Opposite 10-12, opener needs 14 to go on, and there is no game below 5 of a
# minor: 3NT with the values and a shape for it, 5 of the minor with
# real extras, otherwise pass.
when asked invite(m)
  P   "Declines: no more than a minimum"
      priority -5
  3N  "Accepts, in notrump: 14+ and a shape for it"
      shows hcp>=14, balanced | semibalanced
  5m  "Accepts in {m}: 18+ with the fit"      shows hcp>=18, m>=5

# ══ Opener's rebid once they come in ═════════════════════════════════
#
# Everything above is keyed on `after 1x (P) 1y (P)` and its relatives,
# so none of it fires once the opponents act: opener had no second call
# in any contested auction. That was the largest cluster of dead
# auctions left in the corpus (about 20,000 boards) and, wherever our
# own rules made partner's free bid forcing, the largest source of
# `passed a forcing auction` too.
#
# What opener does with his own hand — raise partner, rebid his suit,
# bid the game — does not depend on what they bid, so these blocks are
# written with `(*)` for their calls and with relative calls
# (`cheapest`, `jump`) so the level takes care of itself. The two things
# that do depend on their call are handled without naming it:
#
#   - **never bid a suit they have shown.** `maybe lho.x<=4` is "LHO has
#     not shown five", which is false after an overcall in that suit and
#     true after a takeout double. Knowledge does the work a pattern
#     variable would have done, and it is right over a double, an
#     overcall, a cue bid or a jump alike.
#   - **notrump needs a stopper**, and a stopper needs their suit bound.
#     Those rules are the one place a pattern names it, in blocks of
#     their own below; over a takeout double there is no suit to stop.
#
# Strength is measured as it is uncontested — notrump in HCP, suit
# rebids in suit points, raises in support points — and Rick's ladder is
# unchanged: 1NT 12-14, a jump rebid or jump raise 16-18, a reverse 17+,
# a jump in a new suit 19+. Partner's free bid is worth about what an
# uncontested response is worth, so the same numbers apply.

# ── Partner made a free bid in a new suit at the one level ───────────
# BBA never passes here, over an overcall or over a double (49 of 49
# positions in the Basic-Bridge scenarios), so the block ends with a
# rebid of opener's own suit rather than a pass when RHO has passed.
after 1x (*) 1z (*) when they.bid, z is not x
  cheapest(z) "Raise: four or more {z}, minimum"
      shows z>=4, tp(z)<=15
      when  partner.z>=4
      sets  trump=z, ask=signoff
  jump(z) "Jump raise: four or more {z}, 16-18"
      shows z>=4, tp(z)=16..18
      when  partner.z>=4, z is H | z is S
      sets  trump=z, ask=invite(z)
  jump(z) "Jump raise: four or more {z}, 16+"
      shows z>=4, tp(z)>=16
      when  partner.z>=4, z is C | z is D
      sets  trump=z
  4{z} "Game raise: four or more {z}, 19+"
      shows z>=4, tp(z)>=19
      when  partner.z>=4, z is H | z is S
      sets  trump=z
  cheapest(x) "Rebids {x}: six or more, minimum"
      shows x>=6, suit_points<=15
      sets  ask=signoff
      priority -1
  jump(x) "Jump rebid: six or more {x}, 16-18"
      shows x>=6, suit_points=16..18
      sets  ask=invite(x)
      priority -1
  4{x} "Game: six or more {x}, 19+"
      shows x>=6, suit_points>=19
      when  x is H | x is S
  P   "Nothing to say: they have bid again"  priority -10
# Their pass leaves partner's free bid unanswered, and it is not a call
# opener may leave: with nothing else, he repeats his own suit.
after 1x (*) 1z (P) when they.bid, z is not x
  # A second suit, when neither opponent has shown it: at the one level
  # four cards, at the two level four cards below opener's first suit,
  # and above it a reverse, 17+ with the first suit longer.
  1H  "Four or more hearts, up to 18"
      shows H>=4, suit_points<=18
      when  x is not H, z is not H
      when  maybe lho.H<=4, maybe rho.H<=4
  1S  "Four or more spades, up to 18"
      shows S>=4, suit_points<=18
      when  x is not S, z is not S
      when  maybe lho.S<=4, maybe rho.S<=4
  cheapest(C) "Four or more clubs, up to 18"
      shows C>=4, suit_points<=18
      when  x is not C, z is not C
      when  maybe lho.C<=4, maybe rho.C<=4
      priority -2
  cheapest(D) "Four or more diamonds, up to 18"
      shows D>=4, suit_points<=18
      when  x is H | x is S
      when  z is not D
      when  maybe lho.D<=4, maybe rho.D<=4
      priority -2
  2H  "Reverse: four or more hearts, longer {x}, 17+"
      shows H>=4, x>H, suit_points>=17
      when  x is C | x is D
      when  z is not H
      when  maybe lho.H<=4, maybe rho.H<=4
      sets  forcing=round
  2S  "Reverse: four or more spades, longer {x}, 17+"
      shows S>=4, x>S, suit_points>=17
      when  x is not S, z is not S
      when  maybe lho.S<=4, maybe rho.S<=4
      sets  forcing=round
  2D  "Reverse: four or more diamonds, longer clubs, 17+"
      shows D>=4, C>D, suit_points>=17
      when  x is C, z is not D
      when  maybe lho.D<=4, maybe rho.D<=4
      sets  forcing=round
  cheapest(x) "Rebids {x}: five or more, nothing better to say"
      shows x>=5, suit_points<=18
      sets  ask=signoff
      priority -4
  cheapest(x) "Partner's free bid needs an answer"
      priority -6

# Notrump is the one rebid that has to know which suit they bid, so it
# is written with their call bound. Over a takeout double there is no
# suit to stop and the range is the same.
after 1x (1y) 1z (P) | 1x (2y) 1z (P) when y is not x, z is not x, z is not y
  cheapest(N) "12-14 balanced with a stopper in {y}"
      shows balanced | shape 5-4-2-2, hcp=12..14, z<=3
      when  stop(y)
      sets  ask=signoff
  jump(N) "18-19 balanced with a stopper in {y}"
      when  nt_jump_to_game                  # 3NT at most (rebids.bid)
      shows balanced, hcp=18..19, z<=3
      when  stop(y)
  # Strong hands with nothing else to bid (2026-09-25: 19-counts repeated
  # a five-card suit and were passed): 3NT with their suit held, else a
  # cue bid of their suit, forcing to game.
  3N  "Game: 19+ with a stopper in {y}"
      shows hcp>=19, stop(y), z<=3
      priority -1
  cheapest(y) "Cue bid: 19+, forcing to game"
      alert  artificial
      shows suit_points>=19
      sets  forcing=game
      priority -3
after 1x (X) 1z (P) when z is not x
  cheapest(N) "12-14 balanced"
      shows balanced | shape 5-4-2-2, hcp=12..14, z<=3
      sets  ask=signoff
  jump(N) "18-19 balanced"
      when  nt_jump_to_game                  # 3NT at most (rebids.bid)
      shows balanced, hcp=18..19, z<=3

# Opener with 18+ after 1x (X) 1z (1w): double, the strong hand, as BBA
# (2026-09-27, ticket b6: 18 balanced passed 1C X 1D 1S). Responder's
# answers are in responder-rebids.bid.
# Where the double is a support double (support-doubles.bid: partner's
# major, their call no higher than the card's `through`), it is not
# this one: with support doubles on BBA doubles with three of partner's
# major at any strength and never with 18+ otherwise
# (probes/support-x-1C-X-1H-1S.toml).
after 1x (X) 1z (1y) when z is not x, y is not x, y is not z
  X   "18+: a strong hand, more to say"
      shows hcp>=18
      when  !support_x | z is C | z is D | !((support_through is none, rho.last <= 2{z}) | rho.last <= support_through)
      priority -2
after 1x (X) 1z (1y) X (P) * (P) when z is not x, y is not x, y is not z, !answered support
  cheapest(N) "18-19 balanced with a stopper in {y}"
      shows balanced, hcp=18..19, stop(y)
  3N  "20+ balanced with a stopper in {y}"
      shows balanced, hcp>=20, stop(y)
  cheapest(x) "Six or more {x}, the strong hand"
      shows x>=6
      priority -1
  P   "Partner's answer is as far as we go"
      priority -5

# ── Partner made a free bid in a new suit at the two level or higher ─
# Partner has 8-10 or more and five cards, and on the cards where a new
# suit over interference is forcing (`competitive.new_suit_after_
# overcall_forcing`, on by default and off on Basic-Bridge) opener must
# bid: those auctions were 1,438 of the corpus's 1,838 broken forces.
# Where it is not forcing, BBA passes a minimum with no fit about a
# third of the time, and that is the `P` at the foot of the block — the
# engine drops it of its own accord when the auction is forcing.
after 1x (*) 2z (*) | 1x (*) 3z (*) | 1x (*) 4z (*) when they.bid, z is not x
  cheapest(z) "Raise: three or more {z} for partner's five"
      shows z>=3, tp(z)<=17
      when  partner.z>=5
      sets  trump=z, ask=signoff
  cheapest(z) "Raise: four or more {z}, minimum"
      shows z>=4, tp(z)<=17
      when  partner.z>=4, maybe partner.z<=4
      sets  trump=z, ask=signoff
  4{z} "Game raise: 18+ with the fit"
      shows z>=3, tp(z)>=18
      when  partner.z>=4, z is H | z is S
      sets  trump=z
  cheapest(x) "Rebids {x}: six or more, minimum"
      shows x>=6, suit_points<=15
      sets  ask=signoff
      priority -1
  jump(x) "Jump rebid: six or more {x}, 16-18"
      shows x>=6, suit_points=16..18
      sets  ask=invite(x)
      priority -1
  4{x} "Game: six or more {x}, 19+"
      shows x>=6, suit_points>=19
      when  x is H | x is S
  P   "Minimum with no fit: partner's bid was limited"
      shows suit_points<=15
      priority -4                          # BBA passes these ahead of 2NT
  cheapest(x) "Rebids {x}: five or more, nothing better to say"
      shows x>=5
      sets  ask=signoff
      priority -6
  # Where the free bid is forcing, opener had no call with a four-card
  # major, a raise with extras, or nothing at all (2026-09-25: 80
  # no-rule positions such as 1D (1H) 2C (P) on K643.K.KQ32.AJ62).
  cheapest(S) "Four or more spades"
      shows S>=4, suit_points<=18
      when  x is not S, z is not S
      when  maybe lho.S<=4, maybe rho.S<=4
      when  we.forcing = round, partner.z>=5   # a free bid, not a cue bid of their suit
      priority -2
  cheapest(H) "Four or more hearts"
      shows H>=4, suit_points<=18
      when  x is not H, z is not H
      when  maybe lho.H<=4, maybe rho.H<=4
      when  we.forcing = round, partner.z>=5   # a free bid, not a cue bid of their suit
      priority -2
  cheapest(z) "Raise with extras: 18+, forcing to game"
      shows z>=3, tp(z)>=18
      sets  trump=z, forcing=game
      when  partner.z>=5, new_suit_forcing   # a forcing free bid, even if they bid over it
      priority -1
  cheapest(x) "Forced to bid: nothing better to say"
      when  we.forcing = round, partner.z>=5   # a free bid, not a cue bid of their suit
      priority -8
  P   "Nothing to say"  priority -10
after 1x (1y) 2z (P) | 1x (2y) 2z (P) | 1x (2y) 3z (P) | 1x (3y) 3z (P) when y is not x, z is not x, z is not y
  cheapest(N) "Balanced with a stopper in {y}, minimum"
      shows balanced | shape 5-4-2-2, hcp<=15, z<=3
      when  stop(y)
      sets  ask=signoff
      priority -5                          # below the pass: only when forced
  jump(N) "16-18 balanced with a stopper in {y}"
      when  nt_jump_to_game                  # 3NT at most (rebids.bid)
      shows balanced, hcp=16..18, z<=3
      when  stop(y)
  # Strong hands (2026-09-25): 3NT with their suit held, else a cue bid.
  3N  "Game: 17+ with a stopper in {y}"
      shows hcp>=17, stop(y)
      priority -1
  cheapest(y) "Cue bid: 18+, forcing to game"
      alert  artificial
      shows suit_points>=18
      sets  forcing=game
      priority -3
after 1x (X) 2z (P) when z is not x
  cheapest(N) "Balanced, minimum"
      shows balanced | shape 5-4-2-2, hcp<=15, z<=3
      sets  ask=signoff
      priority -5                          # below the pass: only when forced

# ── Partner raised opener's suit ─────────────────────────────────────
# The raise is 6-9 over an overcall and 4-9 over a double, close enough
# to the uncontested 6-10 that the same ladder applies: pass up to 16
# support points, invite with 17-18, bid the game with 19. BBA passes
# these hands about two thirds of the time.
after 1x (*) 2x (*) when they.bid
  P   "Minimum: no game"
      shows tp(x)<=16
      priority -5
  cheapest(x) "Invitation: 17-18 with the fit"
      shows tp(x)=17..18
      sets  trump=x, ask=invite(x)
  4{x} "Game: 19+ with the fit"
      shows tp(x)>=19
      when  x is H | x is S
      sets  trump=x
  3N  "Game: 19+ balanced, nowhere else to play"
      shows balanced, hcp>=19
      when  x is C | x is D
  P   "Nothing to say"  priority -10
# A jump raise over their call is preemptive, so opener bids the game or
# lets it alone.
after 1x (*) 3x (*) when they.bid
  4{x} "Game: 19+ opposite a preemptive raise"
      shows tp(x)>=19
      when  x is H | x is S
      sets  trump=x
  5{x} "Game: 19+ opposite a preemptive raise"
      shows tp(x)>=19
      when  x is C | x is D
      sets  trump=x
  P   "Nothing to add to a preemptive raise"  priority -10
# Over a two-level overcall three of opener's suit is often the cheapest
# raise, 7-10, not a jump; it was read as preemptive, so 16-21 passed
# (2026-09-26: 51 corpus boards with 25+ HCP and game on).
after 1x (2y) 3x (P) when y is not x, !partner.jumped
  3N  "Game: 16+ with a stopper in {y}"   shows hcp>=16, stop(y)
      when  x is C | x is D
  4{x} "Game: 17+ support points"          shows tp(x)>=17
      when  x is H | x is S
  5{x} "Game in the minor: 18+"            shows hcp>=18
      when  x is C | x is D
      priority -1
# Partner raised a minor to four over their preempt (7-10, three-card
# support): game with 16+ (2026-09-25: no rule; 1C (3S) 4C with 18).
after 1x (*) 4x (*) when they.bid, x is C | x is D
  5{x} "Game: 16+ with the fit"             shows hcp>=16
      sets  trump=x
  P   "No game"                            shows hcp<=15
      priority -10

# ── Partner bid notrump over their call ──────────────────────────────
# 1NT here is 6-10 with a stopper in their suit, so opener passes a
# minimum, repeats a six-card suit, and jumps with 16-18.
after 1x (*) 1N (*) when they.bid
  P   "Minimum: partner is limited"
      shows suit_points<=15
      priority -5
  cheapest(x) "Rebids {x}: six or more, minimum"
      shows x>=6, suit_points<=15
      sets  ask=signoff
      priority -1
  jump(x) "Jump rebid: six or more {x}, 16-18"
      shows x>=6, suit_points=16..18
      sets  ask=invite(x)
      priority -1
  jump(N) "18-19 balanced"
      when  nt_jump_to_game                  # 3NT at most (rebids.bid)
      shows balanced, hcp=18..19
  4{x} "Game: six or more {x}, 19+"
      shows x>=6, suit_points>=19
      when  x is H | x is S
  # Partner's 1NT promised their suit stopped, so opener raises notrump
  # with any shape (2026-09-26: 17-20 counts passed 1NT, 35 corpus boards
  # with 25+ HCP and game on).
  cheapest(N) "16-17: invites 3NT"
      shows hcp=16..17
      when  !lho.last=X                    # over an overcall: partner holds their suit
      sets  ask=nt_invite
      priority -2
  jump(N) "18+: game opposite 6-10"
      when  nt_jump_to_game                  # 3NT at most (rebids.bid)
      shows hcp>=18
      when  !lho.last=X                    # over an overcall: partner holds their suit
      priority -2
  P   "Nothing to say"  priority -10

# ── Partner redoubled ────────────────────────────────────────────────
# The redouble is 10+ and says we own the hand, so opener has nothing to
# prove: he repeats a six-card suit, shows a second suit with extras,
# and otherwise passes and leaves the next decision to partner, who has
# the values. BBA never doubles them here on these cards.
after 1x (X) XX (*)
  cheapest(x) "Rebids {x}: six or more"
      shows x>=6, suit_points<=18
      sets  ask=signoff
      priority -1
  cheapest(S) "Five or more spades"
      shows S>=5, suit_points<=18
      when  x is not S
      when  maybe lho.S<=4, maybe rho.S<=4
      sets  ask=signoff
      priority -2
  cheapest(H) "Five or more hearts"
      shows H>=5, S<=4, suit_points<=18
      when  x is not H
      when  maybe lho.H<=4, maybe rho.H<=4
      sets  ask=signoff
      priority -2
  cheapest(D) "Five or more diamonds"
      shows D>=5, S<=4, H<=4, suit_points<=18
      when  x is not D
      when  maybe lho.D<=4, maybe rho.D<=4
      sets  ask=signoff
      priority -2
  cheapest(C) "Five or more clubs"
      shows C>=5, S<=4, H<=4, suit_points<=18
      when  x is not C
      when  maybe lho.C<=4, maybe rho.C<=4
      sets  ask=signoff
      priority -2
  P   "Partner has the values: over to him"  priority -5

# ── Partner passed and they kept bidding ─────────────────────────────
# Partner has nothing (0-5 over a double, or nothing to say over an
# overcall), so opener needs a real reason to bid again. BBA passes
# about two thirds of these.
# `maybe lho.hcp<=14` is "they have not shown a strong hand": after a
# 1NT overcall they own the balance of the pack, partner has nothing,
# and BBA passes every one of these. Without the guard opener kept
# rebidding his six-card suit over their Stayman and lost 157 calls in
# the five We_Overcall_NT_* scenarios.
# Opener is not forced here, so bidding again at all shows extras, and
# there is no need to jump (Rick, 2026-09-27): 1H (X) P (2H) 3H with
# 16, where a 16-18 jump to 4H was for when partner's forcing response
# obliges opener to bid. The free rebid is 13-18 suit points; tried
# (full corpus, par / side): up to 18 -35 / +746, 13-18 +191 / +119,
# 14-18 +529 / -1,504.
after 1x (*) P (*) when they.bid, maybe lho.hcp<=14, maybe rho.hcp<=14
  cheapest(x) "Rebids {x}: six or more, a free bid with extras"
      shows x>=6, suit_points=13..18
      priority -1
after 1x (*) P (*) when they.bid
  P   "Partner has nothing: let them have it"  priority -10

# ── They bought it and partner passed: opener reopens ────────────────
# `1x (1y) P (P)` and `1x (2y) P (P)` were 2,725 dead boards in the
# corpus. Partner may hold a trap pass or 5 points with no bid, so BBA
# reopens more often than it passes: a takeout double short in their
# suit, a second suit of five, a rebid of a six-card suit, or 2NT with
# 18-19 and a stopper.
after 1x (1y) P (P) | 1x (2y) P (P) | 1x (3y) P (P) when y is not x
  X   "Reopening double: short in {y}, support for the other suits"
      shows y<=2, hcp>=12
      shows ((S>=3 | x is S | y is S), (H>=3 | x is H | y is H), (D>=3 | x is D | y is D), (C>=3 | x is C | y is C)) | hcp>=16
  cheapest(S) "Five or more spades, 14+"
      shows S>=5, suit_points>=14
      when  x is not S, y is not S
  cheapest(H) "Five or more hearts, 14+"
      shows H>=5, S<=4, suit_points>=14
      when  x is not H, y is not H
  cheapest(D) "Five or more diamonds, 14+"
      shows D>=5, S<=4, H<=4, suit_points>=14
      when  x is not D, y is not D
  cheapest(C) "Five or more clubs, 14+"
      shows C>=5, S<=4, H<=4, D<=4, suit_points>=14
      when  x is not C, y is not C
  cheapest(N) "18-19 balanced with a stopper in {y}"
      shows balanced, hcp=18..19
      when  stop(y)

# Opener answering responder's 2NT invitation with a six-card major
# (2026-09-27, ticket b220: 1S 2C 2H 2NT, AQ6542.JT65.97.K passed): the
# sixth card plays better than notrump opposite partner's doubleton.
# Three declines, four accepts; BBA bids 3S and responder raises.
when asked nt_invite, !partner.opened
  3S  "Six or more spades: not a maximum"   shows S>=6, strength<=invite
      priority 1
  4S  "Six or more spades: accepts"         shows S>=6, strength>=game
      priority 1
  3H  "Six or more hearts: not a maximum"   shows H>=6, S<=3, strength<=invite
      priority 1
  4H  "Six or more hearts: accepts"         shows H>=6, S<=3, strength>=game
      priority 1

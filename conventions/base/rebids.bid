# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Opener's rebid after a one-level suit opening and an uncontested response
# (Standard American). Rick's rulings: 1NT rebid 12-14 HCP; a jump rebid of
# opener's suit or a jump raise of responder's suit 16-18 total points; a
# reverse 17+ with the first suit longer; a jump in a new suit 19+. The rest
# follows BBA's own meanings (see rebids.notes.md).
#
# Strength: notrump rebids in HCP; suit rebids in suit points (HCP + ½ per
# card beyond four); raises of partner's suit in support points, tp(y).
# Minimum rebids have no lower bound: the opening already showed it, and
# light openings (rule of 20) must still answer a forcing response.

module rebids "Opener's rebid"
  needs  responses

# ── After a one-level new-suit response ───────────────────────────────
after 1x (P) 1y (P)
  2y  "Raise: 4+ {y}, minimum"             shows y>=4, tp(y)<=15   sets trump=y
  3y  "Jump raise: 4+ {y}, 16-18"          shows y>=4, tp(y)=16..18   sets trump=y
      when  y is H | y is S                  # a major: 19+ jumps to game
  3y  "Jump raise: 4+ {y}, 16+"             shows y>=4, tp(y)>=16   sets trump=y
      when  y is C | y is D                  # a minor: there is no four-level game
  2x  "Rebids {x}: 6+, minimum"            shows x>=6, suit_points<=15
      priority -1                          # a new suit first
  3x  "Jump rebid: 6+ {x}, 16-18"          shows x>=6, suit_points=16..18
      priority -1                          # a new suit first
  2x  "Rebids {x}: five or more, too weak to reverse"
      shows x>=5, suit_points<=18
      when  x is C | x is D                 # 5-4-2-2 with 15-18: no other rebid
      priority -4
  1N  "12-14 HCP, balanced"                shows balanced | shape 5-4-2-2, hcp=12..14, y<=3
  2N  "18-21 HCP, balanced"                shows balanced | shape 5-4-2-2, hcp=18..21, y<=3
  1N  "Minimum, no better rebid"           shows hcp<=14, y<=3
      priority -3                          # e.g. 5-4 with a singleton: no suit to rebid
after 1x (P) 1M (P)
  4M  "Game raise: 4+ {M}, 19+"            shows M>=4, tp(M)>=19   sets trump=M

# A new suit: at the one level 4+ and up to 18; at the two level below the
# first suit 4+, not a reverse; a reverse (two level, above the first suit)
# 17+ with the first suit longer; a jump in a new suit 19+, game forcing.
after 1C (P) 1D (P)
  1N  "12-14 HCP, balanced"                shows balanced | shape 5-4-2-2, hcp=12..14
      when  H<=3 | S<=3                    # with both majors, 1H
      priority 2                           # balanced: 1NT even with a major (as BBA)
  1H  "4+ hearts, up to 18"                shows H>=4, suit_points<=18, H>=S
  1S  "4+ spades, up to 18"                shows S>=4, suit_points<=18, S>H
  2H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
  2S  "Jump shift: 4+ spades, 19+"         shows S>=4, suit_points>=19   sets forcing=game
after 1C (P) 1H (P)
  1S  "4+ spades, up to 18"                shows S>=4, suit_points<=18
      when  H<=3                           # four hearts: raise first
      priority 2                           # four spades: 1S before 1NT
  2D  "Reverse: 4+ diamonds, longer clubs, 17+"  shows D>=4, C>D, suit_points>=17  sets forcing=round
      priority 1
  2S  "Jump shift: 4+ spades, 19+"         shows S>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
after 1C (P) 1S (P)
  2D  "Reverse: 4+ diamonds, longer clubs, 17+"  shows D>=4, C>D, suit_points>=17  sets forcing=round
      priority 1
  2H  "Reverse: 4+ hearts, longer clubs, 17+"    shows H>=4, C>H, suit_points>=17  sets forcing=round
      priority 1
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
  3H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
after 1D (P) 1H (P)
  1S  "4+ spades, up to 18"                shows S>=4, suit_points<=18
      when  H<=3                           # four hearts: raise first
      priority 2                           # four spades: 1S before 1NT
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18, D>=C
  2S  "Jump shift: 4+ spades, 19+"         shows S>=4, suit_points>=19   sets forcing=game
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
after 1D (P) 1S (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18, D>=C
  2H  "Reverse: 4+ hearts, longer diamonds, 17+"  shows H>=4, D>H, suit_points>=17  sets forcing=round
      priority 1
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
after 1H (P) 1S (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2D  "4+ diamonds, up to 18"              shows D>=4, suit_points<=18, D>=C | C<=3
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game

# ── After 1NT (not forcing) ──────────────────────────────────────────
after 1x (P) 1N (P)
  P   "Minimum, nothing more to show"      shows suit_points<=15
      priority -5
  2x  "Rebids {x}: five or more, too good to pass and no reverse"
      shows x>=5, suit_points=16..18
      priority -2                          # 5-4 with 16-18: a reverse needs 17
  2x  "Rebids {x}: 6+, minimum"            shows x>=6, suit_points<=15
      priority -1
  3x  "Jump rebid: 6+ {x}, 16-18"          shows x>=6, suit_points=16..18
      priority -1
  2N  "18-19 HCP, balanced"                shows balanced, hcp=18..19
after 1S (P) 1N (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2D  "4+ diamonds, up to 18"              shows D>=4, suit_points<=18, D>=C | C<=3
  2H  "4+ hearts, up to 18"                shows H>=4, suit_points<=18
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
  3H  "Jump shift: 4+ hearts, 19+"         shows H>=4, suit_points>=19   sets forcing=game
after 1H (P) 1N (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2D  "4+ diamonds, up to 18"              shows D>=4, suit_points<=18, D>=C | C<=3
  2S  "Reverse: 4+ spades, longer hearts, 17+"   shows S>=4, H>S, suit_points>=17  sets forcing=round
      priority 1
  3C  "Jump shift: 4+ clubs, 19+"          shows C>=4, suit_points>=19   sets forcing=game
  3D  "Jump shift: 4+ diamonds, 19+"       shows D>=4, suit_points>=19   sets forcing=game
after 1D (P) 1N (P)
  2C  "4+ clubs, up to 18"                 shows C>=4, suit_points<=18
  2H  "Reverse: 4+ hearts, longer diamonds, 17+"  shows H>=4, D>H, suit_points>=17  sets forcing=round
      priority 1
  2S  "Reverse: 4+ spades, longer diamonds, 17+"  shows S>=4, D>S, suit_points>=17  sets forcing=round
      priority 1
after 1C (P) 1N (P)
  2D  "Reverse: 4+ diamonds, longer clubs, 17+"  shows D>=4, C>D, suit_points>=17  sets forcing=round
      priority 1
  2H  "Reverse: 4+ hearts, longer clubs, 17+"    shows H>=4, C>H, suit_points>=17  sets forcing=round
      priority 1
  2S  "Reverse: 4+ spades, longer clubs, 17+"    shows S>=4, C>S, suit_points>=17  sets forcing=round
      priority 1

# ── Too strong for a jump rebid ──────────────────────────────────────
# A jump rebid of our own suit is 16-18, so 19+ with a one-suiter had no
# rebid at all and passed a forcing response. BBA plays these as 3NT with
# a long minor ("calculated bid: 18 to 21 total points, 6+ clubs"), and
# game in a long major.
after 1m (P) 1y (P) | 1m (P) 2y (P)
  3N  "18-21 with six or more {m}: to play"
      shows m>=6, hcp=18..21
      when  y is not m
after 1M (P) 1y (P) | 1M (P) 2y (P)
  4M  "19+ with six or more {M}: game"
      shows M>=6, suit_points>=19
      when  y is not M
# The same two rules after a 1NT response. They cannot share the context
# above: `y` is bound by the other alternatives only, and a `when` that
# names it can never be decided after 1NT, so the rules never fired.
after 1m (P) 1N (P)
  3N  "18-21 with six or more {m}: to play"
      shows m>=6, hcp=18..21
after 1M (P) 1N (P)
  4M  "19+ with six or more {M}: game"
      shows M>=6, suit_points>=19

# ── After a raise ────────────────────────────────────────────────────
# With a fit found, opener counts support points tp(x): BBA bids game over a
# simple raise with 16-18 and a singleton, but passes 14-15 with doubletons.
after 1x (P) 2x (P)
  P   "Minimum: no game"                   shows tp(x)<=16
      priority -5
  3x  "Invitation: 17-18 with the fit"     shows tp(x)=17..18
after 1M (P) 2M (P)
  4M  "Game: 19+ with the fit"             shows tp(M)>=19
after 1m (P) 2m (P)
  2N  "18-19 HCP, balanced"                shows balanced, hcp=18..19
  3N  "20-21 HCP, balanced"                shows balanced, hcp>=20

after 1M (P) 3M (P)
  4M  "Accepts the limit raise"            shows tp(M)>=15
  P   "Declines: minimum"                  shows tp(M)<=14
after 1m (P) 3m (P)
  3N  "Accepts, balanced: 14+"             shows hcp>=14, balanced | semibalanced
  P   "Declines: minimum"                  shows hcp<=13
      priority -5

after 1m (P) 2N (P)
  3N  "Accepts: 14+"                       shows hcp>=14
  P   "Declines: 12-13"                    shows hcp<=13
      priority -5

# ── After a two-over-one response (forcing one round) ────────────────
after 1M (P) 2x (P) when x is not M
  2M  "Rebids {M}: 5+, minimum"            shows M>=5, suit_points<=15
      priority -1                          # the default minimum rebid
  2M  "Rebids {M}: five or more, too weak to reverse"
      shows M>=5, suit_points<=18
      priority -2
  3M  "Jump rebid: 6+ {M}, 16-18"          shows M>=6, suit_points=16..18
  3x  "Raise: 4+ {x}"                      shows x>=4
  2N  "15-17 HCP, balanced"                shows balanced, hcp=15..17
      priority -2                          # a 5-3-3-2 minimum rebids its major
  3N  "18-19 HCP, balanced"                shows balanced, hcp=18..19
after 1S (P) 2C (P)
  2D  "4+ diamonds"                        shows D>=4
  2H  "4+ hearts"                          shows H>=4
after 1S (P) 2D (P)
  2H  "4+ hearts"                          shows H>=4
  3C  "4+ clubs, extras"                   shows C>=4, suit_points>=16
after 1S (P) 2H (P)
  3H  "Raise: 3+ hearts"                   shows H>=3
  4H  "Game raise: 3+ hearts, 14-17"       shows H>=3, suit_points=14..17
  3C  "4+ clubs, extras"                   shows C>=4, suit_points>=16
  3D  "4+ diamonds, extras"                shows D>=4, suit_points>=16
after 1H (P) 2C (P)
  2D  "4+ diamonds"                        shows D>=4
  2S  "Reverse: 4+ spades, longer hearts, 17+"   shows S>=4, H>S, suit_points>=17  sets forcing=round
      priority 1
after 1H (P) 2D (P)
  2S  "Reverse: 4+ spades, longer hearts, 17+"   shows S>=4, H>S, suit_points>=17  sets forcing=round
      priority 1
  3C  "4+ clubs, extras"                   shows C>=4, suit_points>=16
after 1D (P) 2C (P)
  2D  "Rebids diamonds: minimum"           shows D>=5, suit_points<=15
      priority -1
  3D  "Jump rebid: 6+ diamonds, 16-18"     shows D>=6, suit_points=16..18
      priority -1
  2D  "Rebids diamonds: five or more, no better rebid"
      shows D>=5, suit_points<=18
      priority -2
  3C  "Raise: 4+ clubs"                    shows C>=4
  2H  "4+ hearts"                          shows H>=4
  2S  "4+ spades"                          shows S>=4
  2N  "12-14 HCP, balanced"                shows balanced, hcp=12..14
  3N  "18-19 HCP, balanced"                shows balanced, hcp=18..19

# ── After an invitational jump shift (10-12, six cards) ──────────────
after 1x (P) 3y (P) when y is not x
  P   "Minimum, no fit"                    shows hcp<=13
      priority -5
  3N  "Accepts: 14+, to play notrump"      shows hcp>=14, y<=2
  4y  "Accepts in the fit: 14+"            shows y>=2, suit_points>=14
      when  y is H | y is S

# ── Responder bid a fourth suit at the one level ─────────────────────
# 1♣-1♦-1♥-1♠ is natural on this card, and opener had no third call at
# all. He raises with four, and otherwise shows his shape once more. The
# fourth suit at the one level is always a major, so it binds to `M`.
after 1x (P) 1y (P) 1z (P) 1M (P)
  2M  "Raise: 4+ {M}, minimum"             shows M>=4, tp(M)<=15   sets trump=M, ask=signoff
  3M  "Jump raise: 4+ {M}, 16-18"          shows M>=4, tp(M)=16..18   sets trump=M, ask=invite(M)
  4M  "Game raise: 4+ {M}, 19+"            shows M>=4, tp(M)>=19   sets trump=M
  1N  "Minimum, no fit for {M}"            shows M<=3, hcp<=15   sets ask=signoff
  2N  "16-18, no fit for {M}"              shows M<=3, hcp=16..18   sets ask=nt_invite
  2x  "Six or more {x}"                    shows x>=6, suit_points<=15   sets ask=signoff
      priority -1

# ── Partner has signed off ───────────────────────────────────────────
# Responder's weak second calls — a preference, a weak rebid of his own
# suit, a raise of opener's second suit, 1NT — say "play here", and set
# `ask=signoff` (responder-rebids.bid). Opener's answer is the same
# whatever the auction was, so it is written once against the ask rather
# than as the dozen eight-call patterns it would otherwise take: pass
# with a minimum, one more try with 16-18, game with 19+.
when asked signoff
  P   "Nothing to add: partner is limited"
      priority -5
  2x  "Six or more {x}: a better spot"        shows x>=6, suit_points<=15
      when  maybe partner.x<=2
      sets  ask=signoff
      priority -1
  3x  "Six or more {x}, 16-18: one more try"  shows x>=6, suit_points=16..18
      sets  ask=invite(x)
  3x  "Raise: 16-18 with the fit"             shows x>=3, suit_points=16..18
      when  partner.x>=5
      sets  ask=invite(x)
  2y  "Preference: three or more {y}"         shows y>=3
      when  partner.y>=5
      sets  ask=signoff
      priority -2
  4M  "Game: 6+ {M}, 19+"                     shows M>=6, suit_points>=19
  4M  "Game in the fit: 19+"                  shows M>=3, suit_points>=19
      when  partner.M>=4

# ── Answering an invitation in a minor ───────────────────────────────
# Responder's invitational raise or jump sets `ask=invite(x)`. A major
# invitation is answered where the same question is answered after a
# transfer (`when asked invite(M)`, jacoby-transfers.bid); a minor one
# had no answer anywhere, so opener passed a live auction. Opposite
# 10-12, opener needs 14 to go on, and there is no game below 5 of a
# minor: 3NT with the values and a shape for it, 5 of the minor with
# real extras, otherwise pass.
when asked invite(m)
  P   "Declines: no more than a minimum"
      priority -5
  3N  "Accepts, in notrump: 14+ and a shape for it"
      shows hcp>=14, balanced | semibalanced
  5m  "Accepts in {m}: 18+ with the fit"      shows hcp>=18, m>=5

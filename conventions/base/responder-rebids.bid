# Syntax: docs/LANGUAGE.md. Check with `rbb bid check`.
#
# Responder's second call after a one-level suit opening, a one-level
# response and opener's rebid (Standard American). Rick's rulings: responder
# invites with 2NT or a jump in his own suit (6+); a new suit by responder
# after opener's 1NT is not forcing unless it is a responder's reverse (with
# New Minor Forcing on, 2 of the other minor is artificial instead:
# new-minor-forcing.bid). Ranges: weak 6-10, invitational 11-12, game 13+
# opposite a minimum rebid, in total points, which count length (a six-card
# suit adds two). See responder-rebids.notes.md.
#
# Every call here that says "play here" sets `ask=signoff`, and every
# invitation sets `ask=invite(suit)` or `ask=nt_invite`. Opener answers
# all three in rebids.bid, written against the question instead of
# against the auction that asked it (LANGUAGE.md §10).

module responder-rebids "Responder's second call"
  needs  rebids
  skill  partnership_bidding/responders_rebid
  skill  bidding_conventions/fourth_suit_forcing
  param  nmf = other_conventions.new_minor_forcing.play default false
  param  fsf = other_conventions.fourth_suit_forcing.play default false
  param  style = general.style

# ── Opener rebid 1NT (12-14) ─────────────────────────────────────────
after 1x (P) 1y (P) 1N (P)
  P   "Weak: no game"                      shows points<=10
      priority -5
  2y  "Weak: 6+ {y}"                       shows y>=6, points<=10   sets ask=signoff
      when  y is H | y is S                # a weak minor passes 1NT
  3y  "Invitational: 6+ {y}, 11-12"        shows y>=6, points=11..12   sets ask=invite(y)
  2N  "Invitational: 11-12"                shows points=11..12, y<=5   sets ask=nt_invite
  3N  "Game: 13+"                          shows points>=13, y<=5 | y is C | y is D
  2x  "Weak: 5+ {x}"                       shows x>=5, points<=10   sets ask=signoff
after 1x (P) 1M (P) 1N (P)
  4M  "Game: 6+ {M}"                       shows M>=6, points>=13
after 1M (P) 1y (P) 1N (P)
  3M  "Invitational: 3 {M}, 11-12 support points"  shows M=3, tp(M)=11..12   sets ask=invite(M)
  # Opener's major is five: three cards make the fit, and a major fit plays
  # better than notrump (Rick, ticket b400, 2026-10-02). Support points,
  # as the support hand counts.
  4M  "Game in opener's major: 3+ {M}, 13+ support points"  shows M>=3, tp(M)>=13
      priority 1

# New suits after 1NT: below responder's suit, natural and not forcing
# (5-4, weak); above it, a responder's reverse (game forcing).
after 1C (P) 1D (P) 1N (P)
  2H  "Responder's reverse: 4+ hearts, 5+ diamonds, game forcing"  shows H>=4, D>=5, points>=13  sets forcing=game
  2S  "Responder's reverse: 4+ spades, 5+ diamonds, game forcing"  shows S>=4, D>=5, points>=13  sets forcing=game
after 1C (P) 1H (P) 1N (P)
  2D  "4+ diamonds, 5+ hearts, not forcing"  shows D>=4, H>=5, points<=12   when !nmf   sets ask=signoff
  2S  "Responder's reverse: 4+ spades, 5+ hearts, game forcing"    shows S>=4, H>=5, points>=13  sets forcing=game
after 1C (P) 1S (P) 1N (P)
  3H  "Four hearts, five spades, game forcing"  shows H>=4, S>=5, points>=13   sets forcing=game
  2D  "4+ diamonds, 5+ spades, not forcing"  shows D>=4, S>=5, points<=12   when !nmf   sets ask=signoff
  2H  "4+ hearts, 5+ spades, not forcing"   shows H>=4, S>=5, points<=12   sets ask=signoff
after 1D (P) 1H (P) 1N (P)
  2C  "4+ clubs, 5+ hearts, not forcing"   shows C>=4, H>=5, points<=12   when !nmf   sets ask=signoff
  2S  "Responder's reverse: 4+ spades, 5+ hearts, game forcing"    shows S>=4, H>=5, points>=13  sets forcing=game
after 1D (P) 1S (P) 1N (P)
  3H  "Four hearts, five spades, game forcing"  shows H>=4, S>=5, points>=13   sets forcing=game
  2C  "4+ clubs, 5+ spades, not forcing"   shows C>=4, S>=5, points<=12   when !nmf   sets ask=signoff
  2H  "4+ hearts, 5+ spades, not forcing"   shows H>=4, S>=5, points<=12   sets ask=signoff
after 1H (P) 1S (P) 1N (P)
  2C  "4+ clubs, 5+ spades, not forcing"   shows C>=4, S>=5, points<=12   sets ask=signoff
  2D  "4+ diamonds, 5+ spades, not forcing"  shows D>=4, S>=5, points<=12   sets ask=signoff

# ── Opener rebid his suit (6+, minimum) ──────────────────────────────
after 1x (P) 1y (P) 2x (P)
  P   "Weak: no game"                      shows points<=10
      priority -5
  2y  "Weak: 6+ {y}"                       shows y>=6, points<=10   sets ask=signoff
  3y  "Invitational: 6+ {y}, 11-12"        shows y>=6, points=11..12   sets ask=invite(y)
  3x  "Raise: 2+ {x}, 10-12"              shows x>=2, points=10..12   sets ask=invite(x)
  3x  "Raise (BBA): 3+ {x}, 7-9, to compete"  shows x>=3, points=7..9   sets ask=signoff
      when  style is bba, x is C | x is D  # BBA raises opener's six-card minor on 7
  2N  "Invitational: 11-12"                shows points=11..12, x<=1, y<=5  sets ask=nt_invite
  # Opposite six, two is a fit: a doubleton in opener's major bids 4M,
  # not 3NT (Rick, 2026-10-02), as the 2NT invitation above already
  # needs a singleton.
  3N  "Game: 13+"                          shows points>=13, x<=1 | x is C | x is D
after 1M (P) 1y (P) 2M (P)
  4M  "Game: 2+ {M}, 13+"                  shows M>=2, points>=13

# ── Opener raised responder's suit (4+, minimum) ─────────────────────
after 1x (P) 1y (P) 2y (P)
  P   "Weak: no game"                      shows tp(y)<=10
      priority -5
  3y  "Invitational: 11-12"                shows tp(y)=11..12   sets ask=invite(y)
after 1x (P) 1M (P) 2M (P)
  4M  "Game: 13+"                          shows tp(M)>=13
after 1C (P) 1D (P) 2D (P)
  3N  "Game: 13+"                          shows points>=13

# ── Opener bid a new suit at the one level (not forcing) ─────────────
# The fourth suit at the one level stays natural whatever the card says
# about fourth suit forcing: 1♠ here is a real suit (rebids.bid answers it).
after 1C (P) 1D (P) 1H (P)
  1S  "4+ spades"                          shows S>=4, H<=3
      priority 1
after 1x (P) 1y (P) 1z (P)
  1N  "6-10, no fit"                       shows points<=10, z<=3   sets ask=signoff
  2x  "Preference: 3+ {x}, weak"           shows x>=3, points<=10, z<=3   sets ask=signoff
      priority -1
  2z  "Raise: 4+ {z}, weak"                shows z>=4, points<=10   sets ask=signoff
  3z  "Invitational raise: 4+ {z}, 11-12"  shows z>=4, points=11..12   sets ask=invite(z)
  2y  "Weak: 6+ {y}"                       shows y>=6, points<=10   sets ask=signoff
  3y  "Invitational: 6+ {y}, 11-12"        shows y>=6, points=11..12   sets ask=invite(y)
  2N  "Invitational: 11-12"                shows points=11..12, z<=3   sets ask=nt_invite
  3N  "Game: 13+"                          shows points>=13, z<=3
after 1x (P) 1y (P) 1M (P)
  4M  "Game raise: 4+ {M}, 13+"            shows M>=4, points>=13
# Responder's 1♠ over 1♣-1♦-1♥ (above) is unlimited, and opener's
# minimum answers (rebids.bid, "Responder bid a fourth suit at the one
# level") set `ask=signoff`, which left a game-going responder only the
# pass (2026-09-30: with a card that bids majors up the line this auction
# is common). Game and invitations as after any minimum rebid.
after 1x (P) 1y (P) 1z (P) 1M (P) 1N (P)
  2N  "Invitational: 11-12"                shows points=11..12   sets ask=nt_invite
  3N  "Game: 13+"                          shows points>=13
after 1x (P) 1y (P) 1z (P) 1M (P) 2M (P)
  3M  "Invitational: 11-12"                shows tp(M)=11..12   sets ask=invite(M)
  4M  "Game: 13+"                          shows tp(M)>=13
after 1x (P) 1y (P) 1z (P) 1M (P) 2x (P)
  3N  "Game: 13+"                          shows points>=13

# The fourth suit at the two level: natural unless the card plays fourth
# suit forcing (`other_conventions.fourth_suit_forcing.play`, set by
# Bridge-Classroom's cards; the .bbsa keys set only one_round/game_force,
# so the corpus keeps it natural). There is no artificial 2♣ yet.
after 1D (P) 1H (P) 1S (P)
  2C  "5+ clubs, 8-10"                     shows C>=5, points=8..10, S<=3   sets ask=signoff
      when  !fsf_on                    # fourth-suit-forcing.bid

# ── Opener bid a new suit at the two level (a reverse is forcing) ────
after 1x (P) 1y (P) 2z (P) when z is not x, z is not y
  P   "Weak: passes {z}"                   shows points<=10, z>=4 | z>x
      priority -5
  2x  "Preference: weak"                   shows x>=2, points<=10, x>=z | (z<=3, x is H) | (z<=3, x is S)   sets ask=signoff
  2y  "Weak: 6+ {y}"                       shows y>=6, points<=10   sets ask=signoff
  3z  "Invitational raise: 4+ {z}"         shows z>=4, points=11..12   sets ask=invite(z)
  3x  "Invitational: 3+ {x}"               shows x>=3, points=11..12   sets ask=invite(x)
  2N  "Invitational: 11-12"                shows points=11..12, z<=3   sets ask=nt_invite
  3N  "Game: 13+"                          shows points>=13, z<=3 | z is C | z is D
  2N  "Forced to bid: minimum, no fit"     shows points<=10
      when  we.forcing = round             # after a reverse
      priority -4
# With game values and three of opener's five-card major: 4M, not 3NT
# (Rick, ticket b400, 2026-10-02: 1H-1S-2C, AKQ5.Q832.T84.Q7 bid 3NT with
# a nine-card heart fit; BBA plays 4H).
after 1M (P) 1y (P) 2z (P) when z is not M, z is not y
  4M  "Game in opener's major: 3+ {M}, 13+ support points"  shows M>=3, tp(M)>=13
      priority 1

# ── Opener's jump rebid (6+, 16-18) or jump raise (4+, 16-18) ───────
after 1x (P) 1y (P) 3x (P)
  P   "Weak: no game"                      shows points<=8
      priority -5
  3N  "Game: 9+"                           shows points>=9, x<=1 | x is C | x is D
after 1M (P) 1y (P) 3M (P)
  4M  "Game: 2+ {M}, 8+"                   shows M>=2, points>=8
after 1x (P) 1y (P) 3y (P)
  P   "Weak: no game"                      shows points<=8
      priority -5
  3N  "Game: 8+"                           shows points>=8
      when  y is not H, y is not S         # with a major fit, 4M
after 1x (P) 1M (P) 3M (P)
  4M  "Game: 9+"                           shows points>=9

# ── Opener's 2NT (18-19) ─────────────────────────────────────────────
after 1x (P) 1y (P) 2N (P)
  P   "Weak: no game"                      shows points<=6
      priority -5
  3N  "Game: 7+"                           shows points>=7, y<=5 | y is C | y is D, hcp + partner.hcp.min <= 31   # with more, the catch-all below looks at slam
after 1x (P) 1M (P) 2N (P)
  4M  "Game: 6+ {M}"                       shows M>=6, points>=7
after 1M (P) 1y (P) 2N (P)
  4M  "Game in opener's major: 3+ {M}"     shows M>=3, tp(M)>=7
      priority 1                           # a major fit before 3NT (ticket b400)

# ── After responder's 1NT and opener's rebid ─────────────────────────
after 1x (P) 1N (P) 2z (P) when z is not x
  P   "Passes: {z} at least as long, or a four-card {z}"   shows z>=4 | z>x
      priority -5
  3m  "Six or more {m}, short in both of opener's suits: to play"   shows m>=6, x<=1, z<=2
      when  m is not x, m is not z
      sets  ask=signoff
  2x  "Preference: 2+ {x}"                 shows x>=2, x>=z | (z<=3, x is H) | (z<=3, x is S)   sets ask=signoff
  3z  "Raise: 4+ {z}, 9-10"                shows z>=4, points=9..10   sets ask=invite(z)
# Six hearts too weak for 2H at once, opposite 1S and a minor: to play
# (2026-09-30, random deals: J.AT75432.6.QJ53 had no call; BBA 2H).
after 1S (P) 1N (P) 2m (P)
  2H  "Six or more hearts, short in spades, 6-10: to play"   shows H>=6, S<=1, hcp<=10
      sets  ask=signoff
# After the 6-12 1NT of the 2/1 cards (2026-09-30, 2/1 game force): the
# 11-12 hands invite, and three-card support is a limit raise.
after 1M (P) 1N (P) 2z (P) when z is not M, shown.hcp.max >= 11
  2N  "Invitational: 11-12, no fit"        shows hcp=11..12, M<=2, z<=3   sets ask=nt_invite
  3M  "Limit raise: three-card support, 10-12"   shows M=3, tp(M)=10..12   sets ask=invite(M)
      priority 1
  3z  "Raise: 4+ {z}, 11-12 HCP"           shows z>=4, hcp=11..12   sets ask=invite(z)   # the new band only: 9-10 with length is impossible-2s.bid's
      when  z is C | z is D
after 1M (P) 1N (P) 2M (P) when shown.hcp.max >= 11
  2N  "Invitational: 11-12"                shows hcp=11..12, M<=2   sets ask=nt_invite
  3M  "Invitational: two or three {M}, 11-12"   shows M>=2, hcp=11..12   sets ask=invite(M)
      priority 1
# The pass is in HCP: the 1NT response is 6-10 HCP, and with length
# points a 1NT responder can count 11-12 and had no call. BBA raises
# with a doubleton from 8 HCP (probes/resp-1H-1N-2H, 2026-09-25: 60 of
# 79 hands with 8-10 and two hearts); an eight-card fit opposite six.
after 1x (P) 1N (P) 2x (P)
  P   "No game"                            shows hcp<=10
      priority -5
  3x  "Raise: 3+ {x}, maximum for the 1NT response"
      shows x>=3, points>=10   sets ask=invite(x)
      when  x is C | x is D                # 1M-1NT denied three: partner read 3M as this, with no fit
  3x  "Raise: 2+ {x}, 8-10: invites game"
      shows x>=2, hcp>=8   sets ask=invite(x)
      when  x is H | x is S                # over a minor, 3m rarely reaches game
      priority -1
after 1x (P) 1N (P) 3x (P)
  P   "No game"                            shows points<=8
      priority -5
  3N  "Game, no fit"                       shows points>=9, x<=1 | x is C | x is D
after 1M (P) 1N (P) 3M (P)
  4M  "Game: 2+ {M}, 8+"                   shows M>=2, points>=8
after 1x (P) 1N (P) 2N (P)
  P   "No game"                            shows points<=6
      priority -5
  3N  "Game: 7+"                           shows points>=7

# ── After a two-over-one and opener's rebid ──────────────────────────
# A 2/1 is 11+ suit points opposite an opening, so the pair is close to
# game: with support for opener's major, bid it; without a major fit,
# 2NT invites and 3NT is game. Opener's suit may be a minor (1♦-2♣-2♥),
# and then notrump is the only game to look for, so the rules that do
# not name a major are written for any opening suit `y`.
#
# The 2/1 itself is measured in suit points (a 5-4-3-1 ten-count bids
# it), so the calls that choose a suit are measured the same way, and
# only the notrump bids count notrump points.
after 1y (P) 2x (P) 2z (P) when x is not y
  2N  "Invitational, no fit: 11-12"        shows points=11..12, y<=2 | y is C | y is D
      when  !we.gf
      sets  ask=nt_invite
  3N  "Game, no fit"                       shows points>=13, y<=2 | y is C | y is D
      when  !we.gf
  # In a game force (2/1 cards) 3NT is the minimum, fast arrival; with
  # more, 2NT keeps the auction low for opener to count slam (2026-09-30,
  # random deals: responder's 3NT with the stronger hand, 482 boards short
  # of slam in 100,000).
  3N  "Game, no fit: 13-15 (fast arrival)"  shows points=13..15, y<=2 | y is C | y is D
      when  we.gf
  2N  "Game forcing, no fit: 16+"          shows points>=16, y<=2 | y is C | y is D, z<=3
      when  we.gf
  3x  "Invitational: 6+ {x}, 11-12"        shows x>=6, suit_points=11..12, y<=2 | y is C | y is D
      when  !we.gf
      sets  ask=invite(x)
  2y  "Preference: 2+ {y}, nothing better to say"
      shows y>=2, suit_points<=12
      when  !we.gf
      sets  ask=signoff
      priority -3                          # a ten-count with shape: no game bid fits
  P   "Minimum for the two-over-one: no game"
      shows suit_points<=12
      priority -5                          # opener rebid his own suit: nowhere to go
  # A game-forcing two-over-one (2/1 cards, 2026-09-30): no invitations
  # and no sign-off; a preference or the long suit again keeps it going.
  3x  "Six or more {x}, game forcing"      shows x>=6
      when  we.gf
      priority -1
  2y  "Preference: 2+ {y}, game forcing"   shows y>=2
      when  we.gf
      priority -3
# Fast arrival (2026-09-30, slam entry, slam-entry.notes.md): the jump to
# game is the minimum; with slam interest agree the suit below game and
# force, so control bids and the keycard ask can follow. Random deals:
# responder jumped to game here with 19 HCP and 33 between the hands.
after 1M (P) 2x (P) 2z (P) when x is not M
  4M  "Game with support: no slam interest"  shows tp(M)=11..15, M>=3 | (M>=2, partner.M>=6)
  3M  "Support for {M}, slam interest: forcing"  shows tp(M)>=16, M>=3 | (M>=2, partner.M>=6)
      sets  trump=M, forcing=game
# Opener's second suit, a major: raise it (there was no raise at all).
after 1y (P) 2x (P) 2z (P) when x is not y, z is not y, z is H | z is S
  4z  "Raise: 4+ {z}, no slam interest"    shows z>=4, points=11..14
  3z  "Raise: 4+ {z}, slam interest: forcing"  shows z>=4, points>=15
      sets  trump=z, forcing=game
after 1y (P) 2x (P) 3x (P) when x is not y
  4x  "Game in the fit"                    shows suit_points>=11
      when  x is H | x is S                # spades: 1H 2S, a strong jump shift (ticket b173)
      priority 1                           # responder's own major fit first
  3N  "Game"                               shows points>=12, y<=2 | y is C | y is D
      when  x is H | x is S | ((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
  P   "Minimum for the two-over-one"       shows suit_points<=12
      priority -5
# A minor fit (Rick, 2026-09-25): no control bids with a minor agreed.
# New suits below 3NT show stoppers, up the line, looking for 3NT with 5m
# as the backup; a suit skipped is denied (`sets ladder=stopper` keeps
# the record). A suit is covered by my stopper, one partner has shown, or
# a suit either of us bid naturally.
after 1y (P) 2x (P) 3x (P) when x is C | x is D, x is not y
  cheapest(C)  "Stopper in C, looking for 3NT"
      when  x is not C, y is not C, cheapest_rank(C) < 19
      when  points>=12, stop(C), !((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
      sets  ask=stoppers, ladder=stopper, trump=x, forcing=game
      prefer 0 - cheapest_rank(C)
      priority 1
  cheapest(D)  "Stopper in D, looking for 3NT"
      when  x is not D, y is not D, cheapest_rank(D) < 19
      when  points>=12, stop(D), !((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
      sets  ask=stoppers, ladder=stopper, trump=x, forcing=game
      prefer 0 - cheapest_rank(D)
      priority 1
  cheapest(H)  "Stopper in H, looking for 3NT"
      when  x is not H, y is not H, cheapest_rank(H) < 19
      when  points>=12, stop(H), !((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
      sets  ask=stoppers, ladder=stopper, trump=x, forcing=game
      prefer 0 - cheapest_rank(H)
      priority 1
  cheapest(S)  "Stopper in S, looking for 3NT"
      when  x is not S, y is not S, cheapest_rank(S) < 19
      when  points>=12, stop(S), !((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
      sets  ask=stoppers, ladder=stopper, trump=x, forcing=game
      prefer 0 - cheapest_rank(S)
      priority 1
  cheapest(y)  "No stopper to show below 3NT: over to you"
      when  cheapest_rank(y) < 19
      when  points>=12, !((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
      sets  ask=stoppers, ladder=stopper, trump=x, forcing=game
      priority -2
  5x  "Game in the minor: a suit unstopped"
      shows points>=12
      when  !((x is C | y is C | stop(C) | partner.cued(C) | partner.C.min>=4 | shown.C.min>=4), (x is D | y is D | stop(D) | partner.cued(D) | partner.D.min>=4 | shown.D.min>=4), (x is H | y is H | stop(H) | partner.cued(H) | partner.H.min>=4 | shown.H.min>=4), (x is S | y is S | stop(S) | partner.cued(S) | partner.S.min>=4 | shown.S.min>=4))
      priority -3

after 1M (P) 2x (P) 3x (P) when x is not M
  4M  "Game with support"                  shows tp(M)>=11, M>=3
after 1y (P) 2x (P) 3z (P) when x is not y, z is not y, z is not x
  3N  "Game, no fit"                       shows points>=10, y<=2 | y is C | y is D
# Opener's new suit at the three level: 3M agrees and is forcing with
# 13 or more, 4M is the minimum (BBA: 3S 13+ total points, 4S 11-12,
# probes/slam-1S-2D-3C-resp.toml; we had no 3M, 2026-10-01). Opener
# then counts for slam with the suit agreed.
after 1M (P) 2x (P) 3z (P) when x is not M, z is not M, z is not x
  3M  "Support, 13+: forcing, room for slam"  shows points>=13, M>=3   sets trump=M, forcing=game
  4M  "Game with support: a minimum"       shows tp(M)>=11, points<=12, M>=3
  3x  "Six or more {x}: forcing"           shows x>=6, M<=2   sets forcing=game
      when  cheapest_rank(x) < 19            # still at the three level
# Opener's 2NT (15-17 balanced) or jump rebid over a two-over-one: the
# 2/1 was 11+, so game is there.
after 1y (P) 2x (P) 2N (P) when x is not y
  3N  "Game: the two-over-one was 11+"     shows points>=11
  P   "Nothing: a minimum two-over-one"    priority -5
after 1y (P) 2x (P) 3y (P) when x is not y
  3N  "Game, no fit"                       shows points>=11, y<=1 | y is C | y is D
                                           # the jump rebid is six: two is a fit
  P   "Nothing: a minimum two-over-one"    priority -5

after 1M (P) 3M (P) 3N (P)
  4M  "Prefers the major: four trumps"     shows M>=4

# ── After opener's invitation over a raise ───────────────────────────
after 1M (P) 2M (P) 3M (P)
  4M  "Accepts: top of the raise"          shows tp(M)>=9
      when  style is not bba
  P   "Declines"                           shows tp(M)<=8
      when  style is not bba
  # BBA accepts with 10 HCP, or four trumps and a singleton; a flat 9
  # usually declines.
  4M  "Accepts (BBA): 10 HCP, or four trumps and a singleton"
      shows hcp>=10 | (M>=4, shortest<=1)
      when  style is bba
  P   "Declines (BBA)"
      when  style is bba
      priority -5

# ── After a two-over-one and opener's jump rebid (6+, 16-18) ─────────
after 1M (P) 2x (P) 3M (P) when x is not M
  4M  "Game"                               shows points>=11

# ── Opener reversed ──────────────────────────────────────────────────
# A reverse is 17+ and forcing for one round, so responder always bids
# again: game with a maximum, a raise with four of the second suit, and
# otherwise a preference back to opener's first suit. `we.forcing = round`
# is what tells a reverse from an ordinary second suit below the first,
# which responder may pass.
after 1x (P) 1N (P) 2y (P) when y is not x, we.forcing = round
  3N  "Game: a maximum for the 1NT response"
      shows hcp>=9
  3{y} "Raise: four or more {y}"
      shows y>=4
  3{x} "Preference to {x}"
      shows x>=2
      priority -1

# ══ Responder's second call once they have come in ═══════════════════
#
# Opener's contested rebids (rebids.bid) mostly set `ask=signoff` or
# `ask=invite`, and the state blocks answer those wherever they came
# from. What is left is opener's free calls — his answer to a negative
# double, his rebids after a redouble, and the auctions where he has
# passed and left the decision here.

# ── We doubled for takeout and opener answered ───────────────────────
# The double showed 6+ and four cards in each unbid major, so opener's
# answer is limited and responder is usually done: BBA passes 16 of the
# 24 positions in the Basic-Bridge scenarios, with 6-10. `z` is
# opener's answer, which may be a repeat of his own suit.
after 1x (*) X (*) 1z (*) | 1x (*) X (*) 2z (*) | 1x (*) X (*) 3z (*) when they.bid
  P   "Minimum for the double: nothing more to say"
      shows hcp+length_points<=10
      priority -5
  cheapest(z) "Raise: four or more {z}, 11-12"
      shows z>=4, hcp+length_points=11..12
      when  partner.z>=3          # opener's answer may be a three-card major
      sets  trump=z, ask=invite(z)
  4{z} "Game in {z}: 13+ with the fit"
      shows z>=4, hcp+length_points>=13
      when  partner.z>=3, z is H | z is S
      sets  trump=z
  # Opener jumped (16-18 support points): game with 8+ (2026-09-25; we
  # stopped in 2M/3M on hands that reached game uncontested).
  4{z} "Game opposite opener's jump: 8+ with the fit"
      shows z>=4, hcp+length_points>=8
      when  partner.z>=3, z is H | z is S, partner.jumped
      sets  trump=z
      priority 1
  cheapest(N) "Invitational: 11-12 balanced"
      shows balanced, hcp+length_points=11..12
      sets  ask=nt_invite
      priority -1                 # the fit first
  3N  "Game: 13+ balanced"            # was jump(N): 4NT over a three-level answer
      shows balanced, hcp+length_points>=13
      priority -1
  P   "Nothing more to say"  priority -10

# Game values that are not balanced (2026-09-25: A762.T9.6.AKQ863 passed
# opener's minimum answer). 3NT with their suit held, else a cue bid of
# their suit, forcing to game. Over one- and two-level overcalls only.
after 1x (1y) X (P) 1z (P) | 1x (1y) X (P) 2z (P) | 1x (1y) X (P) 3z (P) | 1x (2y) X (P) 2z (P) | 1x (2y) X (P) 3z (P) when y is not x, y is not z
  3N  "Game: 13+, a stopper in {y}"
      shows hcp+length_points>=13, stop(y)
      when  partner.z<=3 | z is C | z is D
      priority -2
  cheapest(y) "Cue bid: 13+, no stopper in {y}, forcing to game"
      alert  artificial
      shows hcp+length_points>=13
      sets  forcing=game
      priority -3

# ── We redoubled and they ran ────────────────────────────────────────
# The redouble was 10+, so the partnership owns the hand. Opener has
# passed it back: responder doubles with four **good** cards in their
# suit, supports opener with three, and otherwise lets it go.
#
# Rick, 2026-09-23: four small is not a penalty double. The holding has
# to be worth about two natural trump tricks on its own -- two of the
# top three honours, or three of the top five behind the bidder.
after 1x (X) XX (1y) P (P) | 1x (X) XX (2y) P (P) | 1x (X) XX (3y) P (P) when y is not x
  X   "Penalty: four good {y} behind the bidder"
      shows y>=4
      when  quality(y)>=good | top5(y)>=3
  cheapest(x) "Back to partner's suit: three or more, 10-11"
      shows x>=3, hcp<=11
      sets  ask=signoff
      priority -1
  # Game values (2026-09-26: 12-13 counts went back to 2x and opener
  # passed with 14-16).
  3N  "Game: 12+ with a stopper in {y}"
      shows hcp>=12, stop(y)
  4{x} "Game: 12+ with three-card support"
      shows x>=3, hcp>=12
      when  x is H | x is S
  cheapest(y) "Cue bid: 12+, no stopper, forcing to game"
      alert  artificial
      shows hcp>=12
      when  !stop(y), cheapest_rank(y) <= 18
      sets  forcing=game
      priority -1
  cheapest(S) "Five or more spades"
      shows S>=5
      when  x is not S, y is not S
      priority -2
  cheapest(H) "Five or more hearts"
      shows H>=5, S<=4
      when  x is not H, y is not H
      priority -2
  P   "Nothing to say over their escape"  priority -10

# ── Opener reopened with a double ────────────────────────────────────
# Opener's reopening double (rebids.bid) is takeout, so responder names
# his longest suit at the cheapest level, passes it for penalty with
# four of theirs, or goes back to opener's suit. Four poor cards of
# theirs (not two of the top three or three of the top five) need 8 HCP
# as well: with 7 or fewer, 43 of 58 one-level passes let them make it
# (penalty-doubles.notes.md, 2026-10-02).
after 1x (1y) P (P) X (P) | 1x (2y) P (P) X (P) | 1x (3y) P (P) X (P) when y is not x
  P   "Passes the reopening double: four or more {y}"
      shows y>=4, y>=5 | quality(y)>=good | top5(y)>=3 | hcp>=8
      priority 1
  cheapest(S) "Four or more spades for the reopening double"
      shows S>=4, S>=H, S>=D, S>=C
      when  x is not S, y is not S
  cheapest(H) "Four or more hearts for the reopening double"
      shows H>=4, H>S, H>=D, H>=C
      when  x is not H, y is not H
  cheapest(D) "Four or more diamonds for the reopening double"
      shows D>=4, D>S, D>H, D>=C
      when  x is not D, y is not D
  cheapest(C) "Four or more clubs for the reopening double"
      shows C>=4, C>S, C>H, C>D
      when  x is not C, y is not C
  cheapest(x) "Back to partner's suit"
      shows x>=3
      sets  ask=signoff
      priority -2
  cheapest(N) "Balanced with a stopper in {y}"
      shows balanced
      when  stop(y)
      priority -3
  P   "Nothing better than defending"  priority -10

# ── Both sides have stopped ──────────────────────────────────────────
# Responder passed the overcall and opener passed again: nobody has
# anything, and BBA passes every one of these (6 of 6 with 3-9 points).
after 1x (*) P (*) P (P) when they.bid
  P   "Partner had no reopening bid either: let them play it"
      priority -10

# ── Opener rebid a new suit over their call ──────────────────────────
# The mirror of the uncontested blocks above, for the auctions where
# they have come in: opener's second suit at the one level leaves room
# for everything, and at the two level it may be a reverse, which our
# own rules make forcing — 58 of the corpus's broken forces were
# responder with no answer to one.
after 1x (*) 1y (*) 1z (*) when they.bid, y is not x, z is not x, z is not y
  cheapest(N) "6-10, no fit"                shows points<=10, z<=3   sets ask=signoff
  cheapest(x) "Preference: three or more {x}, weak"
      shows x>=3, points<=10, z<=3   sets ask=signoff
      priority -1
  cheapest(z) "Raise: four or more {z}, weak"   shows z>=4, points<=10   sets trump=z, ask=signoff
  jump(z) "Invitational raise: four or more {z}, 11-12"
      shows z>=4, points=11..12   sets trump=z, ask=invite(z)
  cheapest(y) "Weak: six or more {y}"       shows y>=6, points<=10   sets ask=signoff
  jump(y) "Invitational: six or more {y}, 11-12"  shows y>=6, points=11..12   sets ask=invite(y)
  jump(N) "Game: 13+"                       shows points>=13, z<=3
  4{z} "Game raise: four or more {z}, 13+"  shows z>=4, points>=13
      when  z is H | z is S
      sets  trump=z
  P   "Nothing to say"  priority -10
after 1x (*) 1y (*) 2z (*) when they.bid, y is not x, z is not x, z is not y
  cheapest(x) "Preference: two or more {x}"
      shows x>=2, points<=12
      sets  ask=signoff
      priority -1
  cheapest(z) "Raise: four or more {z}"     shows z>=4, points>=10   sets trump=z, ask=invite(z)
  cheapest(y) "Weak: six or more {y}"       shows y>=6, points<=10   sets ask=signoff
  cheapest(N) "No fit, forced to bid"       shows points<=12
      priority -4
  jump(N) "Game: 13+"                       shows points>=13, z<=3
  P   "Weak, and partner may pass"          shows points<=10
      priority -5
  P   "Nothing to say"  priority -10

# ── They competed and both partners have nothing more ────────────────
# We made a free bid, they bid again, and opener passed it out to us.
# With a minimum we let it go; with a sixth card in our suit we compete.
after 1x (*) 1z (*) P (P) | 1x (*) 2z (*) P (P) when they.bid, z is not x
  cheapest(z) "Six or more {z}: worth one more"
      shows z>=6, points>=8
      sets  ask=signoff
  cheapest(x) "Preference: three or more {x}, worth one more"
      shows x>=3, points>=10
      when  partner.x>=5
      sets  ask=signoff
      priority -2
  P   "Minimum: they have bought it"  priority -10

# ── Opener answered the negative double in notrump ───────────────────
# The notrump answer is 12-14 with a stopper (18-19 for the jump), so
# responder treats it as the 1NT rebid: pass, raise by strength, or show
# a six-card suit.
after 1x (*) X (*) 1N (*) | 1x (*) X (*) 2N (*) when they.bid
  P   "Minimum for the double: no game"
      shows points<=10
      priority -5
  cheapest(S) "Weak: six or more spades"    shows S>=6, points<=10   sets ask=signoff
  cheapest(H) "Weak: six or more hearts"    shows H>=6, S<=5, points<=10   sets ask=signoff
  cheapest(N) "Invitational: 11-12"         shows points=11..12   sets ask=nt_invite
  jump(N) "Game: 13+"                       shows points>=13
  P   "Nothing more to say"  priority -10

# ── Our double was left to them ──────────────────────────────────────
# They bid over the negative double and opener passed it out. He has a
# minimum with nothing to say, so responder needs real values to bid on.
after 1x (*) X (*) P (P) when they.bid
  cheapest(S) "Five or more spades and 11+: worth competing"
      shows S>=5, points>=11
      sets  ask=signoff
  cheapest(H) "Five or more hearts and 11+: worth competing"
      shows H>=5, S<=4, points>=11
      sets  ask=signoff
  cheapest(x) "Preference to partner's suit with 11-12"
      shows x>=3, points=11..12
      sets  ask=signoff
      priority -2
  P   "Partner had nothing to say either"  priority -10
# With game values bid it (2026-09-26: 4m with 12-15 opposite a 13-14
# opener that passed: 97 corpus boards with 25+ HCP and game on). Only
# where 3NT is still available.
after 1x (1y) X (1y) P (P) | 1x (1y) X (2y) P (P) | 1x (1y) X (3y) P (P) | 1x (2y) X (3y) P (P) when y is not x
  3N  "Game: 13+ with a stopper in {y}"     shows points>=13, stop(y)
  4{x} "Game in partner's major: 13+ with three"   shows x>=3, points>=13
      when  x is H | x is S
  5{x} "Game in partner's minor: 13+ with three"   shows x>=3, points>=13
      when  x is C | x is D
      priority -1

# Opener after 1m-1S-1NT-3H (5-4 in the majors, game forcing): the fit.
after 1C (P) 1S (P) 1N (P) 3H (P) | 1D (P) 1S (P) 1N (P) 3H (P)
  4H  "Four hearts"                 shows H>=4
  4S  "Three spades"                shows S=3, H<=3
  3N  "Neither fit"                 shows S<=2, H<=3

# Answering a stopper bid with a minor agreed: 3NT with every suit
# covered; else the next stopper up the line below 3NT; else five of the
# minor. A suit partner denied that I cannot stop either is the reason
# for 5m.
when asked stoppers, (trump is C | trump is D)
  3N  "Every suit stopped: 3NT"
      when  (trump is C | stop(C) | partner.cued(C) | me.cued(C) | partner.C.min>=4 | shown.C.min>=4), (trump is D | stop(D) | partner.cued(D) | me.cued(D) | partner.D.min>=4 | shown.D.min>=4), (trump is H | stop(H) | partner.cued(H) | me.cued(H) | partner.H.min>=4 | shown.H.min>=4), (trump is S | stop(S) | partner.cued(S) | me.cued(S) | partner.S.min>=4 | shown.S.min>=4)
      priority 1
  cheapest(C)  "Stopper in C, looking for 3NT"
      when  trump is not C, cheapest_rank(C) < 19, stop(C), !partner.cued(C), !me.cued(C), !(partner.C.min>=4), !(shown.C.min>=4)
      sets  ask=stoppers, ladder=stopper
      prefer 0 - cheapest_rank(C)
  cheapest(D)  "Stopper in D, looking for 3NT"
      when  trump is not D, cheapest_rank(D) < 19, stop(D), !partner.cued(D), !me.cued(D), !(partner.D.min>=4), !(shown.D.min>=4)
      sets  ask=stoppers, ladder=stopper
      prefer 0 - cheapest_rank(D)
  cheapest(H)  "Stopper in H, looking for 3NT"
      when  trump is not H, cheapest_rank(H) < 19, stop(H), !partner.cued(H), !me.cued(H), !(partner.H.min>=4), !(shown.H.min>=4)
      sets  ask=stoppers, ladder=stopper
      prefer 0 - cheapest_rank(H)
  cheapest(S)  "Stopper in S, looking for 3NT"
      when  trump is not S, cheapest_rank(S) < 19, stop(S), !partner.cued(S), !me.cued(S), !(partner.S.min>=4), !(shown.S.min>=4)
      sets  ask=stoppers, ladder=stopper
      prefer 0 - cheapest_rank(S)
  5{trump}  "A suit unstopped: game in the minor"
      priority -3

# ── Opener's invitational raise of a minor (1m-2m-3m, 17-18) ────────
after 1m (P) 2m (P) 3m (P)
  3N  "Accepts: the top of the raise"      shows hcp>=9
  P   "Declines: 6-8"                      shows hcp<=8
      priority -5

# ── Opener reopened with notrump (18-19 balanced, their suit stopped) ─
# Responder passed their overcall, and had no rule over the reopening
# (2026-09-25: 9-10 counts with no stopper passed out 1NT that reaches
# 3NT uncontested). Game from 7.
after 1x (1y) P (P) 1N (P) | 1x (2y) P (P) 2N (P) when y is not x
  3N  "Game opposite 18-19: 7+"            shows hcp>=7
  P   "No game"                            shows hcp<=6
      priority -5

# ── One-level response in a contested auction, opener's minimum rebid ─
# Opener's contested minimum rebids ask for a sign-off, and responder
# passed them whatever he held, where uncontested he invites with 11-12
# and bids game with 13+ (2026-09-25: e.g. 1C (1D) 1H 2C, with 12
# opposite 17). These outrank the sign-off pass. Notrump needs their
# suit stopped; without it a cue bid forces to game.
after 1x (1z) 1y (P) 2x (P) when z is not x, z is not y, y is not x
  3x  "Invitational: 3+ {x}, 11-12"        shows x>=3, points=11..12
      sets  ask=invite(x)
  4x  "Game: 3+ {x}, 13+"                  shows x>=3, points>=13
      when  x is H | x is S
  3y  "Invitational: 6+ {y}, 11-12"        shows y>=6, points=11..12
      sets  ask=invite(y)
  2N  "Invitational: 11-12, {z} stopped"   shows points=11..12, stop(z), x<=2
      sets  ask=nt_invite
  3N  "Game: 13+, {z} stopped"             shows points>=13, stop(z), x<=2 | x is C | x is D
  cheapest(z) "Cue bid: 13+, no stopper in {z}, forcing to game"
      alert  artificial
      shows points>=13
      when  cheapest_rank(z) <= 18      # below 3NT
      sets  forcing=game
      priority -2
after 1x (1z) 1y (P) 2y (P) when z is not x, z is not y, y is not x
  3y  "Invitational: 11-12 with the fit"   shows tp(y)=11..12
      sets  ask=invite(y)
  4y  "Game: 13+ with the fit"             shows tp(y)>=13
      when  y is H | y is S
  3N  "Game: 13+, {z} stopped"             shows points>=13, stop(z)
      when  y is C | y is D
after 1x (1z) 1y (P) 1N (P) when z is not x, z is not y, y is not x
  2N  "Invitational: 11-12"                shows points=11..12, y<=5
      sets  ask=nt_invite
  3N  "Game: 13+"                          shows points>=13, y<=5 | y is C | y is D
  3y  "Invitational: 6+ {y}, 11-12"        shows y>=6, points=11..12
      sets  ask=invite(y)
  4y  "Game: 6+ {y}, 13+"                  shows y>=6, points>=13
      when  y is H | y is S

# ── Responder after a two-level free bid and opener's rebid ──────────
# Where the free bid is forcing (the 21GF cards) opener has to rebid and
# responder may hold anything from 8 up; where it is not, 8-12. Game
# with 13+, an invitation with 11-12, a pass with a minimum
# (2026-09-25: the forcing auctions died in opener's rebid).
# Opener named a major:
after 1x (1y) 2z (P) 2M (P) | 1x (1y) 2z (P) 3M (P) | 1x (2y) 2z (P) 2M (P) | 1x (2y) 2z (P) 3M (P) | 1x (2y) 3z (P) 3M (P) when y is not x, z is not x, z is not y, M is not x, M is not y, M is not z
  4M  "Game: four {M}, 13+"                shows M>=4, points>=13
  cheapest(M) "Raise: four {M}, 11-12"     shows M>=4, points=11..12
      sets  ask=invite(M)
  3N  "Game: 13+, {y} stopped"             shows points>=13, stop(y), M<=3
  cheapest(x) "Preference: 11-12"          shows x>=3, points=11..12, M<=3
      sets  ask=invite(x)
      priority -1
  cheapest(y) "Cue bid: 13+, no stopper, forcing to game"
      alert  artificial
      shows points>=13
      when  cheapest_rank(y) <= 18      # below 3NT
      sets  forcing=game
      priority -2
  P   "Minimum: no game"                   shows points<=10
      priority -5
  cheapest(x) "Preference: two or more {x}"   shows x>=2
      priority -6
# Opener rebid his own suit or raised mine:
after 1x (1y) 2z (P) 2x (P) | 1x (1y) 2z (P) 3x (P) | 1x (2y) 2z (P) 3x (P) | 1x (2y) 3z (P) 3x (P) when y is not x, z is not x, z is not y
  4x  "Game: 3+ {x}, 13+"                  shows x>=3, points>=13
      when  x is H | x is S
  3N  "Game: 13+, {y} stopped"             shows points>=13, stop(y)
  cheapest(x) "Invitational raise: 3+ {x}, 11-12"   shows x>=3, points=11..12
      sets  ask=invite(x)
  cheapest(y) "Cue bid: 13+, no stopper, forcing to game"
      alert  artificial
      shows points>=13
      when  cheapest_rank(y) <= 18      # below 3NT
      sets  forcing=game
      priority -2
after 1x (1y) 2z (P) 3z (P) | 1x (2y) 2z (P) 3z (P) when y is not x, z is not x, z is not y
  4z  "Game in the fit: 13+"               shows points>=13
      when  z is H | z is S
  3N  "Game: 13+, {y} stopped"             shows points>=13, stop(y)
      when  z is C | z is D
  cheapest(y) "Cue bid: 13+, no stopper, forcing to game"
      alert  artificial
      shows points>=13
      when  z is C | z is D, cheapest_rank(y) <= 18
      sets  forcing=game
      priority -2
# Opener raised a three-level minor to four: no room for a cue bid or
# 3NT (2026-09-25: the cue bid landed at 4 of their suit).
after 1x (2y) 3z (P) 4z (P) when y is not x, z is not x, z is not y, z is C | z is D
  5{z}  "Game in the minor: 13+"           shows points>=13
  P     "No game"                          shows points<=12
        priority -5

# ── We redoubled, they ran, opener rebid his suit ────────────────────
# The redouble showed 10+, so the hand is ours: responder does not treat
# opener's rebid as a sign-off (2026-09-26: 10-13 counts passed 2m and
# 2M with game on). Game with 12+, an invitation with 10-11.
after 1x (X) XX (1y) 2x (P) | 1x (X) XX (2y) 2x (P) | 1x (X) XX (1y) 3x (P) | 1x (X) XX (2y) 3x (P) when y is not x
  4{x} "Game: 12+ with a doubleton or better"   shows x>=2, hcp>=12
       when  x is H | x is S
  3N   "Game: 12+ with a stopper in {y}"        shows hcp>=12, stop(y)
       when  x is C | x is D | x<=1
  5{x} "Game in the minor: 13+"                 shows x>=2, hcp>=13
       when  x is C | x is D
       priority -1
  3{x} "Invitational: 10-11 with a doubleton"   shows x>=2, hcp=10..11
       when  partner.last=2{x}
       sets  ask=invite(x)
  P    "Minimum for the redouble: no game"
       priority -5

# ── Catch-all after partner's notrump rebid (Rick, 2026-09-27) ───────
# A notrump rebid is a ladder bid: partner has put a range on a balanced
# hand, so I am captain and bid game with 25 total points between us,
# counting partner at his minimum; opposite 1NT, invite when only his
# maximum reaches it. Below the specific rules (ticket b6: 1C X 1D P
# 2NT P, where 7 passed 18-19).
#
# Not in notrump when partner's shown length and mine make eight cards in
# a major (2026-09-28, NT_Ladder 426: 2C P 2S P 2NT P, where 2NT showed
# two spades and six-card spades bid 3NT): game, or an invitation, in
# the major instead.
when partner.last=1N | partner.last=2N, me.has_bid | style is not bba, partner.balanced, !they.bid | lho.last=P, we.trump is none, !asked
  3N  "Game: 25+ between us, partner at his minimum"
      shows we.points.min >= 25, we.fit(S).min <= 7, we.fit(H).min <= 7
      priority -8
  2N  "Invitation: game if partner is at the top"
      shows we.points.max >= 25, we.fit(S).min <= 7, we.fit(H).min <= 7
      when  partner.last=1N
      priority -8
  4S  "Game in the spade fit: 25+ between us"
      shows we.points.min >= 25, we.fit(S).min >= 8
      priority -8
  4H  "Game in the heart fit: 25+ between us"
      shows we.points.min >= 25, we.fit(H).min >= 8
      priority -8
  3S  "Invitation in the spade fit"
      shows we.points.max >= 25, we.fit(S).min >= 8
      when  partner.last=1N
      sets  ask=invite(S)
      priority -8
  3H  "Invitation in the heart fit"
      shows we.points.max >= 25, we.fit(H).min >= 8
      when  partner.last=1N
      sets  ask=invite(H)
      priority -8
  P   "No game: under 25 between us"
      shows we.points.max <= 26
      priority -9
  # Slam over partner's notrump (2026-09-30: 2C 2D 2NT 3NT with 33 between
  # us, random deals): over-3nt.bid's calibrated HCP numbers, 6NT with 34
  # on partner's floor, a quantitative 4NT with 32-33.
  6N  "Slam: 34 between us (partner at his minimum)"
      shows hcp + partner.hcp.min >= 34, we.fit(S).min <= 7, we.fit(H).min <= 7
      priority -8
  4N  "Quantitative: 32-33 between us"
      shows hcp + partner.hcp.min >= 32, hcp + partner.hcp.max <= 35, we.fit(S).min <= 7, we.fit(H).min <= 7
      sets  ask=quant
      priority -8

# Opener's strong double after 1x (X) 1z (1y): describe, cheapest first
# (ticket b6). Not after a support double (support-doubles.bid).
after 1x (X) 1z (1y) X (P) when z is not x, y is not x, y is not z, !asked support
  cheapest(N) "A stopper in {y}, nothing more to show"   shows stop(y), z<=5
  cheapest(z) "Five or more {z}"           shows z>=5
      priority 1
  cheapest(x) "Three or more of partner's {x}"          shows x>=3
  cheapest(z) "Nothing else to say: {z} again"          priority -5
